+//! Storage and protocol-identity regressions using the real outbox writer.
+//! These tests exercise acknowledgement loss; they do not claim power-loss
+//! qualification or a funded native SQL/proxy crash test.
+use super::*;
+use bitcoin::{
+    Amount, OutPoint, ScriptBuf, Sequence, Transaction, TxIn, TxOut, Witness, absolute, transaction,
+};
+
+fn preparing() -> Record {
+    Record {
+        version: 1,
+        wallet_binding: "wallet-a".into(),
+        request: serde_json::from_value(serde_json::json!({
+            "version": 1, "operationId": "aa".repeat(16),
+            "fingerprint": "bb".repeat(32), "kind": "bitcoin",
+            "amount": 1000, "feeRate": 1, "address": "bcrt1ptest"
+        }))
+        .unwrap(),
+        phase: Phase::Preparing,
+        txid: None,
+        batch_transfer_index: None,
+        signed_psbt: None,
+        unsigned_psbt: None,
+        failure_code: None,
+        cancel_requested: false,
+    }
+}
+
+fn unsigned() -> Psbt {
+    let tx = Transaction {
+        version: transaction::Version::TWO,
+        lock_time: absolute::LockTime::ZERO,
+        input: vec![TxIn {
+            previous_output: OutPoint::null(),
+            script_sig: ScriptBuf::new(),
+            sequence: Sequence::MAX,
+            witness: Witness::new(),
+        }],
+        output: vec![TxOut {
+            value: Amount::from_sat(1000),
+            script_pubkey: ScriptBuf::new(),
+        }],
+    };
+    let mut psbt = Psbt::from_unsigned_tx(tx).unwrap();
+    psbt.inputs[0].witness_utxo = Some(TxOut {
+        value: Amount::from_sat(2000),
+        script_pubkey: ScriptBuf::new(),
+    });
+    psbt
+}
+
+fn prepared() -> Record {
+    let mut value = preparing();
+    let mut psbt = unsigned();
+    value.unsigned_psbt = Some(psbt.to_string());
+    psbt.inputs[0].final_script_witness = Some(Witness::from_slice(&[vec![1u8]]));
+    value.txid = Some(
+        psbt.clone()
+            .extract_tx()
+            .unwrap()
+            .compute_txid()
+            .to_string(),
+    );
+    value.signed_psbt = Some(psbt.to_string());
+    value.phase = Phase::Prepared;
+    value
+}
+
+struct ResetFault;
+impl Drop for ResetFault {
+    fn drop(&mut self) {
+        WRITE_FAULT.with(|fault| fault.set(None));
+    }
+}
+fn fault(point: WriteFault) -> ResetFault {
+    WRITE_FAULT.with(|fault| fault.set(Some(point)));
+    ResetFault
+}
+fn status(value: &Record) -> serde_json::Value {
+    serde_json::from_str(&response(&value.request.operation_id, Some(value), false).unwrap())
+        .unwrap()
+}
