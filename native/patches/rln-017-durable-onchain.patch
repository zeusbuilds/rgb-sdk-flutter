+    write(&dir, &value).unwrap();
+    let target = path(&dir, &value.request.operation_id);
+    let mut corrupt = serde_json::to_value(&value).unwrap();
+    corrupt["signedPsbt"] = serde_json::Value::String("not-a-psbt".into());
+    fs::write(&target, serde_json::to_vec(&corrupt).unwrap()).unwrap();
+    assert!(read(&dir, &value.request.operation_id, "wallet-a").is_err());
+}
