+#[test]
+fn failed_acceptance_ack_never_reports_a_nondurable_receipt() {
+    for point in [WriteFault::BeforeCreate, WriteFault::AfterDirectorySync] {
+        let root = tempfile::tempdir().unwrap();
+        let dir = root.path().join("outbox");
+        let _lock = lock_directory(&dir).unwrap();
+        let mut value = prepared();
+        value.phase = Phase::Committing;
+        write(&dir, &value).unwrap();
+        {
+            let _reset = fault(point);
+            assert!(remember_acceptance(&dir, &mut value).is_err());
+        }
+        let mut recovered = read(&dir, &value.request.operation_id, "wallet-a")
+            .unwrap()
+            .unwrap();
+        assert_eq!(
+            recovered.phase,
+            if matches!(point, WriteFault::BeforeCreate) {
+                Phase::Committing
+            } else {
+                Phase::Accepted
+            }
+        );
+        remember_acceptance(&dir, &mut recovered).unwrap();
+        assert_eq!(
+            read(&dir, &value.request.operation_id, "wallet-a")
+                .unwrap()
+                .unwrap()
+                .phase,
+            Phase::Accepted
+        );
+        // An already durable receipt no longer depends on a writable journal or available history.
+        let _reset = fault(WriteFault::BeforeCreate);
+        assert!(remember_acceptance(&dir, &mut recovered).is_ok());
+    }
+}
