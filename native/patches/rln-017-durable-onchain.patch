+#[cfg(feature = "uniffi")]
+#[test]
+fn configured_vss_rejects_all_durable_apis_before_journal_access_or_certificate() {
+    use crate::{RlnError, SdkInitRequest, SdkNode};
+    let root = tempfile::tempdir().unwrap();
+    let free_port = || {
+        std::net::TcpListener::bind("127.0.0.1:0")
+            .unwrap()
+            .local_addr()
+            .unwrap()
+            .port()
+    };
+    let node = SdkNode::create(SdkInitRequest {
+        storage_dir_path: root.path().display().to_string(),
+        daemon_listening_port: free_port(),
+        ldk_peer_listening_port: free_port(),
+        network: "regtest".into(),
+        max_media_upload_size_mb: 20,
+        enable_virtual_channels_v0: Some(false),
+        virtual_peer_pubkeys: None,
+        lsp_base_url: None,
+        lsp_bearer_token: None,
+        vss_url: Some("http://127.0.0.1:9".into()),
+        vss_allow_http: false,
+        vss_allow_empty_restore: false,
+        reuse_addresses: false,
+    })
+    .unwrap();
+    let command = serde_json::to_string(&preparing().request).unwrap();
+    let outbox = root.path().join("durable-onchain-v1");
+    let calls: [fn(&SdkNode, String) -> Result<String, RlnError>; 4] = [
+        SdkNode::prepare_onchain_send,
+        SdkNode::commit_onchain_send,
+        SdkNode::onchain_send_status,
+        SdkNode::cancel_onchain_send,
+    ];
+    for call in calls {
+        assert!(
+            matches!(call(&node, command.clone()), Err(RlnError::Internal(message)) if message.contains("do not support VSS restore"))
+        );
+        assert!(
+            !outbox.exists(),
+            "No absent/cancel certificate or journal may be created"
+        );
+    }
+    // Even inconsistent existing journal paths must not be inspected or repaired by this mode.
+    fs::write(&outbox, b"existing unsupported local state").unwrap();
+    for call in calls {
+        assert!(
+            matches!(call(&node, command.clone()), Err(RlnError::Internal(message)) if message.contains("do not support VSS restore"))
+        );
+        assert_eq!(
+            fs::read(&outbox).unwrap(),
+            b"existing unsupported local state"
+        );
+    }
+    node.shutdown();
+}
