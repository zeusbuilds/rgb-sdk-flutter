+/// Explicitly abandon an operation that this protocol has never authorized for End. The revocation
+/// marker is durable before releasing resources, so a crash cannot make a later commit revive it.
+/// Repeating cancellation only checks/releases this transaction's own native resources.
+pub(crate) async fn cancel(state: Arc<AppState>, json: String) -> Result<String, APIError> {
+    require_local_journal(&state)?;
+    if json.len() > 200_000 {
+        return Err(invalid("durable payment request too large"));
+    }
+    let request: Request =
+        serde_json::from_str(&json).map_err(|_| invalid("invalid durable payment JSON"))?;
+    request.validate()?;
+    let id = request.operation_id.clone();
+    let guard = sdk::check_unlocked_owned(&state).await?;
+    blocking_native(move || {
+        let common = guard.as_ref().unwrap();
+        let dir = directory(&state);
+        let _lock = lock_directory(&dir)?;
+        let wallet_binding = binding(common);
+        let Some(mut record) = read(&dir, &id, &wallet_binding)? else {
+            // An absence observation alone cannot retire an app intent: create a permanent revocation
+            // certificate so a delayed prepare for this same ID can never dispatch later.
+            let rejected = Record {
+                version: 1,
+                wallet_binding,
+                request,
+                phase: Phase::Rejected,
+                txid: None,
+                batch_transfer_index: None,
+                signed_psbt: None,
+                unsigned_psbt: None,
+                failure_code: Some("cancelled".into()),
+                cancel_requested: true,
+            };
+            write(&dir, &rejected)?;
+            return response(&id, Some(&rejected), false);
+        };
+        if record.request != request {
+            return Err(invalid("durable payment ID is bound to another request"));
+        }
+        if matches!(
+            record.phase,
+            Phase::Committing | Phase::Accepted | Phase::Rejected
+        ) {
+            let accepted = observed_and_recorded(common, &dir, &mut record)?;
+            return response(&id, Some(&record), accepted);
+        }
+        record.cancel_requested = true;
+        record.phase = Phase::Preparing;
+        record.signed_psbt = None;
+        record.failure_code = Some("native_cancel_pending".into());
+        write(&dir, &record)?;
+        let released = (|| -> Result<bool, APIError> {
+            let Some(txid) = &record.txid else {
+                return Ok(true);
+            };
+            match record.request.kind {
+                Kind::Bitcoin => {
+                    let wallet = common.rgb_wallet_wrapper.get_rgb_wallet();
+                    if wallet
+                        .list_pending_vanilla_txs()?
+                        .iter()
+                        .any(|t| &t.txid == txid)
+                    {
+                        wallet.abort_pending_vanilla_tx(txid.clone())?;
+                    }
+                    Ok(!wallet
+                        .list_pending_vanilla_txs()?
+                        .iter()
+                        .any(|t| &t.txid == txid))
+                }
+                Kind::Rgb => {
+                    let filter = || AssetFilter::Id(record.request.asset_id.clone().unwrap());
+                    let transfers = common.rgb_list_transfers(filter(), Some(txid.clone()))?;
+                    if transfers.iter().any(|t| {
+                        !matches!(t.status, TransferStatus::Initiated | TransferStatus::Failed)
+                    }) {
+                        // Native state contradicts this never-End-authorized operation. Do not free it.
+                        return Ok(false);
+                    }
+                    let batches = transfers
+                        .iter()
+                        .filter(|t| {
+                            t.status == TransferStatus::Initiated
+                                && matches!(t.kind, rgb_lib::wallet::TransferKind::Send)
+                        })
+                        .map(|t| t.batch_transfer_idx)
+                        .collect::<std::collections::HashSet<_>>();
+                    for batch in batches {
+                        let wrapper = &common.rgb_wallet_wrapper;
+                        wrapper.get_rgb_wallet().fail_transfers(
+                            wrapper.online,
+                            Some(batch),
+                            false,
+                            true,
+                        )?;
+                    }
+                    Ok(common
+                        .rgb_list_transfers(filter(), Some(txid.clone()))?
+                        .iter()
+                        .all(|t| t.status == TransferStatus::Failed))
+                }
+            }
+        })();
+        if matches!(released, Ok(true)) {
+            record.phase = Phase::Rejected;
+            record.txid = None;
+            record.batch_transfer_index = None;
+            record.unsigned_psbt = None;
+            record.failure_code = Some("cancelled".into());
+            write(&dir, &record)?;
+        }
+        response(&id, Some(&record), false)
+    })
+    .await
+}
