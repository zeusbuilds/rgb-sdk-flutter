diff --git a/src/durable_payment.rs b/src/durable_payment.rs
new file mode 100644
index 0000000..05642db
--- /dev/null
+++ b/src/durable_payment.rs
@@ -0,0 +1,1260 @@
+//! Crash-safe on-chain outbox. Preparation never calls End; commit never rebuilds a transaction.
+//! The journal is private wallet data (including a spend-authorizing signed PSBT), not telemetry.
+use crate::{error::APIError, sdk, utils::AppState};
+use bitcoin::{
+    hashes::{Hash, sha256},
+    psbt::Psbt,
+};
+use rgb_lib::{
+    Assignment, TransferStatus,
+    wallet::{AssetFilter, Recipient, RgbWalletOpsOnline, WitnessData},
+};
+use serde::{Deserialize, Serialize};
+#[cfg(unix)]
+use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+use std::{
+    collections::HashMap,
+    fs::{self, File, OpenOptions},
+    io::{Read, Write},
+    path::{Path, PathBuf},
+    str::FromStr,
+    sync::Arc,
+};
+
+const MAX_RECORD: u64 = 4 * 1024 * 1024;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Request {
+    version: u32,
+    operation_id: String,
+    fingerprint: String,
+    kind: Kind,
+    amount: u64,
+    fee_rate: u64,
+    #[serde(default)]
+    address: Option<String>,
+    #[serde(default)]
+    asset_id: Option<String>,
+    #[serde(default)]
+    recipient_id: Option<String>,
+    #[serde(default)]
+    transport_endpoints: Vec<String>,
+    #[serde(default)]
+    witness_amount_sat: Option<u64>,
+    #[serde(default)]
+    witness_blinding: Option<u64>,
+    #[serde(default = "one_confirmation")]
+    min_confirmations: u8,
+    #[serde(default)]
+    donation: bool,
+    #[serde(default)]
+    expiration_timestamp: Option<u64>,
+}
+fn one_confirmation() -> u8 {
+    1
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "lowercase")]
+enum Kind {
+    Bitcoin,
+    Rgb,
+}
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "lowercase")]
+enum Phase {
+    Preparing,
+    Prepared,
+    Committing,
+    Accepted,
+    Rejected,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Record {
+    version: u32,
+    wallet_binding: String,
+    request: Request,
+    phase: Phase,
+    txid: Option<String>,
+    batch_transfer_index: Option<i32>,
+    signed_psbt: Option<String>,
+    unsigned_psbt: Option<String>,
+    failure_code: Option<String>,
+    cancel_requested: bool,
+}
+
+fn invalid(message: &str) -> APIError {
+    APIError::InvalidRequest(message.to_string())
+}
+fn storage_error(_: impl std::fmt::Display) -> APIError {
+    // Do not put the PSBT, destination, wallet path or underlying file contents in error strings.
+    APIError::IO(std::io::Error::other(
+        "durable payment storage is unavailable or inconsistent",
+    ))
+}
+fn hex(value: &str, size: usize) -> bool {
+    value.len() == size
+        && value
+            .bytes()
+            .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+fn validate_id(value: &str) -> Result<(), APIError> {
+    if !hex(value, 32) {
+        return Err(invalid("invalid durable payment operation ID"));
+    }
+    Ok(())
+}
+impl Request {
+    fn validate(&self) -> Result<(), APIError> {
+        validate_id(&self.operation_id)?;
+        if self.version != 1
+            || !hex(&self.fingerprint, 64)
+            || self.amount == 0
+            || self.amount > i64::MAX as u64
+            || self.fee_rate == 0
+            || self.fee_rate > i64::MAX as u64
+        {
+            return Err(invalid("invalid durable payment request"));
+        }
+        // Donation exposes the signed transaction to the recipient before native SQL commits.
+        // Qualify that separate recovery path before enabling it in this protocol.
+        if self.donation {
+            return Err(invalid("durable donation sends are not supported"));
+        }
+        match self.kind {
+            Kind::Bitcoin => {
+                if self
+                    .address
+                    .as_ref()
+                    .is_none_or(|v| v.is_empty() || v.len() > 1000)
+                    || self.asset_id.is_some()
+                    || self.recipient_id.is_some()
+                    || !self.transport_endpoints.is_empty()
+                    || self.witness_amount_sat.is_some()
+                    || self.witness_blinding.is_some()
+                    || self.expiration_timestamp.is_some()
+                {
+                    return Err(invalid("invalid durable Bitcoin send request"));
+                }
+            }
+            Kind::Rgb => {
+                if self.address.is_some()
+                    || self
+                        .expiration_timestamp
+                        .is_none_or(|value| value == 0 || value > i64::MAX as u64)
+                    || self
+                        .asset_id
+                        .as_ref()
+                        .is_none_or(|v| v.is_empty() || v.len() > 1000)
+                    || self
+                        .recipient_id
+                        .as_ref()
+                        .is_none_or(|v| v.is_empty() || v.len() > 4000)
+                    || self.transport_endpoints.is_empty()
+                    || self.transport_endpoints.len() > 16
+                    || self
+                        .transport_endpoints
+                        .iter()
+                        .any(|v| v.is_empty() || v.len() > 8000)
+                    || self.witness_blinding.is_some() && self.witness_amount_sat.is_none()
+                    || self
+                        .witness_amount_sat
+                        .is_some_and(|v| v == 0 || v > i64::MAX as u64)
+                {
+                    return Err(invalid("invalid durable RGB send request"));
+                }
+                rgb_lib::ContractId::from_str(self.asset_id.as_deref().unwrap())
+                    .map_err(|_| invalid("invalid durable RGB asset"))?;
+            }
+        }
+        Ok(())
+    }
+}
+
+fn binding(common: &crate::utils::CommonState) -> String {
+    let keys = common.rgb_get_keys();
+    sha256::Hash::hash(
+        format!(
+            "{:?}:{}:{}",
+            common.rgb_wallet_wrapper.bitcoin_network(),
+            keys.account_xpub_vanilla,
+            keys.account_xpub_colored
+        )
+        .as_bytes(),
+    )
+    .to_string()
+}
+fn directory(state: &AppState) -> PathBuf {
+    state
+        .static_state
+        .storage_dir_path
+        .join("durable-onchain-v1")
+}
+fn path(dir: &Path, id: &str) -> PathBuf {
+    dir.join(format!("{id}.json"))
+}
+
+fn read(dir: &Path, id: &str, wallet_binding: &str) -> Result<Option<Record>, APIError> {
+    validate_id(id)?;
+    let directory_metadata = match fs::symlink_metadata(dir) {
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        result => result.map_err(storage_error)?,
+    };
+    if !directory_metadata.file_type().is_dir() {
+        return Err(storage_error("directory metadata"));
+    }
+    #[cfg(unix)]
+    if directory_metadata.permissions().mode() & 0o077 != 0 {
+        return Err(storage_error("directory permissions"));
+    }
+    let target = path(dir, id);
+    let metadata = match fs::symlink_metadata(&target) {
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        result => result.map_err(storage_error)?,
+    };
+    if !metadata.file_type().is_file() || metadata.len() > MAX_RECORD {
+        return Err(storage_error("record metadata"));
+    }
+    #[cfg(unix)]
+    if metadata.permissions().mode() & 0o077 != 0 {
+        return Err(storage_error("record permissions"));
+    }
+    let mut data = Vec::new();
+    File::open(target)
+        .map_err(storage_error)?
+        .take(MAX_RECORD + 1)
+        .read_to_end(&mut data)
+        .map_err(storage_error)?;
+    if data.len() as u64 > MAX_RECORD {
+        return Err(storage_error("record size"));
+    }
+    let record: Record = serde_json::from_slice(&data).map_err(storage_error)?;
+    record.request.validate()?;
+    if record.version != 1
+        || record.wallet_binding != wallet_binding
+        || record.request.operation_id != id
+        || (record.cancel_requested && matches!(record.phase, Phase::Committing | Phase::Accepted))
+    {
+        return Err(storage_error("record identity"));
+    }
+    match record.phase {
+        Phase::Preparing | Phase::Rejected => {
+            if record.signed_psbt.is_some() {
+                return Err(storage_error("preparing data"));
+            }
+            if let Some(unsigned) = &record.unsigned_psbt {
+                let psbt = Psbt::from_str(unsigned).map_err(storage_error)?;
+                if record.phase == Phase::Rejected
+                    || record.txid.as_deref()
+                        != Some(psbt.unsigned_tx.compute_txid().to_string().as_str())
+                    || (record.request.kind == Kind::Bitcoin)
+                        != record.batch_transfer_index.is_none()
+                {
+                    return Err(storage_error("unsigned transaction identity"));
+                }
+            } else if record.txid.is_some() || record.batch_transfer_index.is_some() {
+                return Err(storage_error("preparing identity"));
+            }
+        }
+        _ => {
+            let unsigned = Psbt::from_str(
+                record
+                    .unsigned_psbt
+                    .as_deref()
+                    .ok_or_else(|| storage_error("missing unsigned transaction"))?,
+            )
+            .map_err(storage_error)?;
+            let signed = Psbt::from_str(
+                record
+                    .signed_psbt
+                    .as_deref()
+                    .ok_or_else(|| storage_error("missing transaction"))?,
+            )
+            .map_err(storage_error)?;
+            if signed.unsigned_tx != unsigned.unsigned_tx {
+                return Err(storage_error("transaction content mismatch"));
+            }
+            let tx = signed.extract_tx().map_err(storage_error)?;
+            if record.txid.as_deref() != Some(tx.compute_txid().to_string().as_str())
+                || (record.request.kind == Kind::Bitcoin) != record.batch_transfer_index.is_none()
+                || record.batch_transfer_index.is_some_and(|v| v < 0)
+            {
+                return Err(storage_error("transaction identity"));
+            }
+        }
+    }
+    Ok(Some(record))
+}
+
+fn restricted_options() -> OpenOptions {
+    let mut options = OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    options.mode(0o600);
+    options
+}
+
+// A one-shot, thread-local seam lets unit tests exercise the actual atomic
+// writer at durability boundaries without altering production behavior.
+#[cfg(test)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum WriteFault {
+    BeforeCreate,
+    AfterTempFlush,
+    AfterRename,
+    AfterDirectorySync,
+}
+#[cfg(test)]
+thread_local! {
+    static WRITE_FAULT: std::cell::Cell<Option<WriteFault>> = const { std::cell::Cell::new(None) };
+}
+#[cfg(test)]
+fn write_fault(point: WriteFault) -> Result<(), APIError> {
+    WRITE_FAULT.with(|fault| {
+        if fault.get() == Some(point) {
+            fault.set(None);
+            Err(storage_error("injected durable write fault"))
+        } else {
+            Ok(())
+        }
+    })
+}
+
+fn write(dir: &Path, record: &Record) -> Result<(), APIError> {
+    let bytes = serde_json::to_vec(record).map_err(storage_error)?;
+    if bytes.len() as u64 > MAX_RECORD {
+        return Err(storage_error("record size"));
+    }
+    let temp = dir.join(format!(
+        ".{}.{}.tmp",
+        record.request.operation_id,
+        rand::random::<u64>()
+    ));
+    let result = (|| {
+        #[cfg(test)]
+        write_fault(WriteFault::BeforeCreate)?;
+        let mut file = restricted_options().open(&temp).map_err(storage_error)?;
+        file.write_all(&bytes).map_err(storage_error)?;
+        file.sync_all().map_err(storage_error)?;
+        #[cfg(test)]
+        write_fault(WriteFault::AfterTempFlush)?;
+        fs::rename(&temp, path(dir, &record.request.operation_id)).map_err(storage_error)?;
+        #[cfg(test)]
+        write_fault(WriteFault::AfterRename)?;
+        File::open(dir)
+            .map_err(storage_error)?
+            .sync_all()
+            .map_err(storage_error)?;
+        #[cfg(test)]
+        write_fault(WriteFault::AfterDirectorySync)?;
+        Ok(())
+    })();
+    if result.is_err() {
+        let _ = fs::remove_file(temp);
+    }
+    result
+}
+
+fn lock_directory(dir: &Path) -> Result<File, APIError> {
+    match fs::create_dir(dir) {
+        Ok(()) => {
+            #[cfg(unix)]
+            fs::set_permissions(dir, fs::Permissions::from_mode(0o700)).map_err(storage_error)?;
+            File::open(dir.parent().ok_or_else(|| storage_error("parent"))?)
+                .map_err(storage_error)?
+                .sync_all()
+                .map_err(storage_error)?;
+        }
+        Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {}
+        Err(e) => return Err(storage_error(e)),
+    }
+    let meta = fs::symlink_metadata(dir).map_err(storage_error)?;
+    if !meta.file_type().is_dir() {
+        return Err(storage_error("directory"));
+    }
+    #[cfg(unix)]
+    if meta.permissions().mode() & 0o077 != 0 {
+        return Err(storage_error("directory permissions"));
+    }
+    let lock_path = dir.join(".lock");
+    let lock = match restricted_options().open(&lock_path) {
+        Ok(f) => f,
+        Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {
+            let metadata = fs::symlink_metadata(&lock_path).map_err(storage_error)?;
+            if !metadata.file_type().is_file() {
+                return Err(storage_error("lock metadata"));
+            }
+            OpenOptions::new()
+                .write(true)
+                .open(lock_path)
+                .map_err(storage_error)?
+        }
+        Err(e) => return Err(storage_error(e)),
+    };
+    lock.try_lock()
+        .map_err(|_| invalid("another durable payment operation is running"))?;
+    Ok(lock)
+}
+
+fn response(id: &str, record: Option<&Record>, observed: bool) -> Result<String, APIError> {
+    let phase = if observed {
+        "accepted"
+    } else {
+        match record.map(|r| r.phase) {
+            None => "absent",
+            Some(Phase::Preparing) => "preparing",
+            Some(Phase::Prepared) => "prepared",
+            Some(Phase::Committing) => "committing",
+            Some(Phase::Accepted) => "accepted",
+            Some(Phase::Rejected) => "rejected",
+        }
+    };
+    serde_json::to_string(&serde_json::json!({
+        "version": 1, "operationId": id,
+        "fingerprint": record.map(|r| &r.request.fingerprint),
+        "kind": record.map(|r| r.request.kind), "phase": phase,
+        "txid": record.and_then(|r| r.txid.as_ref()),
+        "batchTransferIndex": record.and_then(|r| r.batch_transfer_index),
+        "failureCode": if observed { None } else { record.and_then(|r| r.failure_code.as_ref()) },
+        "endAuthorized": record.is_some_and(|r| matches!(r.phase, Phase::Committing | Phase::Accepted)),
+    })).map_err(storage_error)
+}
+
+fn observed(common: &crate::utils::CommonState, record: &mut Record) -> Result<bool, APIError> {
+    // A reservation/Initiated record is not acceptance. Neither absence nor a failed check is rejection.
+    if record.phase == Phase::Accepted {
+        return Ok(true);
+    }
+    if record.phase != Phase::Committing {
+        return Ok(false);
+    }
+    let txid = record
+        .txid
+        .as_deref()
+        .ok_or_else(|| storage_error("missing identity"))?;
+    Ok(match record.request.kind {
+        Kind::Bitcoin => common.rgb_list_transactions(false)?.into_iter().any(|t| {
+            t.txid == txid
+                && matches!(
+                    t.transaction_type,
+                    rgb_lib::wallet::TransactionType::SendBtc
+                )
+        }),
+        Kind::Rgb => {
+            let batches = common
+                .rgb_list_transfers(
+                    AssetFilter::Id(record.request.asset_id.clone().unwrap()),
+                    Some(txid.to_string()),
+                )?
+                .into_iter()
+                .filter(|t| {
+                    t.txid.as_deref() == Some(txid)
+                        && matches!(t.kind, rgb_lib::wallet::TransferKind::Send)
+                        && !matches!(t.status, TransferStatus::Initiated | TransferStatus::Failed)
+                })
+                .map(|t| t.batch_transfer_idx)
+                .collect::<std::collections::HashSet<_>>();
+            if batches.len() == 1 {
+                record.batch_transfer_index = batches.into_iter().next();
+                true
+            } else {
+                false
+            }
+        }
+    })
+}
+
+// Reporting native acceptance retires the caller's active fence. Make that evidence durable
+// first so a later reorg, unavailable history or failed batch cannot resurrect an invisible fence.
+fn remember_acceptance(dir: &Path, record: &mut Record) -> Result<(), APIError> {
+    if !matches!(record.phase, Phase::Committing | Phase::Accepted) {
+        return Err(storage_error(
+            "acceptance without prior commit authorization",
+        ));
+    }
+    if record.phase != Phase::Accepted {
+        record.phase = Phase::Accepted;
+        record.failure_code = None;
+        write(dir, record)?;
+    }
+    Ok(())
+}
+
+fn observed_and_recorded(
+    common: &crate::utils::CommonState,
+    dir: &Path,
+    record: &mut Record,
+) -> Result<bool, APIError> {
+    let accepted = observed(common, record)?;
+    if accepted {
+        remember_acceptance(dir, record)?;
+    }
+    Ok(accepted)
+}
+
+// RGB VSS restores a fingerprint child, not this node-level operation journal. It cannot prove
+// absence or continuity for a saved app intent. Keep this unsupported combination fail-closed at
+// the native API boundary, including status/cancel, before any journal state is touched.
+fn require_local_journal(state: &AppState) -> Result<(), APIError> {
+    if state.static_state.vss_url.is_some() {
+        return Err(APIError::Unexpected(
+            "recoverable on-chain operations do not support VSS restore; an intact local journal is required".into(),
+        ));
+    }
+    Ok(())
+}
+
+// RGB's blocking HTTP clients cannot be created/dropped inside an async runtime.
+// A worker owns its wallet lifecycle guard until completion. Losing/cancelling the
+// waiter neither cancels native work nor permits shutdown to overtake it.
+async fn blocking_native<T: Send + 'static>(
+    operation: impl FnOnce() -> Result<T, APIError> + Send + 'static,
+) -> Result<T, APIError> {
+    tokio::task::spawn_blocking(operation)
+        .await
+        .map_err(|_| storage_error("native wallet worker did not complete"))?
+}
+
+pub(crate) async fn status(state: Arc<AppState>, json: String) -> Result<String, APIError> {
+    require_local_journal(&state)?;
+    if json.len() > 200_000 {
+        return Err(invalid("durable payment request too large"));
+    }
+    let request: Request =
+        serde_json::from_str(&json).map_err(|_| invalid("invalid durable payment JSON"))?;
+    request.validate()?;
+    let id = request.operation_id.clone();
+    let guard = sdk::check_unlocked_owned(&state).await?;
+    blocking_native(move || {
+        let common = guard.as_ref().unwrap();
+        let dir = directory(&state);
+        let _lock = lock_directory(&dir)?;
+        let mut record = read(&dir, &id, &binding(common))?;
+        if record
+            .as_ref()
+            .is_some_and(|value| value.request != request)
+        {
+            return Err(invalid("durable payment ID is bound to another request"));
+        }
+        let accepted = record
+            .as_mut()
+            .map(|r| observed_and_recorded(common, &dir, r))
+            .transpose()?
+            .unwrap_or(false);
+        response(&id, record.as_ref(), accepted)
+    })
+    .await
+}
+
+pub(crate) async fn prepare(state: Arc<AppState>, json: String) -> Result<String, APIError> {
+    require_local_journal(&state)?;
+    if json.len() > 200_000 {
+        return Err(invalid("durable payment request too large"));
+    }
+    let request: Request =
+        serde_json::from_str(&json).map_err(|_| invalid("invalid durable payment JSON"))?;
+    request.validate()?;
+    let guard = sdk::check_unlocked_owned(&state).await?;
+    blocking_native(move || {
+        let common = guard.as_ref().unwrap();
+        let dir = directory(&state);
+        let _lock = lock_directory(&dir)?;
+        let wallet_binding = binding(common);
+        if let Some(mut record) = read(&dir, &request.operation_id, &wallet_binding)? {
+            if record.request != request {
+                return Err(invalid("durable payment ID is bound to another request"));
+            }
+            if record.phase == Phase::Preparing && !record.cancel_requested {
+                return prepare_record(common, &dir, &mut record);
+            }
+            let accepted = observed_and_recorded(common, &dir, &mut record)?;
+            return response(&request.operation_id, Some(&record), accepted);
+        }
+        for entry in fs::read_dir(&dir).map_err(storage_error)? {
+            let entry = entry.map_err(storage_error)?;
+            if entry.path().extension().is_some_and(|v| v == "json") {
+                let name = entry.file_name().to_string_lossy().to_string();
+                let mut other = read(&dir, &name[..name.len() - 5], &wallet_binding)?
+                    .ok_or_else(|| storage_error("missing record"))?;
+                if !matches!(other.phase, Phase::Accepted | Phase::Rejected)
+                    && !observed_and_recorded(common, &dir, &mut other)?
+                {
+                    return Err(invalid("a durable payment requires recovery first"));
+                }
+            }
+        }
+        let mut record = Record {
+            version: 1,
+            wallet_binding,
+            request: request.clone(),
+            phase: Phase::Preparing,
+            txid: None,
+            batch_transfer_index: None,
+            signed_psbt: None,
+            unsigned_psbt: None,
+            failure_code: None,
+            cancel_requested: false,
+        };
+        // From this point a lost response can only retain preparation resources. No End call is possible.
+        write(&dir, &record)?;
+        prepare_record(common, &dir, &mut record)
+    })
+    .await
+}
+
+fn prepare_record(
+    common: &crate::utils::CommonState,
+    dir: &Path,
+    record: &mut Record,
+) -> Result<String, APIError> {
+    let request = record.request.clone();
+    if record.unsigned_psbt.is_none() {
+        // The new native Begin variants may not commit any reservations until the exact unsigned
+        // transaction is durable here. If the callback was never reached, repeating preparation is
+        // safe: the prior SQL transaction cannot have committed, and any orphan files are unsigned.
+        let begin = match request.kind {
+            Kind::Bitcoin => {
+                let wrapper = &common.rgb_wallet_wrapper;
+                wrapper
+                    .get_rgb_wallet()
+                    .send_btc_begin_with_durable_callback(
+                        wrapper.online,
+                        request.address.clone().unwrap(),
+                        request.amount,
+                        request.fee_rate,
+                        false,
+                        false,
+                        None,
+                        |unsigned| persist_unsigned(dir, record, unsigned, None),
+                    )
+                    .map(|_| ())
+            }
+            Kind::Rgb => {
+                let recipient = Recipient {
+                    recipient_id: request.recipient_id.clone().unwrap(),
+                    assignment: Assignment::Fungible(request.amount),
+                    transport_endpoints: request.transport_endpoints.clone(),
+                    witness_data: request.witness_amount_sat.map(|amount_sat| WitnessData {
+                        amount_sat,
+                        blinding: request.witness_blinding,
+                    }),
+                };
+                let mut recipients = HashMap::new();
+                recipients.insert(request.asset_id.clone().unwrap(), vec![recipient]);
+                let wrapper = &common.rgb_wallet_wrapper;
+                wrapper
+                    .get_rgb_wallet()
+                    .send_begin_with_durable_callback(
+                        wrapper.online,
+                        recipients,
+                        false,
+                        request.fee_rate,
+                        request.min_confirmations,
+                        request.expiration_timestamp.unwrap_or_else(|| {
+                            crate::utils::get_current_timestamp()
+                                + crate::routes::DEFAULT_RGB_TRANSFER_EXPIRATION_SECS
+                        }),
+                        false,
+                        None,
+                        |result| {
+                            let fascia = Path::new(&result.details.fascia_path);
+                            let transfer_dir =
+                                fascia.parent().ok_or_else(|| rgb_lib::Error::Internal {
+                                    details: "durable transfer metadata path is invalid".into(),
+                                })?;
+                            sync_transfer_metadata(transfer_dir, 0).map_err(|_| {
+                                rgb_lib::Error::Internal {
+                                    details: "durable transfer metadata could not be saved".into(),
+                                }
+                            })?;
+                            if let Some(parent) = transfer_dir.parent() {
+                                File::open(parent)
+                                    .and_then(|file| file.sync_all())
+                                    .map_err(|_| rgb_lib::Error::Internal {
+                                        details: "durable transfer directory could not be saved"
+                                            .into(),
+                                    })?;
+                            }
+                            persist_unsigned(dir, record, &result.psbt, result.batch_transfer_idx)
+                        },
+                    )
+                    .map(|_| ())
+            }
+        };
+        if let Err(error) = begin {
+            // No callback => SQL has not reached commit and no End was authorized. A callback with
+            // a durable identity survives an interrupted SQL commit and can be resumed explicitly.
+            record.phase = if record.unsigned_psbt.is_none() {
+                Phase::Rejected
+            } else {
+                Phase::Preparing
+            };
+            // Only a finite, payload-free reason crosses the journal/API boundary. Certainty is
+            // determined by phase + End authorization, never by interpreting an error message.
+            record.failure_code = Some(
+                if record.phase == Phase::Rejected {
+                    prepare_failure_code(&error)
+                } else {
+                    "native_prepare_interrupted"
+                }
+                .into(),
+            );
+            write(dir, record)?;
+            return response(&request.operation_id, Some(record), false);
+        }
+    }
+    let unsigned = record
+        .unsigned_psbt
+        .as_ref()
+        .ok_or_else(|| storage_error("missing prepared transaction"))?;
+    let signed = match common.rgb_sign_psbt(unsigned.clone()) {
+        Ok(signed) => signed,
+        Err(_) => {
+            record.failure_code = Some("native_sign_failed".into());
+            write(dir, record)?;
+            return response(&request.operation_id, Some(record), false);
+        }
+    };
+    let prepared_psbt = Psbt::from_str(unsigned).map_err(storage_error)?;
+    let signed_psbt = Psbt::from_str(&signed).map_err(storage_error)?;
+    if signed_psbt.unsigned_tx != prepared_psbt.unsigned_tx {
+        return Err(storage_error("signer changed transaction"));
+    }
+    let txid = signed_psbt
+        .extract_tx()
+        .map_err(storage_error)?
+        .compute_txid()
+        .to_string();
+    if record.txid.as_ref() != Some(&txid) {
+        return Err(storage_error("signer changed transaction identity"));
+    }
+    record.signed_psbt = Some(signed);
+    record.phase = Phase::Prepared;
+    record.failure_code = None;
+    write(dir, record)?;
+    response(&request.operation_id, Some(record), false)
+}
+
+// The wallet error can contain addresses, asset IDs, file paths, balances or remote response
+// bodies. Match typed variants only; never serialize or parse Display/Debug text as public copy.
+fn prepare_failure_code(error: &rgb_lib::Error) -> &'static str {
+    use rgb_lib::Error;
+    match error {
+        Error::InsufficientBitcoins { .. } => "insufficient_bitcoins",
+        Error::InsufficientAssignments { .. } => "insufficient_asset_balance",
+        Error::InsufficientAllocationSlots => "insufficient_allocations",
+        Error::InvalidAddress { .. }
+        | Error::InvalidRecipientData { .. }
+        | Error::InvalidRecipientID
+        | Error::InvalidRecipientMap
+        | Error::InvalidRecipientNetwork
+        | Error::RecipientIDAlreadyUsed
+        | Error::RecipientIDDuplicated
+        | Error::InvalidInvoice { .. } => "invalid_recipient",
+        Error::InvalidAmountZero | Error::InvalidAssignment | Error::OutputBelowDustLimit => {
+            "invalid_amount"
+        }
+        Error::InvalidFeeRate { .. }
+        | Error::MaxFeeExceeded { .. }
+        | Error::MinFeeNotMet { .. } => "invalid_fee",
+        Error::FailedBdkSync { .. }
+        | Error::Indexer { .. }
+        | Error::Network { .. }
+        | Error::Proxy { .. }
+        | Error::NoValidTransportEndpoint
+        | Error::CannotEstimateFees => "network_unavailable",
+        Error::AssetNotFound { .. }
+        | Error::BitcoinNetworkMismatch
+        | Error::InvalidBitcoinNetwork { .. }
+        | Error::InvalidElectrum { .. }
+        | Error::InvalidIndexer { .. }
+        | Error::InvalidProxyProtocol { .. }
+        | Error::InvalidEthRpcUrl { .. }
+        | Error::InvalidTransportEndpoint { .. }
+        | Error::InvalidTransportEndpoints { .. }
+        | Error::InvalidExpiration
+        | Error::Offline
+        | Error::OnlineNeeded => "invalid_configuration",
+        Error::Database { .. }
+        | Error::IO { .. }
+        | Error::Inconsistency { .. }
+        | Error::RestoredBackupInconsistent { .. }
+        | Error::InexistentDataDir
+        | Error::InexistentWalletManifest { .. } => "storage_unavailable",
+        _ => "preparation_failed",
+    }
+}
+
+fn persist_unsigned(
+    dir: &Path,
+    record: &mut Record,
+    unsigned: &str,
+    batch: Option<i32>,
+) -> Result<(), rgb_lib::Error> {
+    let psbt = Psbt::from_str(unsigned).map_err(|_| rgb_lib::Error::Internal {
+        details: "durable unsigned transaction is malformed".into(),
+    })?;
+    if (record.request.kind == Kind::Bitcoin) != batch.is_none()
+        || batch.is_some_and(|index| index < 0)
+    {
+        return Err(rgb_lib::Error::Internal {
+            details: "durable prepared batch identity is invalid".into(),
+        });
+    }
+    record.txid = Some(psbt.unsigned_tx.compute_txid().to_string());
+    record.unsigned_psbt = Some(unsigned.to_string());
+    record.batch_transfer_index = batch;
+    write(dir, record).map_err(|_| rgb_lib::Error::Internal {
+        details: "durable unsigned transaction could not be saved".into(),
+    })
+}
+
+fn sync_transfer_metadata(dir: &Path, depth: u8) -> std::io::Result<()> {
+    if depth > 16 {
+        return Err(std::io::Error::other("transfer metadata nesting limit"));
+    }
+    for entry in fs::read_dir(dir)? {
+        let entry = entry?;
+        let kind = entry.file_type()?;
+        if kind.is_dir() {
+            sync_transfer_metadata(&entry.path(), depth + 1)?;
+        } else if kind.is_file() {
+            File::open(entry.path())?.sync_all()?;
+        } else {
+            return Err(std::io::Error::other("unexpected transfer metadata entry"));
+        }
+    }
+    File::open(dir)?.sync_all()
+}
+
+pub(crate) async fn commit(state: Arc<AppState>, json: String) -> Result<String, APIError> {
+    require_local_journal(&state)?;
+    if json.len() > 200_000 {
+        return Err(invalid("durable payment request too large"));
+    }
+    let request: Request =
+        serde_json::from_str(&json).map_err(|_| invalid("invalid durable payment JSON"))?;
+    request.validate()?;
+    let id = request.operation_id.clone();
+    let guard = sdk::check_unlocked_owned(&state).await?;
+    blocking_native(move || {
+        let common = guard.as_ref().unwrap();
+        let dir = directory(&state);
+        let _lock = lock_directory(&dir)?;
+        let mut record = read(&dir, &id, &binding(common))?
+            .ok_or_else(|| invalid("durable payment operation not found"))?;
+        if record.request != request {
+            return Err(invalid("durable payment ID is bound to another request"));
+        }
+        if observed_and_recorded(common, &dir, &mut record)? {
+            return response(&id, Some(&record), true);
+        }
+        if matches!(record.phase, Phase::Preparing | Phase::Rejected) {
+            return response(&id, Some(&record), false);
+        }
+        if record.phase == Phase::Prepared
+            && record.request.kind == Kind::Rgb
+            && record
+                .request
+                .expiration_timestamp
+                .is_some_and(|expiry| expiry <= crate::utils::get_current_timestamp())
+        {
+            record.failure_code = Some("invoice_expired".into());
+            write(&dir, &record)?;
+            return response(&id, Some(&record), false);
+        }
+        // Persist authorization before releasing the exact signed transaction to native End.
+        record.phase = Phase::Committing;
+        record.failure_code = None;
+        write(&dir, &record)?;
+        let signed = record
+            .signed_psbt
+            .clone()
+            .ok_or_else(|| storage_error("missing signed transaction"))?;
+        let result = match record.request.kind {
+            Kind::Bitcoin => common.rgb_send_btc_end(signed).map(|txid| (txid, None)),
+            Kind::Rgb => {
+                // Never bring a failed/progressed batch back to WaitingCounterparty.
+                let transfers = common.rgb_list_transfers(
+                    AssetFilter::Id(record.request.asset_id.clone().unwrap()),
+                    record.txid.clone(),
+                )?;
+                if transfers.iter().any(|t| {
+                    t.batch_transfer_idx == record.batch_transfer_index.unwrap()
+                        && t.status == TransferStatus::Failed
+                }) {
+                    record.failure_code = Some("native_transfer_failed".into());
+                    write(&dir, &record)?;
+                    return response(&id, Some(&record), false);
+                }
+                common
+                    .rgb_send_end(signed)
+                    .map(|r| (r.txid, Some(r.batch_transfer_idx)))
+            }
+        };
+        match result {
+            Ok((txid, batch))
+                if record.txid.as_ref() == Some(&txid)
+                    && ((record.request.kind == Kind::Bitcoin) == batch.is_none()) =>
+            {
+                record.batch_transfer_index = batch;
+                record.phase = Phase::Accepted;
+                record.failure_code = None;
+            }
+            Ok(_) => record.failure_code = Some("native_identity_mismatch".into()),
+            Err(_) => record.failure_code = Some("native_commit_failed".into()),
+        }
+        write(&dir, &record)?;
+        response(&id, Some(&record), false)
+    })
+    .await
+}
