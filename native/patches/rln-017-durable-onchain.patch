+#[test]
+fn unsigned_callback_write_failures_never_erase_the_last_authoritative_state() {
+    // The patched native begin invokes this same writer synchronously before
+    // committing its SQL transaction. A returned error aborts that transaction;
+    // a lost acknowledgement after rename still retains the exact PSBT for
+    // recovery. Funded SQL/proxy crash qualification is a separate test scope.
+    for point in [
+        WriteFault::AfterTempFlush,
+        WriteFault::AfterRename,
+        WriteFault::AfterDirectorySync,
+    ] {
+        let root = tempfile::tempdir().unwrap();
+        let dir = root.path().join("outbox");
+        let _lock = lock_directory(&dir).unwrap();
+        let mut value = preparing();
+        write(&dir, &value).unwrap();
+        let psbt = unsigned();
+        value.txid = Some(psbt.unsigned_tx.compute_txid().to_string());
+        value.unsigned_psbt = Some(psbt.to_string());
+        let _reset = fault(point);
+        assert!(write(&dir, &value).is_err());
+        let recovered = read(&dir, &value.request.operation_id, "wallet-a")
+            .unwrap()
+            .unwrap();
+        assert_eq!(status(&recovered)["endAuthorized"], false);
+        if point == WriteFault::AfterTempFlush {
+            assert!(recovered.unsigned_psbt.is_none());
+        } else {
+            assert_eq!(recovered.unsigned_psbt, value.unsigned_psbt);
+            assert_eq!(recovered.txid, value.txid);
+        }
+    }
+}
