+    // Once a consignment may have reached a proxy, its bytes must survive stash changes. Snapshot
+    // every asset atomically before any POST, with the exact txid, asset and byte digest bound in
+    // each snapshot. Partial staging files are never authoritative and snapshots are never replaced.
+    #[cfg(any(feature = "electrum", feature = "esplora"))]
+    fn gen_immutable_send_consignments(
+        &self,
+        fascia: &Fascia,
+        transfer_info_map: &BTreeMap<String, InfoAssetTransfer>,
+        transfer_dir: &PathBuf,
+        txid: &str,
+    ) -> Result<(), Error> {
+        let durable_dir = transfer_dir.join("durable_send_consignments");
+        let snapshots_dir = durable_dir.join("snapshots");
+        let staging_dir = durable_dir.join("building");
+        for directory in [&durable_dir, &snapshots_dir, &staging_dir] {
+            fs::create_dir_all(directory)?;
+            if !fs::symlink_metadata(directory)?.file_type().is_dir() {
+                return Err(Error::InvalidConsignment);
+            }
+            fs::File::open(directory.parent().ok_or(Error::InvalidConsignment)?)?.sync_all()?;
+        }
+        let expected = transfer_info_map
+            .keys()
+            .map(|id| id.replace(ASSET_ID_PREFIX, ""))
+            .collect::<BTreeSet<_>>();
+        let manifest_path = durable_dir.join("complete.json");
+        let completed: Option<DurableSendManifest> = match fs::symlink_metadata(&manifest_path) {
+            Ok(metadata) if !metadata.file_type().is_file() => {
+                return Err(Error::InvalidConsignment);
+            }
+            Ok(_) => Some(
+                serde_json::from_reader(fs::File::open(&manifest_path)?)
+                    .map_err(|_| Error::InvalidConsignment)?,
+            ),
+            Err(error) if error.kind() == ErrorKind::NotFound => None,
+            Err(error) => return Err(error.into()),
+        };
+        if completed.as_ref().is_some_and(|manifest| {
+            manifest.version != 1
+                || manifest.txid != txid
+                || manifest.snapshots.keys().cloned().collect::<BTreeSet<_>>() != expected
+        }) {
+            return Err(Error::InvalidConsignment);
+        }
+        let mut snapshot_digests = BTreeMap::new();
+        for entry in fs::read_dir(&snapshots_dir)? {
+            let entry = entry?;
+            if !entry.file_type()?.is_file()
+                || !expected.contains(&entry.file_name().to_string_lossy().to_string())
+            {
+                return Err(Error::InvalidConsignment);
+            }
+        }
+        for (asset_id, transfer_info) in transfer_info_map {
+            let name = asset_id.replace(ASSET_ID_PREFIX, "");
+            let snapshot = snapshots_dir.join(&name);
+            if !snapshot.exists() {
+                if completed.is_some() {
+                    return Err(Error::InvalidConsignment);
+                }
+                let staged_asset_dir = self.get_asset_transfer_dir(&staging_dir, asset_id);
+                fs::create_dir_all(&staged_asset_dir)?;
+                if !fs::symlink_metadata(&staged_asset_dir)?
+                    .file_type()
+                    .is_dir()
+                {
+                    return Err(Error::InvalidConsignment);
+                }
+                let generated = self.get_send_consignment_path_impl(&staged_asset_dir);
+                if fs::symlink_metadata(&generated).is_ok() {
+                    fs::remove_file(&generated)?;
+                }
+                let one_asset = BTreeMap::from([(asset_id.clone(), transfer_info.clone())]);
+                self.gen_consignments(fascia, &one_asset, &staging_dir)?;
+                let bytes = fs::read(generated)?;
+                let saved = DurableSendConsignment::new(txid, asset_id, &bytes);
+                let temporary = staging_dir.join(format!("{name}.snapshot"));
+                if fs::symlink_metadata(&temporary).is_ok() {
+                    fs::remove_file(&temporary)?;
+                }
+                let mut file = fs::OpenOptions::new()
+                    .write(true)
+                    .create_new(true)
+                    .open(&temporary)?;
+                serde_json::to_writer(&mut file, &saved).map_err(|_| Error::InvalidConsignment)?;
+                file.sync_all()?;
+                fs::rename(temporary, &snapshot)?;
+                fs::File::open(&snapshots_dir)?.sync_all()?;
+                fs::File::open(&staging_dir)?.sync_all()?;
+            }
+            if !fs::symlink_metadata(&snapshot)?.file_type().is_file() {
+                return Err(Error::InvalidConsignment);
+            }
+            let envelope_bytes = fs::read(snapshot)?;
+            let digest = <sha256::Hash as Sha256Hash>::hash(&envelope_bytes).to_string();
+            if completed
+                .as_ref()
+                .is_some_and(|manifest| manifest.snapshots.get(&name) != Some(&digest))
+            {
+                return Err(Error::InvalidConsignment);
+            }
+            snapshot_digests.insert(name, digest);
+            let saved: DurableSendConsignment =
+                serde_json::from_slice(&envelope_bytes).map_err(|_| Error::InvalidConsignment)?;
+            let bytes = saved.bytes(txid, asset_id)?;
+            let asset_dir = self.get_asset_transfer_dir(transfer_dir, asset_id);
+            fs::create_dir_all(&asset_dir)?;
+            if !fs::symlink_metadata(&asset_dir)?.file_type().is_dir() {
+                return Err(Error::InvalidConsignment);
+            }
+            let destination = self.get_send_consignment_path_impl(&asset_dir);
+            let temporary = asset_dir.join("consignment_out.restoring");
+            if fs::symlink_metadata(&temporary).is_ok() {
+                fs::remove_file(&temporary)?;
+            }
+            let mut file = fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&temporary)?;
+            file.write_all(&bytes)?;
+            file.sync_all()?;
+            // Parse before exposing the restored file, including its exact contract identity.
+            let consignment =
+                RgbTransfer::load_file(&temporary).map_err(|_| Error::InvalidConsignment)?;
+            if consignment.contract_id() != transfer_info.asset_info.contract_id {
+                return Err(Error::InvalidConsignment);
+            }
+            fs::rename(&temporary, destination)?;
+            fs::File::open(&asset_dir)?.sync_all()?;
+            fs::File::open(transfer_dir)?.sync_all()?;
+        }
+        if completed.is_none() {
+            let manifest = DurableSendManifest {
+                version: 1,
+                txid: txid.into(),
+                snapshots: snapshot_digests,
+            };
+            let temporary = staging_dir.join("complete.json");
+            if fs::symlink_metadata(&temporary).is_ok() {
+                fs::remove_file(&temporary)?;
+            }
+            let mut file = fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&temporary)?;
+            serde_json::to_writer(&mut file, &manifest).map_err(|_| Error::InvalidConsignment)?;
+            file.sync_all()?;
+            fs::rename(temporary, &manifest_path)?;
+            fs::File::open(&durable_dir)?.sync_all()?;
+            fs::File::open(&staging_dir)?.sync_all()?;
+        }
+        Ok(())
+    }
