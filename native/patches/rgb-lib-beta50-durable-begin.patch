+fn posted_consignment_matches(
+    expected: &[u8],
+    txid: &str,
+    vout: Option<u32>,
+    existing: &GetConsignmentResponse,
+) -> bool {
+    existing.txid == txid
+        && existing.vout == vout
+        && existing.consignment.len()
+            <= expected
+                .len()
+                .saturating_add(2)
+                .saturating_div(3)
+                .saturating_mul(4)
+        && general_purpose::STANDARD
+            .decode(&existing.consignment)
+            .is_ok_and(|actual| actual == expected)
+}
+
+#[cfg(test)]
+mod durable_consignment_tests {
+    use super::*;
+    #[test]
+    fn only_the_exact_prior_post_can_be_resumed() {
+        let bytes = b"exact outgoing consignment";
+        let mut existing = GetConsignmentResponse {
+            consignment: general_purpose::STANDARD.encode(bytes),
+            txid: "a".repeat(64),
+            vout: Some(2),
+            validated: None,
+        };
+        assert!(posted_consignment_matches(
+            bytes,
+            &existing.txid,
+            Some(2),
+            &existing
+        ));
+        assert!(!posted_consignment_matches(
+            bytes,
+            &"b".repeat(64),
+            Some(2),
+            &existing
+        ));
+        assert!(!posted_consignment_matches(
+            bytes,
+            &existing.txid,
+            Some(1),
+            &existing
+        ));
+        assert!(!posted_consignment_matches(
+            b"other consignment",
+            &existing.txid,
+            Some(2),
+            &existing
+        ));
+        existing.consignment = "invalid base64".into();
+        assert!(!posted_consignment_matches(
+            bytes,
+            &existing.txid,
+            Some(2),
+            &existing
+        ));
+    }
+}
