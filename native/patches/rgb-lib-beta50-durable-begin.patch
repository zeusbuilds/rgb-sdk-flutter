+// Private envelope for immutable first-POST bytes. A complete envelope is renamed into place
+// only after its file is durable; a valid JSON file alone is insufficient without every binding.
+#[cfg(any(feature = "electrum", feature = "esplora"))]
+#[derive(serde::Serialize, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct DurableSendConsignment {
+    version: u8,
+    txid: String,
+    asset_id: String,
+    digest: String,
+    consignment: String,
+}
+
+#[cfg(any(feature = "electrum", feature = "esplora"))]
+#[derive(serde::Serialize, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct DurableSendManifest {
+    version: u8,
+    txid: String,
+    snapshots: BTreeMap<String, String>,
+}
+
+#[cfg(any(feature = "electrum", feature = "esplora"))]
+impl DurableSendConsignment {
+    fn new(txid: &str, asset_id: &str, bytes: &[u8]) -> Self {
+        Self {
+            version: 1,
+            txid: txid.into(),
+            asset_id: asset_id.into(),
+            digest: <sha256::Hash as Sha256Hash>::hash(bytes).to_string(),
+            consignment: general_purpose::STANDARD.encode(bytes),
+        }
+    }
+    fn bytes(&self, txid: &str, asset_id: &str) -> Result<Vec<u8>, Error> {
+        let bytes = general_purpose::STANDARD
+            .decode(&self.consignment)
+            .map_err(|_| Error::InvalidConsignment)?;
+        if self.version != 1
+            || self.txid != txid
+            || self.asset_id != asset_id
+            || self.digest != <sha256::Hash as Sha256Hash>::hash(&bytes).to_string()
+        {
+            return Err(Error::InvalidConsignment);
+        }
+        Ok(bytes)
+    }
+}
