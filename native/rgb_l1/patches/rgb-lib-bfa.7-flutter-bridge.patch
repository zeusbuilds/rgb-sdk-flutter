diff --git a/src/wallet/durable_bridge.rs b/src/wallet/durable_bridge.rs
new file mode 100644
index 0000000..210ceea
--- /dev/null
+++ b/src/wallet/durable_bridge.rs
@@ -0,0 +1,669 @@
+//! Native request binding for the Dev bridge. Request IDs are host-generated
+//! from an authenticated session and survive process restarts.
+use super::*;
+use base64::{Engine, engine::general_purpose::STANDARD};
+use tiny_keccak::{Hasher, Keccak};
+
+const DEV_BUSDT: &str = "rgb:A6k89KtR-e3oXqRP-uH3jUrz-LU_sYL3-hMZ0k3O-6u8DXbE";
+const DEV_INDEXER: &str = "https://dev.esplora-01.mint.utexo.com";
+const DEV_PROXY: &str = "rpcs://dev.rgb-proxy.utexo.com/json-rpc";
+const MAX_BRIDGE_FEE: u64 = 5_000;
+const MAX_PROOF: u64 = 10 * 1024 * 1024;
+const MAX_REQUEST: usize = 4_096;
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct BridgeBurnRequest {
+    pub(super) operation_id: String,
+    pub(super) scope_key: String,
+    pub(super) request_key: String,
+    pub(super) asset_id: String,
+    pub(super) amount: String,
+    pub(super) fee_rate: String,
+    pub(super) min_confirmations: u8,
+    pub(super) recipient_address: String,
+    pub(super) destination_commitment: String,
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct BridgeBlindRequest {
+    operation_id: String,
+    scope_key: String,
+    request_key: String,
+    asset_id: String,
+    amount: Option<String>,
+    duration_seconds: u32,
+    min_confirmations: u8,
+    transport_endpoint: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct BridgeProofRequest {
+    scope_key: String,
+    asset_id: String,
+    txid: String,
+}
+
+#[derive(Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct BlindReceipt {
+    request: BridgeBlindRequest,
+    invoice: String,
+    recipient_id: String,
+    expiration_timestamp: String,
+    batch_transfer_idx: i32,
+    public_key: String,
+}
+
+fn parse_bridge<T: serde::de::DeserializeOwned>(raw: &str) -> Result<T, Error> {
+    if raw.len() > MAX_REQUEST {
+        return Err(fail("RECOVERY_REQUEST_INVALID"));
+    }
+    serde_json::from_str(raw).map_err(|_| fail("RECOVERY_REQUEST_INVALID"))
+}
+
+fn identifiers(id: &str, scope: &str, request: &str, asset: &str) -> Result<(), Error> {
+    if !hex(id, 32)
+        || !hex(scope, 64)
+        || !hex(request, 64)
+        || asset.len() > 128
+        || ContractId::from_str(asset).is_err()
+    {
+        return Err(fail("RECOVERY_REQUEST_INVALID"));
+    }
+    Ok(())
+}
+
+fn keccak(value: &[u8]) -> [u8; 32] {
+    let mut hash = Keccak::v256();
+    hash.update(value);
+    let mut digest = [0; 32];
+    hash.finalize(&mut digest);
+    digest
+}
+
+fn direct_arbitrum_commitment(address: &str) -> Result<String, Error> {
+    let Some(address) = address.strip_prefix("0x") else {
+        return Err(fail("RECOVERY_REQUEST_INVALID"));
+    };
+    if !hex(address, 40) || address.bytes().all(|c| c == b'0') {
+        return Err(fail("RECOVERY_REQUEST_INVALID"));
+    }
+    let recipient = hex::decode(address).map_err(storage)?;
+    let mut tuple = [0; 128];
+    tuple[..32].copy_from_slice(&keccak(
+        b"UtexoBurnDestinationV1(uint64 destinationChainId,uint32 dstEid,bytes recipient)",
+    ));
+    tuple[56..64].copy_from_slice(&42161u64.to_be_bytes());
+    tuple[96..].copy_from_slice(&keccak(&recipient));
+    Ok(hex::encode(keccak(&tuple)))
+}
+
+impl BridgeBurnRequest {
+    pub(super) fn validate(&self) -> Result<(), Error> {
+        identifiers(
+            &self.operation_id,
+            &self.scope_key,
+            &self.request_key,
+            &self.asset_id,
+        )?;
+        decimal(&self.amount, true)?;
+        if self.min_confirmations < 6
+            || decimal(&self.fee_rate, true)? > 1000
+            || self.destination_commitment != direct_arbitrum_commitment(&self.recipient_address)?
+        {
+            return Err(fail("RECOVERY_REQUEST_INVALID"));
+        }
+        Ok(())
+    }
+}
+
+fn bridge_eligible(outbox: &Outbox, asset: &str, endpoint: Option<&str>) -> Result<(), Error> {
+    if outbox.restored_snapshot {
+        return Err(fail("RECOVERY_RESTORE_UNCERTAIN"));
+    }
+    let hosted = outbox.network == "utexo"
+        && asset == DEV_BUSDT
+        && endpoint.is_none_or(|value| value == DEV_PROXY);
+    // Local bridge qualification accepts only the regtest resolver and a numeric
+    // loopback proxy. The mobile host grants no bridge permissions in Regtest.
+    let local = outbox.network == "regtest"
+        && endpoint.is_none_or(|value| {
+            let Some(address) = value.strip_prefix("rpc://") else {
+                return false;
+            };
+            is_loopback_url(&format!("http://{address}"))
+        });
+    if !hosted && !local {
+        return Err(fail("BRIDGE_DEPLOYMENT_UNQUALIFIED"));
+    }
+    Ok(())
+}
+
+fn is_loopback_url(value: &str) -> bool {
+    reqwest::Url::parse(value).ok().is_some_and(|url| {
+        url.scheme() == "http"
+            && url.host_str() == Some("127.0.0.1")
+            && url.port().is_some()
+            && url.username().is_empty()
+            && url.password().is_none()
+            && url.query().is_none()
+            && url.fragment().is_none()
+    })
+}
+
+fn require_bridge_online(wallet: &Wallet, outbox: &Outbox, online: Online) -> Result<(), Error> {
+    wallet.check_online(online)?;
+    wallet.require_recovery_online_profile(&outbox.network)?;
+    let indexer = &wallet
+        .online_data()
+        .as_ref()
+        .ok_or(Error::Offline)?
+        .indexer_config;
+    let allowed = match (outbox.network.as_str(), indexer) {
+        ("utexo", IndexerConfig::DevSignetEsplora { url }) => url == DEV_INDEXER,
+        ("regtest", IndexerConfig::Esplora { url }) => is_loopback_url(url),
+        _ => false,
+    };
+    if allowed {
+        Ok(())
+    } else {
+        Err(fail("BRIDGE_DEPLOYMENT_UNQUALIFIED"))
+    }
+}
+
+fn require_bridge_asset(wallet: &Wallet, asset: &str) -> Result<(), Error> {
+    if wallet.get_asset_metadata(asset.into())?.asset_schema != AssetSchema::Bfa {
+        return Err(fail("BRIDGE_DEPLOYMENT_UNQUALIFIED"));
+    }
+    Ok(())
+}
+
+fn blind_receipt_mac(store: &Store, outbox: &Outbox, receipt: &str) -> Result<String, Error> {
+    use hmac::{Hmac, KeyInit, Mac};
+    let mut mac =
+        <Hmac<sha2::Sha256> as KeyInit>::new_from_slice(&store.key[..]).map_err(storage)?;
+    mac.update(b"flutter-bridge-blind-v1:");
+    mac.update(outbox.cohort.as_bytes());
+    mac.update(receipt.as_bytes());
+    Ok(hex::encode(mac.finalize().into_bytes()))
+}
+
+fn bridge_blind_row(
+    txn: &DbTxn,
+    store: &Store,
+    outbox: &Outbox,
+    request: &BridgeBlindRequest,
+) -> Result<Option<String>, Error> {
+    let table = block_on(txn.inner().query_one_raw(Statement::from_string(
+        DbBackend::Sqlite,
+        "SELECT name FROM sqlite_master WHERE type='table' AND name='flutter_bridge_blind_v1'",
+    )))
+    .map_err(storage)?;
+    if table.is_none() {
+        return Ok(None);
+    }
+    let row = block_on(txn.inner().query_one_raw(Statement::from_sql_and_values(
+        DbBackend::Sqlite,
+        "SELECT receipt,mac FROM flutter_bridge_blind_v1 WHERE operation_id=?",
+        [request.operation_id.clone().into()],
+    )))
+    .map_err(storage)?;
+    let Some(row) = row else {
+        return Ok(None);
+    };
+    let raw: String = row.try_get("", "receipt").map_err(storage)?;
+    let mac: String = row.try_get("", "mac").map_err(storage)?;
+    if raw.len() > 16000 || blind_receipt_mac(store, outbox, &raw)? != mac {
+        return Err(storage("bridge invoice receipt authentication"));
+    }
+    let receipt: BlindReceipt = serde_json::from_str(&raw).map_err(storage)?;
+    if receipt.request != *request {
+        return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+    }
+    if decimal(&receipt.expiration_timestamp, true)?
+        <= std::cmp::max(time::OffsetDateTime::now_utc().unix_timestamp(), 0) as u64
+    {
+        return Err(fail("BRIDGE_INVOICE_EXPIRED"));
+    }
+    Ok(Some(blind_response(&receipt)))
+}
+
+fn blind_response(r: &BlindReceipt) -> String {
+    json!({
+        "operationId":r.request.operation_id,
+        "scopeKey":r.request.scope_key,
+        "requestKey":r.request.request_key,
+        "assetId":r.request.asset_id,
+        "invoice":r.invoice,
+        "recipientId":r.recipient_id,
+        "expirationTimestamp":r.expiration_timestamp,
+        "batchTransferIdx":r.batch_transfer_idx,
+        "publicKey":r.public_key,
+        "minConfirmations":r.request.min_confirmations
+    })
+    .to_string()
+}
+
+impl Wallet {
+    pub(super) fn inspect_bridge_burn_plan(
+        &self,
+        txn: &DbTxn,
+        raw: &str,
+        info: &InfoBatchTransfer,
+        psbt: &Psbt,
+        directory: &Path,
+        burn: &BridgeBurnRequest,
+    ) -> Result<(), Error> {
+        bridge_fee(psbt)?;
+        if info.min_confirmations != burn.min_confirmations
+            || info.donation
+            || info.transfers.len() != 1
+            || info.sender_transport_endpoint.is_some()
+            || !info.is_operation(&TypeOfTransition::Burn)
+        {
+            return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+        }
+        let fascia = directory.join(FASCIA_FILE);
+        let inspection = self.inspect_rgb_transfer_impl(
+            txn,
+            raw.into(),
+            fascia
+                .to_str()
+                .ok_or_else(|| storage("fascia path"))?
+                .into(),
+            info.entropy,
+        )?;
+        if !burn_inspection_matches(
+            &inspection,
+            burn,
+            &psbt.unsigned_tx.compute_txid().to_string(),
+            true,
+        ) {
+            return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+        }
+        Ok(())
+    }
+
+    /// Create a blind invoice exactly once, or read the durable receipt without
+    /// allocating an output, reserving a proxy recipient or replaying a request.
+    pub fn bridge_blind_receive(
+        &mut self,
+        online: Option<Online>,
+        raw: String,
+        recovery_only: bool,
+    ) -> Result<String, Error> {
+        let request: BridgeBlindRequest = parse_bridge(&raw)?;
+        identifiers(
+            &request.operation_id,
+            &request.scope_key,
+            &request.request_key,
+            &request.asset_id,
+        )?;
+        if !(3600..=604800).contains(&request.duration_seconds) || request.min_confirmations < 3 {
+            return Err(fail("RECOVERY_REQUEST_INVALID"));
+        }
+        let assignment = match request.amount.as_deref() {
+            Some(amount) => Assignment::Fungible(decimal(amount, true)?),
+            None => Assignment::Any,
+        };
+        let store = Store::open(self, false)?;
+        let outbox = store.read(self)?;
+        bridge_eligible(
+            &outbox,
+            &request.asset_id,
+            Some(&request.transport_endpoint),
+        )?;
+        require_bridge_asset(self, &request.asset_id)?;
+        let txn = self.database().begin_transaction()?;
+        if let Some(reply) = bridge_blind_row(&txn, &store, &outbox, &request)? {
+            txn.commit()?;
+            return Ok(reply);
+        }
+        if recovery_only {
+            txn.commit()?;
+            return Ok("null".into());
+        }
+        let online = online.ok_or(Error::Offline)?;
+        require_bridge_online(self, &outbox, online)?;
+        if outbox.records.iter().any(|record| !record.terminal()) {
+            return Err(fail("RECOVERY_PENDING"));
+        }
+        block_on(txn.inner().execute_raw(Statement::from_string(
+            DbBackend::Sqlite,
+            "CREATE TABLE IF NOT EXISTS flutter_bridge_blind_v1 (operation_id TEXT PRIMARY KEY, receipt TEXT NOT NULL, mac TEXT NOT NULL) WITHOUT ROWID",
+        ))).map_err(storage)?;
+        let count = block_on(txn.inner().query_one_raw(Statement::from_string(
+            DbBackend::Sqlite,
+            "SELECT COUNT(*) AS size FROM flutter_bridge_blind_v1",
+        )))
+        .map_err(storage)?
+        .ok_or_else(|| storage("invoice receipt count"))?;
+        if count.try_get::<i64>("", "size").map_err(storage)? >= MAX_RECORDS as i64 {
+            return Err(fail("RECOVERY_CAPACITY"));
+        }
+        let expiration = time::OffsetDateTime::now_utc()
+            .unix_timestamp()
+            .checked_add(i64::from(request.duration_seconds))
+            .filter(|value| *value > 0)
+            .ok_or_else(|| fail("RECOVERY_REQUEST_INVALID"))?;
+        let native = self.create_receive_data(
+            &txn,
+            Some(online),
+            Some(request.asset_id.clone()),
+            assignment,
+            expiration,
+            vec![request.transport_endpoint.clone()],
+            RecipientType::Blind,
+            None,
+            None,
+        )?;
+        let batch = self.store_receive_transfer(&txn, &native, request.min_confirmations)?;
+        let receipt = BlindReceipt {
+            request,
+            invoice: native.invoice_string,
+            recipient_id: native.recipient_id,
+            expiration_timestamp: native.expiration_timestamp.to_string(),
+            batch_transfer_idx: batch,
+            public_key: hex::encode(native.recipient_pubkey),
+        };
+        let raw = serde_json::to_string(&receipt).map_err(storage)?;
+        let mac = blind_receipt_mac(&store, &outbox, &raw)?;
+        block_on(txn.inner().execute_raw(Statement::from_sql_and_values(
+            DbBackend::Sqlite,
+            "INSERT INTO flutter_bridge_blind_v1 VALUES (?,?,?)",
+            [
+                receipt.request.operation_id.clone().into(),
+                raw.into(),
+                mac.into(),
+            ],
+        )))
+        .map_err(storage)?;
+        self.update_backup_info(&txn, false)?;
+        self.persist_and_commit(txn)?;
+        Ok(blind_response(&receipt))
+    }
+
+    fn bridge_burn_envelope(&self, raw: &str, online: Option<Online>) -> Result<Envelope, Error> {
+        let burn: BridgeBurnRequest = parse_bridge(raw)?;
+        burn.validate()?;
+        let store = Store::open(self, false)?;
+        let outbox = store.read(self)?;
+        bridge_eligible(&outbox, &burn.asset_id, None)?;
+        require_bridge_asset(self, &burn.asset_id)?;
+        if let Some(online) = online {
+            require_bridge_online(self, &outbox, online)?;
+        }
+        let mut envelope = Envelope {
+            version: 3,
+            backend: "RGB_L1".into(),
+            network: outbox.network,
+            wallet_binding: outbox.wallet_binding,
+            recovery_cohort: outbox.cohort,
+            native_source_revision: SOURCE.into(),
+            native_overlay: OVERLAY.into(),
+            request: Request {
+                version: 2,
+                operation_id: burn.operation_id.clone(),
+                kind: Kind::Burn,
+                amount: burn.amount.clone(),
+                fee_rate: burn.fee_rate.clone(),
+                address: None,
+                asset_id: Some(burn.asset_id.clone()),
+                recipient_id: None,
+                transport_endpoints: vec![],
+                sender_transport_endpoint: None,
+                witness_amount_sat: None,
+                witness_blinding: None,
+                min_confirmations: burn.min_confirmations,
+                donation: false,
+                expiration_timestamp: None,
+                invoice_public_key: None,
+                invoice_encryption: None,
+                bridge_burn: Some(burn),
+                fingerprint: String::new(),
+            },
+        };
+        envelope.request.fingerprint =
+            sha256::Hash::hash(&serde_json::to_vec(&envelope).map_err(storage)?).to_string();
+        envelope.validate()?;
+        Ok(envelope)
+    }
+
+    /// Plan a bounded bridge burn without submitting a Bitcoin transaction.
+    pub fn prepare_bridge_burn(&mut self, online: Online, raw: String) -> Result<String, Error> {
+        let envelope = self.bridge_burn_envelope(&raw, Some(online))?;
+        self.prepare_onchain_envelope(online, envelope)
+    }
+
+    /// Submit exactly the prepared bridge transaction with explicit authorization.
+    pub fn commit_bridge_burn(&mut self, online: Online, raw: String) -> Result<String, Error> {
+        let envelope = self.bridge_burn_envelope(&raw, Some(online))?;
+        self.commit_onchain_envelope(online, envelope)
+    }
+
+    /// Recover the original burn from its local receipt or exact chain evidence.
+    pub fn observe_bridge_burn(
+        &mut self,
+        online: Option<Online>,
+        raw: String,
+    ) -> Result<String, Error> {
+        if let Ok(lookup) = parse_bridge::<BridgeProofRequest>(&raw) {
+            let store = Store::open(self, false)?;
+            let outbox = store.read(self)?;
+            bridge_eligible(&outbox, &lookup.asset_id, None)?;
+            let Some(record) = lookup.accepted(&outbox)? else {
+                return Ok("null".into());
+            };
+            let mut response = record.response();
+            if let Some(online) = online {
+                require_bridge_online(self, &outbox, online)?;
+                response["confirmations"] =
+                    json!(self.indexer().get_tx_confirmations(&lookup.txid)?);
+            }
+            return Ok(response.to_string());
+        }
+        let envelope = self.bridge_burn_envelope(&raw, online)?;
+        self.observe_onchain_envelope(online, envelope)
+    }
+
+    /// Cancel a bridge burn only before any broadcast could have taken place.
+    pub fn cancel_bridge_burn(
+        &mut self,
+        online: Option<Online>,
+        raw: String,
+    ) -> Result<String, Error> {
+        let envelope = self.bridge_burn_envelope(&raw, online)?;
+        self.cancel_onchain_envelope(online, envelope, false)
+    }
+
+    /// Export only a native-owned, accepted, independently verified BFA burn.
+    pub fn bridge_burn_proof(&self, raw: String) -> Result<String, Error> {
+        let request: BridgeProofRequest = parse_bridge(&raw)?;
+        let store = Store::open(self, false)?;
+        let outbox = store.read(self)?;
+        bridge_eligible(&outbox, &request.asset_id, None)?;
+        let record = request.accepted(&outbox)?.ok_or_else(proof_error)?;
+        let burn = record.bridge_burn.as_ref().ok_or_else(proof_error)?;
+        let rows = self.list_transfers(
+            AssetFilter::Id(request.asset_id.clone()),
+            TransferScope::Txid(request.txid.clone()),
+        )?;
+        let mut rows = rows.iter().filter(|row| {
+            row.kind == TransferKind::Burn
+                && Some(row.batch_transfer_idx) == record.batch_transfer_index
+                && matches!(
+                    row.status,
+                    TransferStatus::WaitingConfirmations | TransferStatus::Settled
+                )
+                && row.txid.as_deref() == Some(&request.txid)
+        });
+        let row = rows.next().ok_or_else(proof_error)?;
+        if rows.next().is_some() {
+            return Err(proof_error());
+        }
+        let path = Path::new(row.consignment_path.as_deref().ok_or_else(proof_error)?);
+        let root = self.get_wallet_dir();
+        if path.canonicalize().map_err(|_| proof_error())? != path || !path.starts_with(&root) {
+            return Err(proof_error());
+        }
+        let mut file = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+            .open(path)
+            .map_err(|_| proof_error())?;
+        let meta = file.metadata().map_err(|_| proof_error())?;
+        if !meta.is_file() || meta.nlink() != 1 || meta.len() > MAX_PROOF {
+            return Err(proof_error());
+        }
+        let mut bytes = Vec::new();
+        Read::by_ref(&mut file)
+            .take(MAX_PROOF + 1)
+            .read_to_end(&mut bytes)
+            .map_err(storage)?;
+        if bytes.is_empty() || bytes.len() as u64 > MAX_PROOF {
+            return Err(proof_error());
+        }
+        let digest = sha256::Hash::hash(&bytes).to_string();
+        let batch = record.batch_transfer_index.ok_or_else(proof_error)?;
+        let txn = self.database().begin_transaction()?;
+        let db_rows = txn.get_transfers_for_asset(batch, &request.asset_id)?;
+        if db_rows.len() != 1
+            || db_rows[0].consignment_hash.as_deref() != Some(digest.as_str())
+        {
+            return Err(proof_error());
+        }
+        txn.commit()?;
+        // The inspector reads an immutable private copy of the exact response bytes.
+        let mut checked = tempfile::NamedTempFile::new_in(root).map_err(storage)?;
+        checked.write_all(&bytes).map_err(storage)?;
+        inspect_bridge_proof(checked.path(), burn, &request.txid)?;
+        let mut response = record.response();
+        response["data"] = Value::String(STANDARD.encode(&bytes));
+        response["sha256"] = Value::String(digest);
+        Ok(response.to_string())
+    }
+}
+
+impl BridgeProofRequest {
+    fn accepted<'a>(&self, outbox: &'a Outbox) -> Result<Option<&'a Record>, Error> {
+        if !hex(&self.scope_key, 64) || !hex(&self.txid, 64) {
+            return Err(fail("RECOVERY_REQUEST_INVALID"));
+        }
+        let mut records = outbox.records.iter().filter(|r| {
+            r.kind == Kind::Burn
+                && r.phase == Phase::Accepted
+                && r.txid.as_deref() == Some(&self.txid)
+                && r.bridge_burn
+                    .as_ref()
+                    .is_some_and(|b| b.scope_key == self.scope_key && b.asset_id == self.asset_id)
+        });
+        let record = records.next();
+        if records.next().is_some() {
+            return Err(proof_error());
+        }
+        Ok(record)
+    }
+}
+
+pub(super) fn inspect_bridge_proof(
+    path: &Path,
+    burn: &BridgeBurnRequest,
+    txid: &str,
+) -> Result<(), Error> {
+    let meta = fs::symlink_metadata(path).map_err(|_| proof_error())?;
+    if !meta.is_file() || meta.nlink() != 1 || meta.len() == 0 || meta.len() > MAX_PROOF {
+        return Err(proof_error());
+    }
+    let inspection = crate::no_wallet::inspect_consignment(
+        path.to_str().ok_or_else(proof_error)?.into(),
+        crate::no_wallet::BundleFilter::Witness(txid.into()),
+    )
+    .map_err(|_| proof_error())?;
+    if !inspection.is_transfer
+        || inspection.asset_id != burn.asset_id
+        || inspection.asset_schema != AssetSchema::Bfa
+        || inspection.witnesses.len() != 1
+        || !burn_inspection_matches(&inspection.witnesses[0], burn, txid, false)
+    {
+        return Err(proof_error());
+    }
+    Ok(())
+}
+
+fn proof_error() -> Error {
+    fail("BRIDGE_PROOF_UNAVAILABLE")
+}
+
+pub(super) fn burn_inspection_matches(
+    inspection: &RgbInspection,
+    burn: &BridgeBurnRequest,
+    txid: &str,
+    wallet_plan: bool,
+) -> bool {
+    if inspection.txid != txid || inspection.operations.len() != 1 {
+        return false;
+    }
+    let op = &inspection.operations[0];
+    if op.asset_id != burn.asset_id
+        || (wallet_plan && op.committed_transition_count as usize != op.transitions.len())
+    {
+        return false;
+    }
+    // A partial BFA burn first splits the input into wallet change and the
+    // amount consumed by the burn. The same bundle may also preserve mint
+    // rights. Neither changes the bridge payout amount or destination.
+    let mut burns = op.transitions.iter().filter(|t| t.r#type == TypeOfTransition::Burn);
+    let Some(transition) = burns.next() else {
+        return false;
+    };
+    if burns.next().is_some()
+        || op.transitions.iter().any(|t| {
+            (!matches!(t.r#type, TypeOfTransition::Burn | TypeOfTransition::Transfer | TypeOfTransition::Propagate))
+                || (t.r#type != TypeOfTransition::Burn && !t.globals.is_empty())
+                || (wallet_plan && t.outputs.iter().any(|output| output.is_ours != Some(true)))
+        })
+    {
+        return false;
+    }
+    let mut reasons = transition.globals.iter().filter_map(|global| match global {
+        TransitionGlobal::BurnReason(reason) => Some(reason),
+        _ => None,
+    });
+    let mut amounts = transition.globals.iter().filter_map(|global| match global {
+        TransitionGlobal::BurnedAsset(amount) => Some(*amount),
+        _ => None,
+    });
+    transition.globals.len() == 2
+        && reasons.next() == Some(&burn.destination_commitment)
+        && reasons.next().is_none()
+        && amounts.next() == decimal(&burn.amount, true).ok()
+        && amounts.next().is_none()
+}
+
+pub(super) fn bridge_fee(psbt: &Psbt) -> Result<String, Error> {
+    let fee = psbt.fee().map_err(storage)?.to_sat();
+    if fee == 0 || fee > MAX_BRIDGE_FEE {
+        return Err(fail("BRIDGE_FEE_CAP_EXCEEDED"));
+    }
+    Ok(fee.to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn direct_arbitrum_commitment_matches_independent_go_ethereum_vector() {
+        // WDK's bridge-burn-destination-vectors.json uses go-ethereum accounts/abi.
+        let recipient = "0x1111111111111111111111111111111111111111";
+        assert_eq!(
+            direct_arbitrum_commitment(recipient).unwrap(),
+            "65101fb7d644f69b71360617954850e0c357789253eb373dde3f0d9077f2fbc7"
+        );
+        assert!(direct_arbitrum_commitment(&format!("0x{}", "0".repeat(40))).is_err());
+        assert!(direct_arbitrum_commitment(&format!("0x41{}", "1".repeat(40))).is_err());
+    }
+}
