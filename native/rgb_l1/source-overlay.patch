+        code(wallet.onchain_recovery_state(), "RECOVERY_STORAGE_INVALID");
+    }
+    #[test]
+    fn atomic_writer_faults_recover_exactly_the_old_or_new_authenticated_state() {
+        for point in 1..=4 {
+            let (_r, wallet, _) = setup();
+            let store = Store::open(&wallet, false).unwrap();
+            let mut outbox = store.read(&wallet).unwrap();
+            let e = command(&wallet, &"cc".repeat(16));
+            outbox.records.push(Record::new(e));
+            store.write(&outbox).unwrap();
+            let mut accepted = outbox.clone();
+            accepted.records[0].txid = Some("ee".repeat(32));
+            accepted.records[0].finish(true, None);
+            WRITE_FAULT.with(|f| f.set(Some(point)));
+            assert!(store.write(&accepted).is_err());
+            let restored = store.read(&wallet).unwrap();
+            assert_eq!(
+                restored.records[0].phase,
+                if point == 1 {
+                    Phase::Preparing
+                } else {
+                    Phase::Accepted
+                }
+            );
+            let digest = sha256::Hash::hash(&fs::read(current_file(&wallet)).unwrap()).to_string();
+            let txn = wallet.database().begin_transaction().unwrap();
+            assert_eq!(Store::anchor(&txn).unwrap().unwrap().2, digest);
+            txn.commit().unwrap();
+        }
+    }
+    #[test]
+    fn rollback_at_native_reservation_commit_repairs_one_write_ahead_cohort_only() {
+        let (_r, wallet, _) = setup();
+        let store = Store::open(&wallet, false).unwrap();
+        let mut outbox = store.read(&wallet).unwrap();
+        let e = command(&wallet, &"cc".repeat(16));
+        outbox.records.push(Record::new(e));
+        let txn = wallet.database().begin_transaction().unwrap();
+        store.write_in(&outbox, Some(&txn)).unwrap();
+        drop(txn);
+        let recovered = store.read(&wallet).unwrap();
+        assert_eq!(recovered.records.len(), 1);
+        assert_eq!(recovered.records[0].phase, Phase::Preparing);
+        assert!(!recovered.records[0].dispatch_started);
+    }
+    #[test]
+    fn terminal_receipts_retain_authorized_gross_amount_without_signed_psbt() {
+        let (_r, wallet, _) = setup();
+        let store = Store::open(&wallet, false).unwrap();
+        let mut outbox = store.read(&wallet).unwrap();
+        let e = command(&wallet, &"cc".repeat(16));
+        let mut r = Record::new(e);
+        r.txid = Some("ee".repeat(32));
+        r.finish(true, None);
+        outbox.records.push(r);
+        store.write(&outbox).unwrap();
+        drop(store);
+        let page: Value =
+            serde_json::from_str(&wallet.list_onchain_send_receipts(0, 1).unwrap()).unwrap();
+        assert_eq!(page["total"], 1);
+        assert_eq!(page["receipts"][0]["amount"], "1500");
+        assert_eq!(page["receipts"][0]["endAuthorized"], true);
+        assert!(page["revision"].is_string());
+        let saved = String::from_utf8(fs::read(current_file(&wallet)).unwrap()).unwrap();
+        assert!(!saved.contains("\"signedPsbt\":\""));
+        assert!(!saved.contains("\"command\":{\""));
+        code(
+            wallet.list_onchain_send_receipts(0, 0),
+            "RECOVERY_REQUEST_INVALID",
+        );
+        code(
+            wallet.list_onchain_send_receipts(0, 501),
+            "RECOVERY_REQUEST_INVALID",
+        );
+        assert!(
+            wallet
+                .list_onchain_send_receipts(u32::MAX, 1)
+                .unwrap()
+                .contains("\"receipts\":[]")
+        );
+    }
+    #[test]
+    fn native_pending_inventory_exports_only_exact_approved_command_and_fences_mutations() {
+        let (_r, wallet, _) = setup();
+        let store = Store::open(&wallet, false).unwrap();
+        let mut outbox = store.read(&wallet).unwrap();
+        let e = command(&wallet, &"cc".repeat(16));
+        let expected = serde_json::to_string(&e).unwrap();
+        outbox.records.push(Record::new(e));
+        store.write(&outbox).unwrap();
+        drop(store);
+        code(wallet.assert_no_pending_onchain_send(), "RECOVERY_PENDING");
+        let audit: Value = serde_json::from_str(&wallet.onchain_recovery_state().unwrap()).unwrap();
+        assert_eq!(audit["restoredSnapshot"], false);
+        assert_eq!(audit["pending"][0]["commandJson"], expected);
+        assert!(!audit.to_string().contains("signedPsbt"));
+    }
+    #[test]
+    fn imported_genesis_is_exact_idempotent_and_never_credits_a_balance() {
+        let (_r, mut wallet, _) = setup();
+        let encoded = include_str!("bfa7-regtest-contract.base64")
+            .trim()
+            .to_owned();
+        let asset = include_str!("bfa7-regtest-contract.id").trim().to_owned();
+        let first: Value = serde_json::from_str(
+            &wallet
+                .import_contract_base64(encoded.clone(), asset.clone())
+                .unwrap(),
+        )
+        .unwrap();
+        assert_eq!(first["assetId"], asset);
+        assert_eq!(first["alreadyImported"], false);
+        assert_eq!(first["metadata"]["assetSchema"], "Bfa");
+        let second: Value = serde_json::from_str(
+            &wallet
+                .import_contract_base64(encoded.clone(), asset.clone())
+                .unwrap(),
+        )
+        .unwrap();
+        assert_eq!(second["alreadyImported"], true);
+        let balance = wallet.get_asset_balance(asset.clone()).unwrap();
+        assert_eq!(
+            (balance.settled, balance.future, balance.spendable),
+            (0, 0, 0)
+        );
+        assert!(
+            wallet
+                .import_contract_base64(
+                    encoded,
+                    "rgb:A6k89KtR-e3oXqRP-uH3jUrz-LU_sYL3-hMZ0k3O-6u8DXbE".into()
+                )
+                .is_err()
+        );
+        assert_eq!(wallet.get_asset_balance(asset).unwrap().settled, 0);
+    }
+    include!("durable_revocation_tests.rs");
+    include!("durable_snapshot_tests.rs");
+}
