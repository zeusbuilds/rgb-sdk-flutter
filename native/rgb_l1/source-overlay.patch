+struct Identity {
+    version: u32,
+    wallet_binding: String,
+    cohort: String,
+    network: String,
+    witness_version: String,
+}
+impl Wallet {
+    fn recovery_binding(&self, network: &str) -> Result<String, Error> {
+        let compatible = match self.bitcoin_network() {
+            BitcoinNetwork::Mainnet => network == "mainnet",
+            BitcoinNetwork::Testnet => network == "testnet",
+            BitcoinNetwork::Testnet4 => network == "testnet4",
+            BitcoinNetwork::Signet => matches!(network, "signet" | "utexo"),
+            BitcoinNetwork::SignetCustom => false,
+            BitcoinNetwork::Regtest => network == "regtest",
+        };
+        if !compatible {
+            return Err(fail("RECOVERY_IDENTITY_MISMATCH"));
+        }
+        let witness = match self.keys.witness_version {
+            WitnessVersion::Taproot => "taproot",
+            WitnessVersion::SegWitV0 => "segwit-v0",
+        };
+        Ok(sha256::Hash::hash(
+            format!(
+                "{network}:{witness}:{}:{}",
+                self.keys.account_xpub_vanilla, self.keys.account_xpub_colored
+            )
+            .as_bytes(),
+        )
+        .to_string())
+    }
+    fn require_recovery_online_profile(&self, network: &str) -> Result<(), Error> {
+        validate_recovery_indexer_profile(
+            network,
+            &self
+                .online_data()
+                .as_ref()
+                .ok_or(Error::Offline)?
+                .indexer_config,
+        )
+    }
+    /// Bind the fresh outbox once; ordinary reopens must never recreate missing recovery data.
+    pub fn initialize_onchain_recovery(
+        &self,
+        raw: String,
+        allow_create: bool,
+    ) -> Result<String, Error> {
+        if raw.len() > 2000 {
+            return Err(fail("RECOVERY_REQUEST_INVALID"));
+        }
+        let id: Identity =
+            serde_json::from_str(&raw).map_err(|_| fail("RECOVERY_REQUEST_INVALID"))?;
+        let witness = match self.keys.witness_version {
+            WitnessVersion::Taproot => "taproot",
+            WitnessVersion::SegWitV0 => "segwit-v0",
+        };
+        if id.version != 1
+            || !hex(&id.cohort, 32)
+            || id.wallet_binding != self.recovery_binding(&id.network)?
+            || id.witness_version != witness
+        {
+            return Err(fail("RECOVERY_IDENTITY_MISMATCH"));
+        }
+        let store = Store::open(self, allow_create)?;
+        match fs::symlink_metadata(store.directory.join("outbox.json")) {
+            Ok(_) => {
+                let current = store.read(self)?;
+                if current.wallet_binding != id.wallet_binding
+                    || current.cohort != id.cohort
+                    || current.network != id.network
+                {
+                    return Err(fail("RECOVERY_IDENTITY_MISMATCH"));
+                }
+            }
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound && allow_create => {
+                let outbox = Outbox {
+                    version: 1,
+                    wallet_binding: id.wallet_binding.clone(),
+                    cohort: id.cohort.clone(),
+                    network: id.network,
+                    source_revision: SOURCE.into(),
+                    overlay: OVERLAY.into(),
+                    records: vec![],
+                    restored_snapshot: false,
+                    revision: 1,
+                    previous_digest: String::new(),
+                    authentication: String::new(),
+                };
+                store.initialize(&outbox)?;
+            }
+            Err(e) => return Err(storage(e)),
+        }
+        Ok(json!({"walletBinding":id.wallet_binding,"cohort":id.cohort}).to_string())
+    }
+    /// Audit pending records without opening, submitting, or replaying a payment.
+    pub fn onchain_recovery_state(&self) -> Result<String, Error> {
+        let store = Store::open(self, false)?;
+        let outbox = store.read(self)?;
+        let mut pending = Vec::new();
+        for record in outbox.records.iter().filter(|r| !r.terminal()) {
+            let command = record
+                .command
+                .as_ref()
+                .ok_or_else(|| storage("missing command"))?;
+            let mut value = record.response();
+            value["commandJson"] = Value::String(serde_json::to_string(command).map_err(storage)?);
+            pending.push(value);
+        }
+        Ok(json!({"version":1,"walletBinding":outbox.wallet_binding,"cohort":outbox.cohort,"restoredSnapshot":outbox.restored_snapshot,"pending":pending,"retainedReceipts":outbox.records.iter().filter(|r|r.terminal()).count()}).to_string())
+    }
+    /// Paginated, authenticated submission receipts. These do not imply confirmations.
+    pub fn list_onchain_send_receipts(&self, offset: u32, limit: u16) -> Result<String, Error> {
+        if limit == 0 || limit > 500 {
+            return Err(fail("RECOVERY_REQUEST_INVALID"));
+        }
+        let store = Store::open(self, false)?;
+        let outbox = store.read(self)?;
+        let accepted: Vec<_> = outbox
+            .records
+            .iter()
+            .rev()
+            .filter(|r| r.phase == Phase::Accepted)
+            .collect();
+        let receipts = accepted
+            .iter()
+            .skip(offset as usize)
+            .take(limit as usize)
+            .map(|r| {
+                let mut value = r.response();
+                value["amount"] = Value::String(r.amount.clone());
+                value["feeRate"] = Value::String(r.fee_rate.clone());
+                value["assetId"] = r.asset_id.clone().map(Value::String).unwrap_or(Value::Null);
+                value["address"] = r.address.clone().map(Value::String).unwrap_or(Value::Null);
+                value["recipientId"] = r
+                    .recipient_id
+                    .clone()
+                    .map(Value::String)
+                    .unwrap_or(Value::Null);
+                value
+            })
+            .collect::<Vec<_>>();
+        Ok(json!({"version":1,"walletBinding":outbox.wallet_binding,"cohort":outbox.cohort,"revision":outbox.revision.to_string(),"restoredSnapshot":outbox.restored_snapshot,"total":accepted.len(),"receipts":receipts}).to_string())
+    }
+    /// Ordinary mutations cannot overtake an uncertain authorized payment.
+    pub fn assert_no_pending_onchain_send(&self) -> Result<(), Error> {
+        let store = Store::open(self, false)?;
+        let outbox = store.read(self)?;
+        if outbox.restored_snapshot {
+            return Err(fail("RECOVERY_RESTORE_UNCERTAIN"));
+        }
+        if outbox.records.iter().any(|r| !r.terminal()) {
+            return Err(fail("RECOVERY_PENDING"));
+        }
+        Ok(())
+    }
+    /// Validate and import genesis-only public metadata; never credits allocations.
+    pub fn import_contract_base64(
+        &mut self,
+        encoded: String,
+        expected: String,
+    ) -> Result<String, Error> {
+        use base64::{Engine, engine::general_purpose::STANDARD};
+        self.assert_no_pending_onchain_send()?;
+        if encoded.is_empty() || encoded.len() > 16 * 1024 * 1024 {
+            return Err(fail("RECOVERY_REQUEST_INVALID"));
+        }
+        let bytes = STANDARD
+            .decode(&encoded)
+            .map_err(|_| fail("RECOVERY_REQUEST_INVALID"))?;
+        if bytes.is_empty() || STANDARD.encode(&bytes) != encoded {
+            return Err(fail("RECOVERY_REQUEST_INVALID"));
+        }
+        ContractId::from_str(&expected).map_err(|_| fail("RECOVERY_REQUEST_INVALID"))?;
+        let known = match self.get_asset_metadata(expected.clone()) {
+            Ok(_) => true,
+            Err(Error::AssetNotFound { .. }) => false,
+            Err(e) => return Err(e),
+        };
+        let mut file = tempfile::NamedTempFile::new_in(self.get_wallet_dir()).map_err(storage)?;
+        file.write_all(&bytes).map_err(storage)?;
+        file.as_file().sync_all().map_err(storage)?;
+        let asset = self.import_contract(
+            file.path().to_str().ok_or_else(|| storage("path"))?.into(),
+            Some(expected.clone()),
+        )?;
+        let metadata = self.get_asset_metadata(asset.clone())?;
+        // Explicit decimal strings avoid bridge floating-point conversion of u64 supplies.
+        Ok(json!({"assetId":asset,"alreadyImported":known,"metadata":{"assetSchema":format!("{:?}",metadata.asset_schema),"name":metadata.name,"ticker":metadata.ticker,"details":metadata.details,"precision":metadata.precision,"initialSupply":metadata.initial_supply.to_string(),"maxSupply":metadata.max_supply.to_string(),"knownCirculatingSupply":metadata.known_circulating_supply.to_string()}}).to_string())
+    }
+    fn validate_durable_plan(&self, record: &Record) -> Result<(), Error> {
+        let e = record
+            .command
+            .as_ref()
+            .ok_or_else(|| storage("missing approval"))?;
+        let r = &e.request;
+        let raw = record
+            .unsigned_psbt
+            .as_ref()
+            .ok_or_else(|| storage("missing plan"))?;
+        let psbt = Psbt::from_str(raw).map_err(storage)?;
+        if psbt.unsigned_tx.input.is_empty() || psbt.unsigned_tx.output.is_empty() {
+            return Err(storage("empty plan"));
+        }
+        let mut expected_external = None;
+        match r.kind {
+            Kind::Bitcoin => {
+                let script = self.get_script_pubkey(r.address.as_deref().unwrap())?;
+                let amount = decimal(&r.amount, true)?;
+                let count = psbt
+                    .unsigned_tx
+                    .output
+                    .iter()
+                    .filter(|o| o.script_pubkey == script && o.value.to_sat() == amount)
+                    .count();
+                if count != 1 {
+                    return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+                }
+                expected_external = Some((script, amount));
+            }
+            Kind::Rgb => {
+                let (_, _, info, _) = self.get_transfer_end_data(&psbt)?;
+                let asset = r.asset_id.as_ref().unwrap();
+                if info.donation
+                    || info.min_confirmations != r.min_confirmations
+                    || info.sender_transport_endpoint != r.sender_transport_endpoint
+                    || info.transfers.len() != 1
+                    || info.expiration_timestamp
+                        != Some(
+                            decimal(r.expiration_timestamp.as_deref().unwrap(), true)? as i64 - 600,
+                        )
+                {
+                    return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+                }
+                let transfer = info
+                    .transfers
+                    .get(asset)
+                    .ok_or_else(|| fail("RECOVERY_REQUEST_MISMATCH"))?;
+                if !matches!(transfer.main_transition, MainTransition::Transfer)
+                    || transfer.asset_info.contract_id.to_string() != *asset
+                    || transfer.recipients.len() != 1
+                {
+                    return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+                }
+                let recipient = &transfer.recipients[0];
+                let endpoints = recipient
+                    .transport_endpoints
+                    .iter()
+                    .map(|e| e.endpoint.clone())
+                    .collect::<Vec<_>>();
+                let expected_endpoints = r
+                    .transport_endpoints
+                    .iter()
+                    .map(|e| self.convert_transport_endpoint_url(e))
+                    .collect::<Result<Vec<_>, _>>()?;
+                if recipient.recipient_id.as_str() != r.recipient_id.as_deref().unwrap()
+                    || recipient.assignment != Assignment::Fungible(decimal(&r.amount, true)?)
+                    || hex::encode(&recipient.public_key)
+                        != r.invoice_public_key.as_deref().unwrap()
+                    || format!("{:?}", recipient.encryption)
+                        != r.invoice_encryption.as_deref().unwrap()
+                    || recipient.invoice_expiration
+                        != Some(decimal(r.expiration_timestamp.as_deref().unwrap(), true)? as i64)
+                    || endpoints != expected_endpoints
+                {
+                    return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+                }
+                match (&recipient.local_recipient_data, &r.witness_amount_sat) {
+                    (LocalRecipientData::Blind(_), None) => {}
+                    (LocalRecipientData::Witness(w), Some(amount)) => {
+                        if w.amount_sat != decimal(amount, true)? {
+                            return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+                        }
+                        validate_proxy_witness_blinding(
+                            r.witness_blinding.as_deref(),
+                            w.blinding,
+                            info.operation_secret_key.as_deref(),
+                            &recipient.public_key,
+                        )?;
+                        let script = script_buf_from_recipient_id(recipient.recipient_id.clone())?
+                            .ok_or_else(|| fail("RECOVERY_REQUEST_MISMATCH"))?;
+                        let output = psbt
+                            .unsigned_tx
+                            .output
+                            .get(w.vout as usize)
+                            .ok_or_else(|| fail("RECOVERY_REQUEST_MISMATCH"))?;
+                        if output.script_pubkey != script || output.value.to_sat() != w.amount_sat {
+                            return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+                        }
+                        expected_external = Some((script, w.amount_sat));
+                    }
+                    _ => return Err(fail("RECOVERY_REQUEST_MISMATCH")),
+                }
+            }
+        }
+        let mut external_count = 0;
+        for output in &psbt.unsigned_tx.output {
+            if expected_external
+                .as_ref()
+                .is_some_and(|(s, n)| &output.script_pubkey == s && output.value.to_sat() == *n)
+            {
+                external_count += 1;
+                continue;
+            }
+            if output.script_pubkey.is_op_return() && r.kind == Kind::Rgb {
+                continue;
+            }
+            if !self.bdk_wallet().is_mine(output.script_pubkey.clone()) {
+                return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+            }
+        }
+        if expected_external.is_some() && external_count != 1 {
+            return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+        }
+        Ok(())
+    }
+    fn reconcile_record(&self, r: &mut Record) -> Result<bool, Error> {
+        if r.phase == Phase::Accepted {
+            return Ok(true);
+        }
+        if r.phase != Phase::Committing {
+            return Ok(false);
+        }
+        let txid = r.txid.as_deref().ok_or_else(|| storage("missing txid"))?;
+        let txn = self.database().begin_transaction()?;
+        let accepted = match r.kind {
+            Kind::Bitcoin => {
+                txn.get_wallet_transaction_with_reserved_txos_by_txid(txid)?
+                    .is_none_or(|(_, rows)| rows.is_empty())
+                    && self
+                        .bdk_wallet()
+                        .transactions()
+                        .any(|t| t.tx_node.txid.to_string() == txid)
+            }
+            Kind::Rgb => {
+                let rows = txn.get_batch_transfers_by_txid(txid)?;
+                let rows: Vec<_> = rows
+                    .into_iter()
+                    .filter(|t| {
+                        !t.incoming
+                            && Some(t.idx) == r.batch_transfer_index
+                            && !matches!(
+                                t.status,
+                                TransferStatus::Initiated | TransferStatus::Failed
+                            )
+                    })
+                    .collect();
+                rows.len() == 1
+            }
+        };
+        txn.commit()?;
+        if accepted {
+            r.finish(true, None);
+        }
+        Ok(accepted)
+    }
+    /// Read-only outcome recovery. Never calls Begin or End, including after a lost reply.
+    pub fn onchain_send_status(
+        &mut self,
+        online: Option<Online>,
+        raw: String,
+    ) -> Result<String, Error> {
+        let e = Envelope::parse(&raw)?;
+        let store = Store::open(self, false)?;
+        let mut outbox = store.read(self)?;
+        let Some(i) = outbox.index(&e)? else {
+            if outbox.restored_snapshot {
+                return Err(fail("RECOVERY_RESTORE_UNCERTAIN"));
+            }
+            return Ok(json!({"version":1,"operationId":e.request.operation_id,"fingerprint":null,"kind":null,"phase":"absent","txid":null,"batchTransferIndex":null,"failureCode":null,"endAuthorized":false}).to_string());
+        };
+        if outbox.records[i].unsigned_psbt.is_some() {
+            self.validate_durable_plan(&outbox.records[i])?;
+        }
+        let was_accepted = outbox.records[i].phase == Phase::Accepted;
+        let mut accepted = self.reconcile_record(&mut outbox.records[i])?;
+        if outbox.restored_snapshot && !accepted && outbox.records[i].signed_psbt.is_some() {
+            if let Some(online) = online {
+                self.require_recovery_online_profile(&outbox.network)?;
+                let record = &outbox.records[i];
+                let asset = record
+                    .command
+                    .as_ref()
+                    .and_then(|e| e.request.asset_id.as_deref());
+                if self.recover_submitted_onchain(
+                    online,
+                    record.signed_psbt.as_deref().unwrap(),
+                    asset,
+                    record.batch_transfer_index,
+                )? {
+                    outbox.records[i].finish(true, None);
+                    accepted = true;
+                }
+            }
+        }
+        if !accepted && outbox.records[i].phase == Phase::Committing {
+            if !outbox.restored_snapshot && !outbox.records[i].dispatch_started {
+                // End's callback is durable before its first mutating RPC. With the native
+                // session serialized, an absent callback proves no submission was dispatched.
+                outbox.records[i].phase = Phase::Prepared;
+                outbox.records[i].failure_code = Some("submission_not_started".into());
+                store.write(&outbox)?;
+            } else if let Some(online) = online {
+                self.require_recovery_online_profile(&outbox.network)?;
+                let record = &outbox.records[i];
+                let asset = record
+                    .command
+                    .as_ref()
+                    .and_then(|e| e.request.asset_id.as_deref());
+                if self.recover_submitted_onchain(
+                    online,
+                    record
+                        .signed_psbt
+                        .as_deref()
+                        .ok_or_else(|| storage("signed plan"))?,
+                    asset,
+                    record.batch_transfer_index,
+                )? {
+                    outbox.records[i].finish(true, None);
+                    accepted = true;
+                }
+            }
+        }
+        if accepted && !was_accepted {
+            store.write(&outbox)?;
+        }
+        if outbox.restored_snapshot && !outbox.records[i].terminal() {
+            return Err(fail("RECOVERY_RESTORE_UNCERTAIN"));
+        }
+        Ok(outbox.records[i].response().to_string())
+    }
+    /// Prepare exactly one durable transaction, before any commit authorization exists.
+    pub fn prepare_onchain_send(&mut self, online: Online, raw: String) -> Result<String, Error> {
+        self.check_xprv()?;
+        let e = Envelope::parse(&raw)?;
+        let store = Store::open(self, false)?;
+        let mut outbox = store.read(self)?;
+        if outbox.restored_snapshot {
+            return Err(fail("RECOVERY_RESTORE_UNCERTAIN"));
+        }
+        if let Some(i) = outbox.index(&e)? {
+            if outbox.records[i].phase != Phase::Preparing || outbox.records[i].cancel_requested {
+                return Ok(outbox.records[i].response().to_string());
+            }
+        }
+        self.require_recovery_online_profile(&outbox.network)?;
+        let i = match outbox.index(&e)? {
+            Some(i) => {
+                if outbox.records[i].phase != Phase::Preparing || outbox.records[i].cancel_requested
+                {
+                    return Ok(outbox.records[i].response().to_string());
+                }
+                i
+            }
+            None => {
+                if outbox.records.len() >= MAX_RECORDS {
+                    return Err(fail("RECOVERY_CAPACITY"));
+                }
+                if outbox.records.iter().any(|r| !r.terminal()) {
+                    return Err(fail("RECOVERY_PENDING"));
+                }
+                outbox.records.push(Record::new(e.clone()));
+                let i = outbox.records.len() - 1;
+                store.write(&outbox)?;
+                i
+            }
+        };
+        let request = e.request.clone();
+        if outbox.records[i].unsigned_psbt.is_none() {
+            let amount = decimal(&request.amount, true)?;
+            let fee = decimal(&request.fee_rate, true)?;
+            let prepared = match request.kind {
+                Kind::Bitcoin => self
+                    .send_btc_begin_with_durable_callback(
+                        online,
+                        request.address.clone().unwrap(),
+                        amount,
+                        fee,
+                        false,
+                        false,
+                        |psbt, txn| persist_plan(&store, &mut outbox, i, psbt, None, txn),
+                    )
+                    .map(|_| ()),
+                Kind::Rgb => {
+                    let expiration =
+                        decimal(request.expiration_timestamp.as_deref().unwrap(), true)?;
+                    let now =
+                        std::cmp::max(time::OffsetDateTime::now_utc().unix_timestamp(), 0) as u64;
+                    if expiration > i64::MAX as u64 || expiration <= now.saturating_add(900) {
+                        outbox.records[i].finish(false, Some("invoice_expired"));
+                        store.write(&outbox)?;
+                        return Ok(outbox.records[i].response().to_string());
+                    }
+                    let recipient = Recipient {
+                        recipient_id: request.recipient_id.clone().unwrap(),
+                        witness_data: request
+                            .witness_amount_sat
+                            .as_ref()
+                            .map(|n| {
+                                Ok::<_, Error>(WitnessData {
+                                    amount_sat: decimal(n, true)?,
+                                    blinding: request
+                                        .witness_blinding
+                                        .as_ref()
+                                        .map(|n| decimal(n, false))
+                                        .transpose()?,
+                                })
+                            })
+                            .transpose()?,
+                        assignment: Assignment::Fungible(amount),
+                        transport_endpoints: request.transport_endpoints.clone(),
+                        public_key: request.invoice_public_key.clone(),
+                        encryption: match request.invoice_encryption.as_deref().unwrap() {
+                            "Required" => Encryption::Required,
+                            "Optional" => Encryption::Optional,
+                            _ => Encryption::Unsupported,
+                        },
+                        expiration_timestamp: Some(expiration),
+                    };
+                    let map = HashMap::from([(request.asset_id.clone().unwrap(), vec![recipient])]);
+                    self.send_begin_with_durable_callback(
+                        online,
+                        map,
+                        false,
+                        fee,
+                        request.min_confirmations,
+                        expiration - 600,
+                        request.sender_transport_endpoint.clone(),
+                        false,
+                        |result, txn| {
+                            sync_tree(
+                                Path::new(&result.details.fascia_path)
+                                    .parent()
+                                    .ok_or_else(|| storage("transfer path"))?,
+                                0,
+                            )?;
+                            persist_plan(
+                                &store,
+                                &mut outbox,
+                                i,
+                                &result.psbt,
+                                result.batch_transfer_idx,
+                                txn,
+                            )
+                        },
+                    )
+                    .map(|_| ())
+                }
+            };
+            if let Err(error) = prepared {
+                let r = &mut outbox.records[i];
+                if r.unsigned_psbt.is_none() {
+                    r.finish(false, Some(prepare_error(&error)));
+                } else {
+                    r.failure_code = Some("native_prepare_interrupted".into());
+                }
+                store.write(&outbox)?;
+                return Ok(outbox.records[i].response().to_string());
+            }
+        }
+        let unsigned = outbox.records[i]
+            .unsigned_psbt
+            .clone()
+            .ok_or_else(|| storage("plan"))?;
+        self.validate_durable_plan(&outbox.records[i])?;
+        match self.sign_psbt(unsigned.clone(), None) {
+            Ok(signed) => {
+                let a = Psbt::from_str(&unsigned).map_err(storage)?;
+                let b = Psbt::from_str(&signed).map_err(storage)?;
+                if a.unsigned_tx != b.unsigned_tx {
+                    return Err(storage("signer changed plan"));
+                }
+                outbox.records[i].signed_psbt = Some(signed);
+                outbox.records[i].phase = Phase::Prepared;
+                outbox.records[i].failure_code = None;
+            }
+            Err(_) => {
+                outbox.records[i].failure_code = Some("native_sign_failed".into());
+            }
+        }
+        store.write(&outbox)?;
+        Ok(outbox.records[i].response().to_string())
+    }
+    /// Authorize End once and persist its exact identity before any external submission.
+    pub fn commit_onchain_send(&mut self, online: Online, raw: String) -> Result<String, Error> {
+        self.check_xprv()?;
+        let e = Envelope::parse(&raw)?;
+        let store = Store::open(self, false)?;
+        let mut outbox = store.read(self)?;
+        if outbox.restored_snapshot {
+            return Err(fail("RECOVERY_RESTORE_UNCERTAIN"));
+        }
+        let i = outbox
+            .index(&e)?
+            .ok_or_else(|| fail("RECOVERY_REQUEST_MISMATCH"))?;
+        if outbox.records[i].phase != Phase::Prepared {
+            if self.reconcile_record(&mut outbox.records[i])? {
+                store.write(&outbox)?;
+            }
+            return Ok(outbox.records[i].response().to_string());
+        }
+        self.require_recovery_online_profile(&outbox.network)?;
+        self.validate_durable_plan(&outbox.records[i])?;
+        if let Some(expiration) = outbox.records[i]
+            .command
+            .as_ref()
+            .and_then(|c| c.request.expiration_timestamp.as_ref())
+        {
+            let now = std::cmp::max(time::OffsetDateTime::now_utc().unix_timestamp(), 0) as u64;
+            if decimal(expiration, true)? <= now.saturating_add(900) {
+                outbox.records[i].failure_code = Some("invoice_expired".into());
+                store.write(&outbox)?;
+                return Ok(outbox.records[i].response().to_string());
+            }
+        }
+        outbox.records[i].phase = Phase::Committing;
+        store.write(&outbox)?;
+        let signed = outbox.records[i]
+            .signed_psbt
+            .clone()
+            .ok_or_else(|| storage("signed plan"))?;
+        self.check_online(online)?;
+        let psbt = Psbt::from_str(&signed).map_err(storage)?;
+        let result = (|| {
+            let txn = self.database().begin_transaction()?;
+            let kind = outbox.records[i].kind;
+            let mut before_submit = |txn: &DbTxn| {
+                outbox.records[i].dispatch_started = true;
+                store.write_in(&outbox, Some(txn))
+            };
+            let result = match kind {
+                Kind::Bitcoin => self
+                    .send_btc_end_impl_with_durable_callback(&txn, &psbt, &mut before_submit)
+                    .map(|id| (id, None)),
+                Kind::Rgb => self
+                    .send_end_impl_with_durable_callback(&txn, &psbt, &mut before_submit)
+                    .map(|r| (r.txid, Some(r.batch_transfer_idx))),
+            }?;
+            self.update_backup_info(&txn, false)?;
+            self.persist_and_commit(txn)?;
+            Ok::<_, Error>(result)
+        })();
+        match result {
+            Ok((id, batch)) => {
+                if Some(id) != outbox.records[i].txid
+                    || (outbox.records[i].kind == Kind::Rgb
+                        && batch != outbox.records[i].batch_transfer_index)
+                {
+                    return Err(storage("accepted plan mismatch"));
+                }
+                outbox.records[i].finish(true, None);
+                store.write(&outbox)?;
+            }
+            Err(_) => {
+                outbox = store.read(self)?;
+                if self.reconcile_record(&mut outbox.records[i])? {
+                    store.write(&outbox)?;
+                } else if !outbox.records[i].dispatch_started {
+                    outbox.records[i].phase = Phase::Prepared;
+                    outbox.records[i].failure_code = Some("submission_not_started".into());
+                    store.write(&outbox)?;
+                } else {
+                    outbox.records[i].failure_code = Some("native_commit_interrupted".into());
+                    store.write(&outbox)?;
+                }
+            }
+        }
+        Ok(outbox.records[i].response().to_string())
+    }
+    /// Revoke only an operation that has never authorized End. A tombstone survives delayed calls.
+    pub fn cancel_onchain_send(
+        &mut self,
+        _online: Option<Online>,
+        raw: String,
+    ) -> Result<String, Error> {
+        let e = Envelope::parse(&raw)?;
+        let store = Store::open(self, false)?;
+        let mut outbox = store.read(self)?;
+        if outbox.restored_snapshot {
+            return Err(fail("RECOVERY_RESTORE_UNCERTAIN"));
+        }
+        let i = match outbox.index(&e)? {
+            Some(i) => i,
+            None => {
+                if outbox.records.len() >= MAX_RECORDS {
+                    return Err(fail("RECOVERY_CAPACITY"));
+                }
+                let mut r = Record::new(e);
+                r.cancel_requested = true;
+                r.finish(false, Some("cancelled"));
+                outbox.records.push(r);
+                store.write(&outbox)?;
+                return Ok(outbox.records.last().unwrap().response().to_string());
+            }
+        };
+        if outbox.records[i].phase == Phase::Committing && !outbox.records[i].dispatch_started {
+            outbox.records[i].phase = Phase::Prepared;
+        }
+        if matches!(
+            outbox.records[i].phase,
+            Phase::Committing | Phase::Accepted | Phase::Rejected
+        ) {
+            if self.reconcile_record(&mut outbox.records[i])? {
+                store.write(&outbox)?;
+            }
+            return Ok(outbox.records[i].response().to_string());
+        }
+        outbox.records[i].cancel_requested = true;
+        outbox.records[i].phase = Phase::Preparing;
+        outbox.records[i].signed_psbt = None;
+        store.write(&outbox)?;
+        let r = &outbox.records[i];
+        if let Some(txid) = &r.txid {
+            match r.kind {
+                Kind::Bitcoin => {
+                    if self
+                        .list_pending_vanilla_txs()?
+                        .iter()
+                        .any(|r| &r.txid == txid)
+                    {
+                        self.abort_pending_vanilla_tx(txid.clone())?;
+                    }
+                }
+                Kind::Rgb => {
+                    // No End was authorized, so this exact Initiated reservation can be failed
+                    // locally. Never revoke a different batch or a progressed transfer.
+                    let txn = self.database().begin_transaction()?;
+                    let rows = txn.get_batch_transfers_by_txid(txid)?;
+                    if rows.iter().any(|b| {
+                        Some(b.idx) != r.batch_transfer_index
+                            || b.incoming
+                            || !matches!(
+                                b.status,
+                                TransferStatus::Initiated | TransferStatus::Failed
+                            )
+                    }) {
+                        return Err(fail("RECOVERY_PENDING"));
+                    }
+                    for batch in rows {
+                        if batch.status == TransferStatus::Initiated {
+                            txn.del_reserved_txos_for_batch_transfer(batch.idx)?;
+                            let mut active: DbBatchTransferActMod = batch.into();
+                            active.status = ActiveValue::Set(TransferStatus::Failed);
+                            txn.update_batch_transfer(&mut active)?;
+                        }
+                    }
+                    self.update_backup_info(&txn, false)?;
+                    txn.commit()?;
+                }
+            }
+        }
+        outbox.records[i].finish(false, Some("cancelled"));
+        store.write(&outbox)?;
+        Ok(outbox.records[i].response().to_string())
+    }
+}
+fn persist_plan(
+    store: &Store,
+    outbox: &mut Outbox,
+    i: usize,
+    raw: &str,
+    batch: Option<i32>,
+    txn: &DbTxn,
+) -> Result<(), Error> {
+    let psbt = Psbt::from_str(raw).map_err(storage)?;
+    let r = &mut outbox.records[i];
+    if (r.kind == Kind::Bitcoin) != batch.is_none() || batch.is_some_and(|n| n <= 0) {
+        return Err(storage("batch"));
+    }
+    if let Some(old) = &r.unsigned_psbt {
+        if old != raw {
+            return Err(storage("replacement plan"));
+        }
+    }
+    r.txid = Some(psbt.unsigned_tx.compute_txid().to_string());
+    r.batch_transfer_index = batch;
+    r.unsigned_psbt = Some(raw.into());
+    store.write_in(outbox, Some(txn))
+}
+fn sync_tree(dir: &Path, depth: u8) -> Result<(), Error> {
+    if depth > 16 {
+        return Err(storage("tree depth"));
+    }
+    for entry in fs::read_dir(dir).map_err(storage)? {
+        let entry = entry.map_err(storage)?;
+        let kind = entry.file_type().map_err(storage)?;
+        if kind.is_dir() {
+            sync_tree(&entry.path(), depth + 1)?;
+        } else if kind.is_file() {
+            File::open(entry.path())
+                .and_then(|f| f.sync_all())
+                .map_err(storage)?;
+        } else {
+            return Err(storage("transfer file"));
+        }
+    }
+    File::open(dir).and_then(|f| f.sync_all()).map_err(storage)
+}
+fn prepare_error(error: &Error) -> &'static str {
+    match error {
+        Error::InsufficientBitcoins { .. } => "insufficient_bitcoins",
+        Error::InsufficientAssignments { .. } => "insufficient_asset_balance",
+        Error::InsufficientAllocationSlots => "insufficient_allocations",
+        Error::InvalidFeeRate { .. }
+        | Error::MaxFeeExceeded { .. }
+        | Error::MinFeeNotMet { .. } => "invalid_fee",
+        Error::InvalidAddress { .. }
+        | Error::InvalidRecipientData { .. }
+        | Error::InvalidRecipientID
+        | Error::InvalidRecipientNetwork
+        | Error::InvalidInvoice { .. } => "invalid_recipient",
+        _ => "preparation_failed",
+    }
+}
