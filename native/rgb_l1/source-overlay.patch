+struct Store {
+    directory: PathBuf,
+    _lock: File,
+    database: Arc<RgbLibDatabase>,
+    key: Zeroizing<[u8; 32]>,
+}
+impl Store {
+    fn open(wallet: &Wallet, create: bool) -> Result<Self, Error> {
+        let directory = wallet.get_wallet_dir().join(DIRECTORY);
+        if create {
+            match fs::DirBuilder::new().mode(0o700).create(&directory) {
+                Ok(()) => File::open(wallet.get_wallet_dir())
+                    .and_then(|f| f.sync_all())
+                    .map_err(storage)?,
+                Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {}
+                Err(e) => return Err(storage(e)),
+            }
+        }
+        let meta = fs::symlink_metadata(&directory).map_err(storage)?;
+        if !meta.is_dir()
+            || meta.permissions().mode() & 0o777 != 0o700
+            || meta.uid() != unsafe { libc::geteuid() }
+            || directory.canonicalize().map_err(storage)? != directory
+        {
+            return Err(storage("directory"));
+        }
+        let mut options = OpenOptions::new();
+        options
+            .read(true)
+            .write(true)
+            .create(true)
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC);
+        let lock = options.open(directory.join(".lock")).map_err(storage)?;
+        Self::file(&lock, 0)?;
+        lock_outbox_descriptor(lock.as_raw_fd())?;
+        let mut material = Zeroizing::new(b"flutter-rgb-l1-outbox-key-v1:".to_vec());
+        if let Some(secret) = &wallet.keys.mnemonic {
+            material.extend_from_slice(secret.as_bytes());
+        } else {
+            material.extend_from_slice(b"watch-only:");
+            material.extend_from_slice(wallet.keys.account_xpub_vanilla.as_bytes());
+        }
+        let key = Zeroizing::new(sha256::Hash::hash(&material).to_byte_array());
+        Ok(Self {
+            directory,
+            _lock: lock,
+            database: Arc::clone(&wallet.internals.database),
+            key,
+        })
+    }
+    fn file(file: &File, max: u64) -> Result<(), Error> {
+        let m = file.metadata().map_err(storage)?;
+        if !m.is_file()
+            || m.permissions().mode() & 0o777 != 0o600
+            || m.uid() != unsafe { libc::geteuid() }
+            || m.nlink() != 1
+            || m.len() > max
+        {
+            return Err(storage("file"));
+        }
+        Ok(())
+    }
+    fn bytes(&self) -> Result<Vec<u8>, Error> {
+        let file = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(self.directory.join("outbox.json"))
+            .map_err(storage)?;
+        Self::file(&file, MAX_BYTES)?;
+        let mut bytes = Vec::new();
+        file.take(MAX_BYTES + 1)
+            .read_to_end(&mut bytes)
+            .map_err(storage)?;
+        if bytes.len() as u64 > MAX_BYTES {
+            return Err(storage("size"));
+        }
+        Ok(bytes)
+    }
+    fn authenticate(&self, outbox: &Outbox) -> Result<(), Error> {
+        let mut data = outbox.clone();
+        let expected = std::mem::take(&mut data.authentication);
+        let tag = hex::decode(expected).map_err(storage)?;
+        let mut mac = <SimpleHmac<Sha256> as hmac::digest::KeyInit>::new_from_slice(&*self.key)
+            .map_err(storage)?;
+        mac.update(&serde_json::to_vec(&data).map_err(storage)?);
+        mac.verify_slice(&tag).map_err(storage)
+    }
+    fn anchor(txn: &DbTxn) -> Result<Option<(String, String, String)>, Error> {
+        let row = block_on(txn.inner().query_one_raw(Statement::from_string(
+            DbBackend::Sqlite,
+            "SELECT cohort, binding, digest FROM flutter_onchain_anchor WHERE id = 1".to_owned(),
+        )))
+        .map_err(storage)?;
+        row.map(|r| {
+            Ok((
+                r.try_get("", "cohort").map_err(storage)?,
+                r.try_get("", "binding").map_err(storage)?,
+                r.try_get("", "digest").map_err(storage)?,
+            ))
+        })
+        .transpose()
+    }
+    fn put_anchor(txn: &DbTxn, cohort: &str, binding: &str, digest: &str) -> Result<(), Error> {
+        block_on(txn.inner().execute_raw(Statement::from_sql_and_values(DbBackend::Sqlite,"INSERT INTO flutter_onchain_anchor (id,cohort,binding,digest) VALUES (1,?,?,?) ON CONFLICT(id) DO UPDATE SET cohort=excluded.cohort,binding=excluded.binding,digest=excluded.digest",vec![cohort.to_owned().into(),binding.to_owned().into(),digest.to_owned().into()]))).map_err(storage)?;
+        Ok(())
+    }
+    fn check_anchor(
+        &self,
+        outbox: &Outbox,
+        digest: &str,
+        repair: bool,
+        txn: &DbTxn,
+    ) -> Result<(), Error> {
+        let (cohort, binding, anchor) =
+            Self::anchor(txn)?.ok_or_else(|| storage("missing database cohort"))?;
+        if cohort != outbox.cohort || binding != outbox.wallet_binding {
+            return Err(fail("RECOVERY_IDENTITY_MISMATCH"));
+        }
+        if anchor == digest {
+            return Ok(());
+        }
+        // Exactly one write-ahead file can survive an interrupted SQLite commit. A stale
+        // outbox, foreign cohort, selective rollback, or a larger gap is never reinitialized.
+        if repair && !anchor.is_empty() && anchor == outbox.previous_digest {
+            Self::put_anchor(txn, &cohort, &binding, digest)?;
+            return Ok(());
+        }
+        Err(storage("database/outbox continuity"))
+    }
+    fn read(&self, wallet: &Wallet) -> Result<Outbox, Error> {
+        let bytes = self.bytes()?;
+        let mut outbox: Outbox = serde_json::from_slice(&bytes).map_err(storage)?;
+        self.authenticate(&outbox)?;
+        outbox.validate(wallet)?;
+        let digest = sha256::Hash::hash(&bytes).to_string();
+        let txn = self.database.begin_transaction()?;
+        self.check_anchor(&outbox, &digest, true, &txn)?;
+        txn.commit()?;
+        let stamp = wallet.get_wallet_dir().join(".flutter-restored-snapshot");
+        match fs::symlink_metadata(&stamp) {
+            Ok(_) => {
+                let file = OpenOptions::new()
+                    .read(true)
+                    .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+                    .open(&stamp)
+                    .map_err(storage)?;
+                Self::file(&file, 4096)?;
+                if !outbox.restored_snapshot {
+                    outbox.restored_snapshot = true;
+                    self.write(&outbox)?;
+                    return self.read(wallet);
+                }
+            }
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+            Err(e) => return Err(storage(e)),
+        }
+        Ok(outbox)
+    }
+    fn write(&self, outbox: &Outbox) -> Result<(), Error> {
+        self.write_in(outbox, None)
+    }
+    fn write_in(&self, outbox: &Outbox, active: Option<&DbTxn>) -> Result<(), Error> {
+        let previous = match fs::symlink_metadata(self.directory.join("outbox.json")) {
+            Ok(_) => {
+                let bytes = self.bytes()?;
+                let old: Outbox = serde_json::from_slice(&bytes).map_err(storage)?;
+                self.authenticate(&old)?;
+                old.validate_records()?;
+                if old.cohort != outbox.cohort || old.wallet_binding != outbox.wallet_binding {
+                    return Err(fail("RECOVERY_IDENTITY_MISMATCH"));
+                }
+                Some((old, sha256::Hash::hash(&bytes).to_string()))
+            }
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => None,
+            Err(e) => return Err(storage(e)),
+        };
+        if let Some((old, digest)) = &previous {
+            if let Some(txn) = active {
+                self.check_anchor(old, digest, false, txn)?;
+            } else {
+                let txn = self.database.begin_transaction()?;
+                self.check_anchor(old, digest, true, &txn)?;
+                txn.commit()?;
+            }
+        }
+        let owned = if active.is_none() {
+            Some(self.database.begin_transaction()?)
+        } else {
+            None
+        };
+        let txn = active.or(owned.as_ref()).unwrap();
+        if previous.is_none() {
+            let (cohort, binding, digest) =
+                Self::anchor(txn)?.ok_or_else(|| storage("missing fresh cohort"))?;
+            if cohort != outbox.cohort || binding != outbox.wallet_binding || !digest.is_empty() {
+                return Err(storage("fresh cohort already used"));
+            }
+        }
+        let mut data = outbox.clone();
+        data.revision = previous
+            .as_ref()
+            .map(|(old, _)| {
+                old.revision
+                    .checked_add(1)
+                    .ok_or_else(|| storage("revision overflow"))
+            })
+            .transpose()?
+            .unwrap_or(1);
+        data.previous_digest = previous.map(|(_, digest)| digest).unwrap_or_default();
+        data.authentication.clear();
+        data.validate_records()?;
+        let mut mac = <SimpleHmac<Sha256> as hmac::digest::KeyInit>::new_from_slice(&*self.key)
+            .map_err(storage)?;
+        mac.update(&serde_json::to_vec(&data).map_err(storage)?);
+        data.authentication = hex::encode(mac.finalize().into_bytes());
+        let bytes = serde_json::to_vec(&data).map_err(storage)?;
+        if bytes.len() as u64 > MAX_BYTES {
+            return Err(fail("RECOVERY_CAPACITY"));
+        }
+        let mut temp = tempfile::NamedTempFile::new_in(&self.directory).map_err(storage)?;
+        temp.write_all(&bytes).map_err(storage)?;
+        temp.as_file().sync_all().map_err(storage)?;
+        #[cfg(test)]
+        write_fault(1)?;
+        temp.persist(self.directory.join("outbox.json"))
+            .map_err(|e| storage(e.error))?;
+        #[cfg(test)]
+        write_fault(2)?;
+        File::open(&self.directory)
+            .and_then(|f| f.sync_all())
+            .map_err(storage)?;
+        #[cfg(test)]
+        write_fault(3)?;
+        Self::put_anchor(
+            txn,
+            &data.cohort,
+            &data.wallet_binding,
+            &sha256::Hash::hash(&bytes).to_string(),
+        )?;
+        #[cfg(test)]
+        write_fault(4)?;
+        if let Some(txn) = owned {
+            txn.commit()?;
+        }
+        Ok(())
+    }
+    fn initialize(&self, outbox: &Outbox) -> Result<(), Error> {
+        let txn = self.database.begin_transaction()?;
+        block_on(txn.inner().execute_unprepared("CREATE TABLE IF NOT EXISTS flutter_onchain_anchor (id INTEGER PRIMARY KEY CHECK(id=1),cohort TEXT NOT NULL,binding TEXT NOT NULL,digest TEXT NOT NULL)")).map_err(storage)?;
+        if Self::anchor(&txn)?.is_some() || !txn.iter_batch_transfers()?.is_empty() {
+            return Err(storage("existing native history"));
+        }
+        Self::put_anchor(&txn, &outbox.cohort, &outbox.wallet_binding, "")?;
+        self.write_in(outbox, Some(&txn))?;
+        txn.commit()?;
+        Ok(())
+    }
