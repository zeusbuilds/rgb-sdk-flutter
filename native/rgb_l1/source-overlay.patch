+struct Record {
+    operation_id: String,
+    fingerprint: String,
+    kind: Kind,
+    phase: Phase,
+    command: Option<Envelope>,
+    txid: Option<String>,
+    batch_transfer_index: Option<i32>,
+    unsigned_psbt: Option<String>,
+    signed_psbt: Option<String>,
+    failure_code: Option<String>,
+    cancel_requested: bool,
+    dispatch_started: bool,
+    /// Native-MAC authenticated ack.clean success, persisted before local release.
+    #[serde(default, skip_serializing_if = "is_false")]
+    revocation_confirmed: bool,
+    amount: String,
+    fee_rate: String,
+    asset_id: Option<String>,
+    address: Option<String>,
+    recipient_id: Option<String>,
+}
+impl Record {
+    fn new(command: Envelope) -> Self {
+        Self {
+            operation_id: command.request.operation_id.clone(),
+            fingerprint: command.request.fingerprint.clone(),
+            kind: command.request.kind,
+            amount: command.request.amount.clone(),
+            fee_rate: command.request.fee_rate.clone(),
+            asset_id: command.request.asset_id.clone(),
+            address: command.request.address.clone(),
+            recipient_id: command.request.recipient_id.clone(),
+            phase: Phase::Preparing,
+            command: Some(command),
+            txid: None,
+            batch_transfer_index: None,
+            unsigned_psbt: None,
+            signed_psbt: None,
+            failure_code: None,
+            cancel_requested: false,
+            dispatch_started: false,
+            revocation_confirmed: false,
+        }
+    }
+    fn terminal(&self) -> bool {
+        matches!(self.phase, Phase::Accepted | Phase::Rejected)
+    }
+    fn validate(&self, outbox: &Outbox) -> Result<(), Error> {
+        if (self.dispatch_started && !matches!(self.phase, Phase::Committing | Phase::Accepted))
+            || !hex(&self.operation_id, 32)
+            || !hex(&self.fingerprint, 64)
+            || (self.cancel_requested && self.phase == Phase::Accepted)
+            || (self.revocation_confirmed
+                && (self.kind != Kind::Rgb
+                    || self.phase != Phase::Committing
+                    || !self.dispatch_started
+                    || !self.cancel_requested))
+        {
+            return Err(storage("record identity"));
+        }
+        decimal(&self.amount, true).map_err(storage)?;
+        decimal(&self.fee_rate, true).map_err(storage)?;
+        if (self.kind == Kind::Bitcoin) != self.asset_id.is_none()
+            || (self.kind == Kind::Bitcoin) != self.address.is_some()
+            || (self.kind == Kind::Rgb) != self.recipient_id.is_some()
+        {
+            return Err(storage("receipt summary"));
+        }
+        if let Some(command) = &self.command {
+            command.validate().map_err(storage)?;
+            if self.amount != command.request.amount
+                || self.fee_rate != command.request.fee_rate
+                || self.asset_id != command.request.asset_id
+                || self.address != command.request.address
+                || self.recipient_id != command.request.recipient_id
+            {
+                return Err(storage("receipt approval mismatch"));
+            }
+            outbox.matches(command)?;
+            if command.request.operation_id != self.operation_id
+                || command.request.fingerprint != self.fingerprint
+                || command.request.kind != self.kind
+            {
+                return Err(storage("command identity"));
+            }
+        } else if !self.terminal() {
+            return Err(storage("missing command"));
+        }
+        if self.phase == Phase::Accepted {
+            if !self.txid.as_deref().is_some_and(|s| hex(s, 64))
+                || (self.kind == Kind::Bitcoin) != self.batch_transfer_index.is_none()
+                || self.batch_transfer_index.is_some_and(|n| n <= 0)
+            {
+                return Err(storage("accepted identity"));
+            }
+        }
+        match &self.unsigned_psbt {
+            Some(raw) => {
+                if raw.len() > 4 * 1024 * 1024 {
+                    return Err(storage("PSBT size"));
+                }
+                let unsigned = Psbt::from_str(raw).map_err(storage)?;
+                if self.txid.as_deref()
+                    != Some(unsigned.unsigned_tx.compute_txid().to_string().as_str())
+                    || (self.kind == Kind::Bitcoin) != self.batch_transfer_index.is_none()
+                    || self.batch_transfer_index.is_some_and(|n| n <= 0)
+                {
+                    return Err(storage("plan identity"));
+                }
+                if let Some(signed) = &self.signed_psbt {
+                    if signed.len() > 4 * 1024 * 1024 {
+                        return Err(storage("PSBT size"));
+                    }
+                    let signed = Psbt::from_str(signed).map_err(storage)?;
+                    if signed.unsigned_tx != unsigned.unsigned_tx
+                        || signed.clone().extract_tx().map_err(storage)?.compute_txid()
+                            != unsigned.unsigned_tx.compute_txid()
+                        || signed.inputs.iter().any(|i| {
+                            i.final_script_witness.is_none() && i.final_script_sig.is_none()
+                        })
+                    {
+                        return Err(storage("signed identity"));
+                    }
+                } else if matches!(self.phase, Phase::Prepared | Phase::Committing) {
+                    return Err(storage("missing signature"));
+                }
+            }
+            None => {
+                if matches!(self.phase, Phase::Prepared | Phase::Committing)
+                    || self.signed_psbt.is_some()
+                    || (self.phase != Phase::Accepted
+                        && (self.txid.is_some() || self.batch_transfer_index.is_some()))
+                {
+                    return Err(storage("missing plan"));
+                }
+            }
+        }
+        if self.terminal()
+            && (self.command.is_some()
+                || self.unsigned_psbt.is_some()
+                || self.signed_psbt.is_some())
+        {
+            return Err(storage("uncompacted terminal receipt"));
+        }
+        Ok(())
+    }
+    fn response(&self) -> Value {
+        json!({"version":1,"operationId":self.operation_id,"fingerprint":self.fingerprint,"kind":self.kind,"phase":self.phase,"txid":self.txid,"batchTransferIndex":self.batch_transfer_index,"failureCode":self.failure_code,"endAuthorized":matches!(self.phase,Phase::Committing|Phase::Accepted)})
+    }
+    fn finish(&mut self, accepted: bool, code: Option<&str>) {
+        self.phase = if accepted {
+            Phase::Accepted
+        } else {
+            Phase::Rejected
+        };
+        self.failure_code = code.map(str::to_owned);
+        self.revocation_confirmed = false;
+        if accepted { self.cancel_requested = false; }
+        self.command = None;
+        self.unsigned_psbt = None;
+        self.signed_psbt = None;
+        if !accepted {
+            self.dispatch_started = false;
+            self.txid = None;
+            self.batch_transfer_index = None;
+        }
+    }
+}
+#[derive(Clone, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Outbox {
+    version: u32,
+    wallet_binding: String,
+    cohort: String,
+    network: String,
+    source_revision: String,
+    overlay: String,
+    records: Vec<Record>,
+    restored_snapshot: bool,
+    revision: u64,
+    previous_digest: String,
+    #[serde(skip_serializing_if = "String::is_empty")]
+    authentication: String,
+}
+impl Outbox {
+    fn matches(&self, command: &Envelope) -> Result<(), Error> {
+        if self.wallet_binding != command.wallet_binding
+            || self.cohort != command.recovery_cohort
+            || self.network != command.network
+            || self.source_revision != command.native_source_revision
+            || self.overlay != command.native_overlay
+        {
+            return Err(fail("RECOVERY_IDENTITY_MISMATCH"));
+        }
+        Ok(())
+    }
+    fn validate(&self, wallet: &Wallet) -> Result<(), Error> {
+        if self.wallet_binding != wallet.recovery_binding(&self.network)? {
+            return Err(fail("RECOVERY_IDENTITY_MISMATCH"));
+        }
+        self.validate_records()?;
+        for record in &self.records {
+            if record.unsigned_psbt.is_some() {
+                wallet.validate_durable_plan(record)?;
+            }
+        }
+        Ok(())
+    }
+    fn validate_records(&self) -> Result<(), Error> {
+        if self.version != 1
+            || !hex(&self.wallet_binding, 64)
+            || !hex(&self.cohort, 32)
+            || self.source_revision != SOURCE
+            || self.overlay != OVERLAY
+            || self.records.len() > MAX_RECORDS
+            || self.revision == 0
+            || (!self.previous_digest.is_empty() && !hex(&self.previous_digest, 64))
+        {
+            return Err(fail("RECOVERY_IDENTITY_MISMATCH"));
+        }
+        let mut seen = std::collections::HashSet::new();
+        for record in &self.records {
+            if !seen.insert(&record.operation_id) {
+                return Err(storage("duplicate operation"));
+            }
+            record.validate(self)?;
+        }
+        if self.records.iter().filter(|r| !r.terminal()).count() > 1 {
+            return Err(storage("competing operations"));
+        }
+        Ok(())
+    }
+    fn index(&self, e: &Envelope) -> Result<Option<usize>, Error> {
+        self.matches(e)?;
+        let index = self
+            .records
+            .iter()
+            .position(|r| r.operation_id == e.request.operation_id);
+        if let Some(i) = index {
+            let r = &self.records[i];
+            if r.fingerprint != e.request.fingerprint
+                || r.kind != e.request.kind
+                || r.command.as_ref().is_some_and(|c| c != e)
+            {
+                return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+            }
+        }
+        Ok(index)
+    }
+}
