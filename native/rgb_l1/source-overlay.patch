diff --git a/src/wallet/settled_revalidation.rs b/src/wallet/settled_revalidation.rs
new file mode 100644
index 0000000..9cb2595
--- /dev/null
+++ b/src/wallet/settled_revalidation.rs
@@ -0,0 +1,920 @@
+//! Revalidate confirmation and native RGB ancestry without submitting a payment.
+use super::online::WalletOnline;
+use super::*;
+use crate::database::entities::prelude::BatchTransfer;
+use std::collections::VecDeque;
+use std::time::{Duration, Instant};
+
+const MAX_REVALIDATION_WITNESSES: usize = 10_000;
+
+fn unavailable() -> Error {
+    Error::Network {
+        details: "Current RGB confirmation state is unavailable.".into(),
+    }
+}
+
+fn sufficient(confirmations: Option<u64>, required: u64) -> bool {
+    confirmations.is_some_and(|count| count >= required)
+}
+
+struct BoundedResolver<R> {
+    inner: R,
+    deadline: Instant,
+}
+impl<R: ResolveWitness> BoundedResolver<R> {
+    fn available(&self) -> Result<(), WitnessResolverError> {
+        if Instant::now() >= self.deadline {
+            Err(WitnessResolverError::ResolverIssue(
+                None,
+                "RGB revalidation deadline reached".into(),
+            ))
+        } else {
+            Ok(())
+        }
+    }
+}
+impl<R: ResolveWitness> ResolveWitness for BoundedResolver<R> {
+    fn resolve_witness(&self, id: RgbTxid) -> Result<WitnessStatus, WitnessResolverError> {
+        self.available()?;
+        self.inner.resolve_witness(id)
+    }
+    fn get_block_header(
+        &self,
+        height: NonZeroU32,
+    ) -> Result<bitcoin::block::Header, WitnessResolverError> {
+        self.available()?;
+        self.inner.get_block_header(height)
+    }
+    fn check_chain_net(&self, network: ChainNet) -> Result<(), WitnessResolverError> {
+        self.available()?;
+        self.inner.check_chain_net(network)
+    }
+}
+
+pub(crate) struct Revalidation {
+    pub(crate) changes: RefreshResult,
+    pub(crate) blocked_ancestors: HashSet<i32>,
+    pub(crate) unavailable: bool,
+}
+
+fn observed<W: WalletOnline + ?Sized>(
+    wallet: &W,
+    txid: &str,
+    deadline: Instant,
+    cache: &mut HashMap<String, Result<Option<u64>, Error>>,
+) -> Result<Option<u64>, Error> {
+    cache
+        .entry(txid.into())
+        .or_insert_with(|| {
+            if Instant::now() >= deadline {
+                Err(unavailable())
+            } else {
+                wallet.indexer().get_tx_confirmations(txid)
+            }
+        })
+        .clone()
+}
+
+/// RGB ancestry can reference a pre-existing blinded seal, so a Bitcoin child
+/// can stay confirmed while an RGB ancestor witness becomes unconfirmed. Walk
+/// the canonical op-input index instead of assuming Bitcoin ancestry covers it.
+fn ancestry_confirmed<W: WalletOnline + ?Sized>(
+    wallet: &W,
+    txn: &DbTxn,
+    witness: RgbTxid,
+    required: u64,
+    deadline: Instant,
+    cache: &mut HashMap<String, Result<Option<u64>, Error>>,
+) -> Result<bool, Error> {
+    let mut queue = VecDeque::new();
+    for bundle in RgbStore::bundles_of_witness(&txn, witness)? {
+        let contract = RgbStore::bundle_contract(&txn, bundle)?.ok_or_else(unavailable)?;
+        for op in RgbStore::ops_in_bundle(&txn, bundle)? {
+            queue.push_back((contract, op));
+        }
+    }
+    let mut seen = HashSet::new();
+    let mut invalid = false;
+    while let Some((contract, op)) = queue.pop_front() {
+        if !seen.insert(op) {
+            continue;
+        }
+        if seen.len() > 100_000 || Instant::now() >= deadline {
+            return Err(unavailable());
+        }
+        invalid |= RgbStore::any_op_invalid(&txn, &std::collections::BTreeSet::from([op]))?;
+        if let Some(bundle) = RgbStore::bundle_of_op(&txn, op)? {
+            let mut confirmed = false;
+            let mut failure = false;
+            for parent in RgbStore::bundle_witnesses(&txn, bundle)? {
+                match observed(wallet, &parent.to_string(), deadline, cache) {
+                    Ok(count) if sufficient(count, required) => {
+                        confirmed = true;
+                        break;
+                    }
+                    Err(_) => failure = true,
+                    _ => {}
+                }
+            }
+            if !confirmed {
+                return if failure {
+                    Err(unavailable())
+                } else {
+                    Ok(false)
+                };
+            }
+        } else {
+            let genesis = RgbStore::genesis(&txn, contract)?.ok_or_else(unavailable)?;
+            if genesis.id() != op {
+                return Err(unavailable());
+            }
+        }
+        for input in RgbStore::input_opouts_for_op(&txn, op)? {
+            queue.push_back((contract, input.op));
+        }
+    }
+    if invalid {
+        // An invalid native index without an observed insufficient witness is
+        // unresolved (e.g. another resolver failed), not current reorg proof.
+        Err(unavailable())
+    } else {
+        Ok(true)
+    }
+}
+
+/// The local coloring graph supplements the consensus store's transitive
+/// invalid-op index. A pending/uncertain producer must not leave its descendant
+/// allocations classified as settled, even if another observation is stale.
+fn ancestry_fence(data: &DbData, unsafe_roots: &HashSet<i32>) -> HashSet<i32> {
+    let asset_batches: HashMap<_, _> = data
+        .asset_transfers
+        .iter()
+        .map(|a| (a.idx, a.batch_transfer_idx))
+        .collect();
+    let failed: HashSet<_> = data
+        .batch_transfers
+        .iter()
+        .filter(|b| b.status.failed())
+        .map(|b| b.idx)
+        .collect();
+    let mut producers: HashMap<i32, HashSet<i32>> = HashMap::new();
+    for coloring in &data.colorings {
+        if ColoringType::INCOMING.contains(&coloring.r#type) {
+            if let Some(batch) = asset_batches.get(&coloring.asset_transfer_idx) {
+                if !failed.contains(batch) {
+                    producers
+                        .entry(coloring.txo_idx)
+                        .or_default()
+                        .insert(*batch);
+                }
+            }
+        }
+    }
+    let mut children: HashMap<i32, HashSet<i32>> = HashMap::new();
+    for coloring in data
+        .colorings
+        .iter()
+        .filter(|c| c.r#type == ColoringType::Input)
+    {
+        let Some(child) = asset_batches.get(&coloring.asset_transfer_idx) else {
+            continue;
+        };
+        for parent in producers.get(&coloring.txo_idx).into_iter().flatten() {
+            if parent != child {
+                children.entry(*parent).or_default().insert(*child);
+            }
+        }
+    }
+    let mut queue: VecDeque<_> = unsafe_roots.iter().copied().collect();
+    let mut traversed = unsafe_roots.clone();
+    let mut descendants = HashSet::new();
+    while let Some(parent) = queue.pop_front() {
+        for child in children.get(&parent).into_iter().flatten() {
+            descendants.insert(*child);
+            if traversed.insert(*child) {
+                queue.push_back(*child);
+            }
+        }
+    }
+    descendants
+}
+
+/// A previously consumed waiting batch with independently verified witness
+/// and complete RGB ancestry is not an unsafe root merely because its history
+/// projection has not been promoted yet. This lets a whole confirmed DAG recover
+/// in one refresh, while a genuinely unconfirmed ancestor still fences every
+/// descendant, including independently confirmed Bitcoin children.
+fn reconfirmation_fence(
+    data: &DbData,
+    confirmed: &HashSet<i32>,
+    unconfirmed: &HashSet<i32>,
+) -> HashSet<i32> {
+    let mut unsafe_roots: HashSet<_> = data
+        .batch_transfers
+        .iter()
+        .filter(|b| !b.status.settled() && !b.status.failed() && !confirmed.contains(&b.idx))
+        .map(|b| b.idx)
+        .collect();
+    unsafe_roots.extend(unconfirmed);
+    let mut blocked = ancestry_fence(data, &unsafe_roots);
+    blocked.extend(unconfirmed);
+    blocked
+}
+
+/// Unknown observations preserve their own last-known projection, while a
+/// separately observed insufficient witness still demotes its entire local DAG.
+/// An unrelated outage must not hide positive reorganization evidence.
+fn projection_fence(
+    data: &DbData,
+    confirmed: &HashSet<i32>,
+    unconfirmed: &HashSet<i32>,
+    uncertain: bool,
+) -> HashSet<i32> {
+    if uncertain {
+        let mut blocked = ancestry_fence(data, unconfirmed);
+        blocked.extend(unconfirmed);
+        blocked
+    } else {
+        reconfirmation_fence(data, confirmed, unconfirmed)
+    }
+}
+
+/// One local SQLite transaction contains consensus witness updates and the
+/// history projection. No extra unsigned recovery marker or consumption flag
+/// can be removed to make an already-consumed transfer look fresh.
+pub(crate) fn inspect<W: WalletOnline + ?Sized>(
+    wallet: &W,
+    txn: &DbTxn,
+) -> Result<Revalidation, Error> {
+    let deadline = Instant::now() + Duration::from_secs(20);
+    let known = RgbStore::all_witness_ords(&txn)?;
+    if known.len() > MAX_REVALIDATION_WITNESSES {
+        return Err(Error::Recovery {
+            code: "RECOVERY_CAPACITY".into(),
+        });
+    }
+    let updated = wallet.rgb_stock(txn)?.update_witnesses(
+        &BoundedResolver {
+            inner: wallet.blockchain_resolver(),
+            deadline,
+        },
+        0,
+        vec![],
+    )?;
+    let mut uncertain = !updated.failed.is_empty();
+    let data = txn.get_db_data(false)?;
+    let mut observations: HashMap<String, Result<Option<u64>, Error>> = HashMap::new();
+    let mut confirmed_batches = HashSet::new();
+    let mut unconfirmed_batches = HashSet::new();
+    for batch in &data.batch_transfers {
+        let Some(txid) = &batch.txid else {
+            continue;
+        }; // genesis has no witness.
+        if !batch.status.settled()
+            && !(batch.status.waiting_confirmations() && consumed_witness(txn, txid)?)
+        {
+            continue;
+        }
+        let confirmed = match observed(wallet, txid, deadline, &mut observations) {
+            Ok(count) => sufficient(count, u64::from(batch.min_confirmations)),
+            Err(_) => {
+                uncertain = true;
+                continue;
+            }
+        };
+        if !confirmed {
+            unconfirmed_batches.insert(batch.idx);
+            continue;
+        }
+        let witness = RgbTxid::from_str(txid).map_err(|_| Error::InvalidTxid)?;
+        match ancestry_confirmed(
+            wallet,
+            txn,
+            witness,
+            u64::from(batch.min_confirmations),
+            deadline,
+            &mut observations,
+        ) {
+            Ok(true) => {
+                confirmed_batches.insert(batch.idx);
+            }
+            Ok(false) => {
+                unconfirmed_batches.insert(batch.idx);
+            }
+            Err(_) => uncertain = true,
+        }
+    }
+    // An unavailable observation never demotes that witness's last-known
+    // projection. Positive insufficient observations remain authoritative even
+    // if another unrelated witness is unavailable; only those proven roots and
+    // their descendants are demoted. Both Begin and End reject uncertainty.
+    let blocked_ancestors =
+        projection_fence(&data, &confirmed_batches, &unconfirmed_batches, uncertain);
+    let mut changes = RefreshResult::new();
+    if uncertain {
+        changes.extend(
+            data.batch_transfers
+                .iter()
+                .filter(|b| !b.status.failed() && b.txid.is_some())
+                .map(|b| {
+                    (
+                        b.idx,
+                        RefreshedTransfer {
+                            updated_status: None,
+                            failure: Some(unavailable()),
+                        },
+                    )
+                }),
+        );
+    }
+    for batch in data
+        .batch_transfers
+        .iter()
+        .filter(|b| b.status.settled() && b.txid.is_some() && blocked_ancestors.contains(&b.idx))
+    {
+        let mut demoted: DbBatchTransferActMod = batch.clone().into();
+        demoted.status = ActiveValue::Set(TransferStatus::WaitingConfirmations);
+        // Preserve the original transfer timestamps. A chain reorganization is
+        // not a new payment and must not move its history entry to today.
+        block_on(BatchTransfer::update(demoted).exec(txn.inner()))?;
+        if batch.incoming {
+            let (_, transfer) =
+                batch.get_incoming_transfer(&data.asset_transfers, &data.transfers)?;
+            if let Some(recipient) = transfer.recipient_id.as_deref() {
+                wallet.delete_valid_consignment(recipient)?;
+            }
+        }
+        changes.insert(
+            batch.idx,
+            RefreshedTransfer {
+                updated_status: Some(TransferStatus::WaitingConfirmations),
+                failure: uncertain.then(unavailable),
+            },
+        );
+    }
+    Ok(Revalidation {
+        changes,
+        blocked_ancestors,
+        unavailable: uncertain,
+    })
+}
+
+/// Presence means this exact witness already entered the canonical native RGB
+/// store. A reorg must not let an old proxy deadline destroy that state.
+pub(crate) fn consumed_witness(txn: &DbTxn, txid: &str) -> Result<bool, Error> {
+    let txid = RgbTxid::from_str(txid).map_err(|_| Error::InvalidTxid)?;
+    Ok(!RgbStore::bundles_of_witness(&txn, txid)?.is_empty())
+}
+
+/// A plan can have been prepared before a reorg. Check its input producers
+/// again before End's first dispatch, without changing its transaction or
+/// creating another plan. The current outgoing reservation is not a producer.
+pub(crate) fn ensure_inputs<W: WalletOnline + ?Sized>(
+    wallet: &W,
+    txn: &DbTxn,
+    psbt: &Psbt,
+) -> Result<(), Error> {
+    if inspect(wallet, txn)?.unavailable {
+        return Err(unavailable());
+    }
+    let data = txn.get_db_data(false)?;
+    let current_txid = psbt.unsigned_tx.compute_txid().to_string();
+    let selected: HashSet<_> = psbt
+        .unsigned_tx
+        .input
+        .iter()
+        .map(|i| (i.previous_output.txid.to_string(), i.previous_output.vout))
+        .collect();
+    let txos: HashSet<_> = data
+        .txos
+        .iter()
+        .filter(|t| selected.contains(&(t.txid.clone(), t.vout)))
+        .map(|t| t.idx)
+        .collect();
+    for coloring in data
+        .colorings
+        .iter()
+        .filter(|c| txos.contains(&c.txo_idx) && ColoringType::INCOMING.contains(&c.r#type))
+    {
+        let at = data
+            .asset_transfers
+            .iter()
+            .find(|a| a.idx == coloring.asset_transfer_idx)
+            .ok_or_else(unavailable)?;
+        let batch = data
+            .batch_transfers
+            .iter()
+            .find(|b| b.idx == at.batch_transfer_idx)
+            .ok_or_else(unavailable)?;
+        if batch.status.pending() && batch.txid.as_ref() != Some(&current_txid) {
+            return Err(unavailable());
+        }
+    }
+    Ok(())
+}
