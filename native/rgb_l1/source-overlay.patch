+thread_local! {static WRITE_FAULT: std::cell::Cell<Option<u8>>=const{std::cell::Cell::new(None)};}
+#[cfg(test)]
+fn write_fault(point: u8) -> Result<(), Error> {
+    WRITE_FAULT.with(|f| {
+        if f.get() == Some(point) {
+            f.set(None);
+            Err(storage("injected write boundary"))
+        } else {
+            Ok(())
+        }
+    })
