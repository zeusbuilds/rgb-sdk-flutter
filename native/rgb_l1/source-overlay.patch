+    #[test]
+    fn split_and_merge_frontiers_conserve_value_with_mixed_confirmation_policies() {
+        let mut data = DbData {
+            batch_transfers: (1..=5)
+                .map(|id| batch(id, TransferStatus::WaitingConfirmations, id == 1))
+                .collect(),
+            asset_transfers: (1..=5).map(|id| asset(id, id)).collect(),
+            transfers: vec![],
+            colorings: vec![
+                coloring(1, 1, 1, ColoringType::Receive, 1000),
+                coloring(2, 1, 2, ColoringType::Input, 1000),
+                coloring(3, 2, 2, ColoringType::Change, 600),
+                coloring(4, 3, 2, ColoringType::Change, 399),
+                coloring(5, 2, 3, ColoringType::Input, 600),
+                coloring(6, 4, 3, ColoringType::Change, 599),
+                coloring(7, 3, 4, ColoringType::Input, 399),
+                coloring(8, 5, 4, ColoringType::Change, 398),
+                coloring(9, 4, 5, ColoringType::Input, 599),
+                coloring(10, 5, 5, ColoringType::Input, 398),
+                coloring(11, 6, 5, ColoringType::Change, 996),
+            ],
+            txos: (1..=6).map(|id| txo(id, id < 6)).collect(),
+        };
+        assert_eq!(
+            balance_of(&data),
+            Balance {
+                settled: 0,
+                future: 996,
+                spendable: 0
+            }
+        );
+        data.batch_transfers[0].status = TransferStatus::Settled;
+        assert_eq!(
+            balance_of(&data),
+            Balance {
+                settled: 1000,
+                future: 996,
+                spendable: 0
+            }
+        );
+        for id in [2, 4] {
+            data.batch_transfers[(id - 1) as usize].status = TransferStatus::Settled;
+        }
+        assert_eq!(
+            balance_of(&data),
+            Balance {
+                settled: 998,
+                future: 996,
+                spendable: 0
+            }
+        );
+        // One branch has a stricter native policy. A low-threshold child cannot
+        // bypass its pending producer merely because the child's own proof is
+        // sufficient. Once both policies are met, the same pass releases all.
+        data.batch_transfers[2].min_confirmations = 6;
+        let observed: HashMap<_, _> = [(1, 8), (2, 7), (3, 3), (4, 6), (5, 2)].into();
+        let mut confirmed: HashSet<_> = data
+            .batch_transfers
+            .iter()
+            .filter(|b| sufficient(Some(observed[&b.idx]), u64::from(b.min_confirmations)))
+            .map(|b| b.idx)
+            .collect();
+        assert_eq!(
+            reconfirmation_fence(&data, &confirmed, &HashSet::from([3])),
+            HashSet::from([3, 5])
+        );
+        confirmed.insert(3);
+        assert!(reconfirmation_fence(&data, &confirmed, &HashSet::new()).is_empty());
+        for batch in &mut data.batch_transfers {
+            batch.status = TransferStatus::Settled;
+        }
+        assert_eq!(
+            balance_of(&data),
+            Balance {
+                settled: 996,
+                future: 996,
+                spendable: 996
+            }
+        );
+    }
