+impl Envelope {
+    fn parse(raw: &str) -> Result<Self, Error> {
+        if raw.len() > MAX_COMMAND {
+            return Err(fail("RECOVERY_REQUEST_INVALID"));
+        }
+        let envelope: Self =
+            serde_json::from_str(raw).map_err(|_| fail("RECOVERY_REQUEST_INVALID"))?;
+        envelope.validate()?;
+        Ok(envelope)
+    }
+    fn validate(&self) -> Result<(), Error> {
+        let r = &self.request;
+        if self.version != 3
+            || self.backend != "RGB_L1"
+            || self.native_source_revision != SOURCE
+            || self.native_overlay != OVERLAY
+            || !hex(&self.wallet_binding, 64)
+            || !hex(&self.recovery_cohort, 32)
+            || r.version != 2
+            || !hex(&r.operation_id, 32)
+            || !hex(&r.fingerprint, 64)
+            || r.donation
+            || r.min_confirmations == 0
+        {
+            return Err(fail("RECOVERY_REQUEST_INVALID"));
+        }
+        decimal(&r.amount, true)?;
+        decimal(&r.fee_rate, true)?;
+        let mut unsigned = self.clone();
+        unsigned.request.fingerprint.clear();
+        if sha256::Hash::hash(&serde_json::to_vec(&unsigned).map_err(storage)?).to_string()
+            != r.fingerprint
+        {
+            return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+        }
+        let text = |s: &str, max: usize| {
+            !s.is_empty() && s.len() <= max && s.bytes().all(|b| b >= 0x21 && b <= 0x7e)
+        };
+        match r.kind {
+            Kind::Bitcoin => {
+                if !r.address.as_deref().is_some_and(|s| text(s, 1000))
+                    || r.asset_id.is_some()
+                    || r.recipient_id.is_some()
+                    || !r.transport_endpoints.is_empty()
+                    || r.sender_transport_endpoint.is_some()
+                    || r.witness_amount_sat.is_some()
+                    || r.witness_blinding.is_some()
+                    || r.expiration_timestamp.is_some()
+                    || r.invoice_public_key.is_some()
+                    || r.invoice_encryption.is_some()
+                {
+                    return Err(fail("RECOVERY_REQUEST_INVALID"));
+                }
+            }
+            Kind::Rgb => {
+                if r.address.is_some()
+                    || !r.asset_id.as_deref().is_some_and(|s| text(s, 512))
+                    || !r.recipient_id.as_deref().is_some_and(|s| text(s, 4000))
+                    || r.transport_endpoints.is_empty()
+                    || r.transport_endpoints.len() > 16
+                    || r.transport_endpoints.iter().any(|s| !text(s, 2048))
+                    || !r
+                        .sender_transport_endpoint
+                        .as_deref()
+                        .is_some_and(|s| text(s, 2048))
+                    || !r.invoice_public_key.as_deref().is_some_and(|s| hex(s, 64))
+                    || !matches!(
+                        r.invoice_encryption.as_deref(),
+                        Some("Required" | "Optional" | "Unsupported")
+                    )
+                {
+                    return Err(fail("RECOVERY_REQUEST_INVALID"));
+                }
+                ContractId::from_str(r.asset_id.as_deref().unwrap())
+                    .map_err(|_| fail("RECOVERY_REQUEST_INVALID"))?;
+                decimal(
+                    r.expiration_timestamp
+                        .as_deref()
+                        .ok_or_else(|| fail("RECOVERY_REQUEST_INVALID"))?,
+                    true,
+                )?;
+                if let Some(n) = &r.witness_amount_sat {
+                    decimal(n, true)?;
+                }
+                if let Some(n) = &r.witness_blinding {
+                    decimal(n, false)?;
+                    if r.witness_amount_sat.is_none() {
+                        return Err(fail("RECOVERY_REQUEST_INVALID"));
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+}
