+    #[test]
+    fn deep_reorg_counts_confirmed_frontier_once_and_recovers_entire_chain() {
+        let mut data = historical_chain(10, TransferStatus::Settled);
+        assert_eq!(
+            balance_of(&data),
+            Balance {
+                settled: 991,
+                future: 991,
+                spendable: 991
+            }
+        );
+        // Nine pending spends spend the same original asset successively.
+        // Their historical inputs must not inflate 1000 into their sum (8964).
+        for pending_from in 2..=10 {
+            for batch in &mut data.batch_transfers {
+                batch.status = if batch.idx >= pending_from {
+                    TransferStatus::WaitingConfirmations
+                } else {
+                    TransferStatus::Settled
+                };
+            }
+            assert_eq!(
+                balance_of(&data),
+                Balance {
+                    settled: 1002 - pending_from as u64,
+                    future: 991,
+                    spendable: 0,
+                }
+            );
+        }
+        for batch in &mut data.batch_transfers {
+            batch.status = TransferStatus::WaitingConfirmations;
+        }
+        assert_eq!(
+            balance_of(&data),
+            Balance {
+                settled: 0,
+                future: 991,
+                spendable: 0
+            }
+        );
+        let verified: HashSet<_> = (1..=10).collect();
+        // Exact positive proofs release every generation in one observation;
+        // the old waiting projection cannot force one refresh per ancestor.
+        assert!(reconfirmation_fence(&data, &verified, &HashSet::new()).is_empty());
+        assert_eq!(
+            reconfirmation_fence(&data, &verified, &HashSet::from([1])),
+            (1..=10).collect()
+        );
+        for batch in &mut data.batch_transfers {
+            batch.status = TransferStatus::Settled;
+        }
+        assert_eq!(
+            balance_of(&data),
+            Balance {
+                settled: 991,
+                future: 991,
+                spendable: 991
+            }
+        );
+    }
