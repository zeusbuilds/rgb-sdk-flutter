+// Rust 1.94's File::try_lock is Unsupported on Android. Use the supported
+// platform flock directly on every admitted Unix target, with no blocking or
+// lock bypass. Only genuine contention is retryable BUSY; other errors retain
+// the stronger storage fence instead of masquerading as another writer.
+fn lock_outbox_descriptor(fd: libc::c_int) -> Result<(), Error> {
+    if unsafe { libc::flock(fd, libc::LOCK_EX | libc::LOCK_NB) } == 0 {
+        return Ok(());
+    }
+    let error = std::io::Error::last_os_error();
+    if error.kind() == std::io::ErrorKind::WouldBlock {
+        Err(fail("RECOVERY_BUSY"))
+    } else {
+        Err(storage(error))
+    }
+}
+fn hex(value: &str, n: usize) -> bool {
+    value.len() == n
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn decimal(value: &str, positive: bool) -> Result<u64, Error> {
+    let parsed = value
+        .parse::<u64>()
+        .map_err(|_| fail("RECOVERY_REQUEST_INVALID"))?;
+    if parsed.to_string() != value || (positive && parsed == 0) {
+        return Err(fail("RECOVERY_REQUEST_INVALID"));
+    }
+    Ok(parsed)
+}
