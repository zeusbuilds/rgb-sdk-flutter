+    fn historical_chain(depth: i32, status: TransferStatus) -> DbData {
+        let mut data = DbData {
+            batch_transfers: vec![batch(1, status, true)],
+            asset_transfers: vec![asset(1, 1)],
+            transfers: vec![],
+            colorings: vec![coloring(1, 1, 1, ColoringType::Receive, 1000)],
+            txos: vec![txo(1, depth > 1)],
+        };
+        for id in 2..=depth {
+            data.batch_transfers.push(batch(id, status, false));
+            data.asset_transfers.push(asset(id, id));
+            data.colorings.push(coloring(
+                2 * id - 2,
+                id - 1,
+                id,
+                ColoringType::Input,
+                1002 - id as u64,
+            ));
+            data.colorings.push(coloring(
+                2 * id - 1,
+                id,
+                id,
+                ColoringType::Change,
+                1001 - id as u64,
+            ));
+            data.txos.push(txo(id, id < depth));
+        }
+        data
+    }
