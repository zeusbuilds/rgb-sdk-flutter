+    #[test]
+    fn recipient_ack_proof_is_bound_to_positive_response_exact_transfer_and_hash() {
+        let key = ed25519_from_seed(&[7u8;32]);
+        let recipient = LocalRecipient {
+            recipient_id: "invoice".into(), local_recipient_data: LocalRecipientData::Witness(
+                LocalWitnessData { amount_sat:1000, blinding:None, vout:0 }),
+            assignment: Assignment::Fungible(1), transport_endpoints:vec![],
+            public_key:key.verifying_key().to_bytes().to_vec(), encryption:Encryption::Required,
+            invoice_expiration:None,
+        };
+        let hash = "ab".repeat(32);
+        let signature = hex::encode(sign_ed25519(&key, &sha256_digest(format!("transfertrue{hash}").as_bytes())));
+        let mut proof = GetAckResponse { acks:HashMap::from([("transfer".into(),true)]),
+            signatures:HashMap::from([("transfer".into(),signature)]) };
+        assert!(verified_ack(&proof, &recipient, "transfer", &hash).is_some());
+        assert!(verified_ack(&proof, &recipient, "other", &hash).is_none());
+        assert!(verified_ack(&proof, &recipient, "transfer", &"cd".repeat(32)).is_none());
+        proof.acks.insert("transfer".into(),false);
+        assert!(verified_ack(&proof, &recipient, "transfer", &hash).is_none());
+        proof.acks.insert("transfer".into(),true);
+        proof.signatures.insert("transfer".into(),"00".repeat(64));
+        assert!(verified_ack(&proof, &recipient, "transfer", &hash).is_none());
+    }
+}
+
+fn endpoint_identity(endpoint: &str) -> Result<String, Error> {
+    let endpoint = endpoint.replacen("rpcs://", "https://", 1).replacen("rpc://", "http://", 1);
+    let uri = reqwest::Url::parse(&endpoint).map_err(|_| invalid())?;
+    if !matches!(uri.scheme(), "http" | "https") || !uri.username().is_empty()
+        || uri.password().is_some() || uri.fragment().is_some()
+    {
+        return Err(invalid());
+    }
+    Ok(uri.to_string())
+}
+
+fn verified_ack(ack: &GetAckResponse, recipient: &LocalRecipient, transfer_id: &str, hash: &str) -> Option<Vec<u8>> {
+    if ack.acks.get(transfer_id) != Some(&true) {
+        return None;
+    }
+    let signature = hex::decode(ack.signatures.get(transfer_id)?).ok()?;
+    let key = verifying_key_from_bytes(&recipient.public_key).ok()?;
+    let message = sha256_digest(format!("{transfer_id}true{hash}").as_bytes());
+    verify_ed25519(&key, &message, &signature).then_some(signature)
+}
+
+fn exact_chain_transaction(indexer: &Indexer, expected: &BdkTransaction) -> Result<bool, Error> {
+    let txid = expected.compute_txid();
+    // Absence and unavailable reads are never treated as a rejection or release of authority.
+    if !matches!(indexer.get_tx_confirmations(&txid.to_string()), Ok(Some(_))) {
+        return Ok(false);
+    }
+    let observed: Option<BdkTransaction> = match indexer {
+        #[cfg(feature = "bitcoind")]
+        Indexer::Bitcoind(client) => client.get_raw_transaction(&txid, None).ok(),
+        #[cfg(feature = "electrum")]
+        Indexer::Electrum(client) => client.inner.transaction_get(&txid).ok(),
+        #[cfg(feature = "esplora")]
+        Indexer::Esplora(client) => client.get_tx(&txid).ok().flatten(),
+    };
+    match observed {
+        Some(actual) if actual == *expected => Ok(true),
+        Some(_) => Err(invalid()),
+        None => Ok(false),
+    }
+}
+
+impl Wallet {
+    /// Repair local acceptance only from the exact native plan and authoritative external proof.
+    /// `false` means no sufficient proof was obtained, never that a payment did not happen.
+    pub(crate) fn recover_submitted_onchain(
+        &mut self, online: Online, signed_psbt: &str,
+        expected_asset: Option<&str>, expected_batch: Option<i32>,
+    ) -> Result<bool, Error> {
+        let read_deadline = std::time::Instant::now() + std::time::Duration::from_secs(20);
+        self.check_online(online)?;
+        if self.bitcoin_network() == BitcoinNetwork::Signet {
+            use crate::no_wallet::validation::{SignetCheckpoint, check_signet_indexer};
+            let profile = match self.online_data().as_ref().ok_or(Error::Offline)?.indexer_config {
+                IndexerConfig::DevSignetElectrum { .. } | IndexerConfig::DevSignetEsplora { .. } => SignetCheckpoint::Dev,
+                _ => SignetCheckpoint::Public,
+            };
+            let genesis = self.indexer().block_hash(0)?;
+            check_signet_indexer(Some(profile), &genesis, || Ok(self.indexer().block_hash(1)?))?;
+        }
+        let psbt = Psbt::from_str(signed_psbt)?;
+        let signed = psbt.clone().extract_tx().map_err(InternalError::from)?;
+        let txid = signed.compute_txid().to_string();
+        let on_chain = exact_chain_transaction(self.indexer(), &signed)?;
+        let txn = self.database().begin_transaction()?;
+
+        let Some(asset) = expected_asset else {
+            if expected_batch.is_some() { return Err(invalid()); }
+            if !on_chain { return Ok(false); }
+            self.check_vanilla_end(&txn, &psbt, WalletTransactionType::SendBtc)?;
+            self.finalize_vanilla_wallet_transaction(&txn, &psbt, WalletTransactionType::SendBtc)?;
+            self.update_backup_info(&txn, false)?;
+            self.persist_and_commit(txn)?;
+            return Ok(true);
+        };
+        let expected_batch = expected_batch.filter(|idx| *idx > 0).ok_or_else(invalid)?;
+        let mut batches: Vec<_> = txn.get_batch_transfers_by_txid(&txid)?.into_iter().filter(|b| !b.incoming).collect();
+        if batches.len() != 1 || batches[0].idx != expected_batch { return Err(invalid()); }
+        let existing = batches.remove(0);
+        let (_, transfer_dir, mut info, fascia) = self.get_transfer_end_data(&psbt)?;
+        if info.donation || !info.is_operation(&TypeOfTransition::Transfer)
+            || info.transfers.len() != 1 || !info.transfers.contains_key(asset)
+            || fascia.witness_id().to_string() != txid
+            || info.operation_secret_key != existing.operation_secret_key
+        { return Err(invalid()); }
+        // Independently bind the immutable fascia to this Bitcoin transaction commitment.
+        let mut messages = BTreeMap::new();
+        for (contract, bundle) in fascia.bundles() {
+            bundle.check_opid_commitments().map_err(|_| invalid())?;
+            messages.insert(ProtocolId::from(*contract), Message::from(bundle.bundle_id()));
+        }
+        let mut source = MultiSource::with_static_entropy(info.entropy);
+        source.messages = MediumOrdMap::from_checked(messages);
+        let commitment = MerkleTree::try_commit(&source).map_err(|_| invalid())?.commit_id();
+        crate::no_wallet::inspection::verify_witness_commitment(
+            &fascia.seal_witness().dbc_proof, &commitment, &psbt.unsigned_tx,
+        )?;
+        let (pin, local_consignment) = snapshot(&transfer_dir, &txid, asset)?;
+        let native_hashes = self.consignment_hashes(&transfer_dir, &info)?;
+        if native_hashes.get(asset) != Some(&pin.digest) { return Err(invalid()); }
+        let recipients = &info.transfers[asset].recipients;
+        if recipients.is_empty() || recipients.len() > 16 { return Err(invalid()); }
+        let db_recipients = txn.get_transfers_for_asset(expected_batch, asset)?;
+        if db_recipients.len() != recipients.len() { return Err(invalid()); }
+        for recipient in recipients {
+            if !db_recipients.iter().any(|row| row.recipient_id.as_deref() == Some(&recipient.recipient_id)
+                && row.recipient_pubkey.as_ref() == Some(&recipient.public_key)
+                && row.requested_assignment.as_ref() == Some(&recipient.assignment)
+                && row.consignment_hash.as_ref().is_none_or(|hash| hash == &pin.digest))
+            { return Err(invalid()); }
+        }
+        // A committed native receipt is authoritative; never regress its status on a later read.
+        if matches!(existing.status, TransferStatus::WaitingCounterparty | TransferStatus::WaitingConfirmations | TransferStatus::Settled) {
+            if db_recipients.iter().any(|row| row.consignment_hash.as_deref() != Some(pin.digest.as_str())) {
+                return Err(invalid());
+            }
+            return Ok(true);
+        }
+        if on_chain {
+            let mut stock = self.rgb_stock(&txn)?;
+            stock.consume_fascia(fascia, None)?;
+            drop(stock);
+            self.update_or_save_transfers(&txn, txid, &info, TransferStatus::WaitingConfirmations,
+                                          &native_hashes, false, &psbt)?;
+            self.update_backup_info(&txn, false)?;
+            self.persist_and_commit(txn)?;
+            return Ok(true);
+        }
+        if existing.status != TransferStatus::Initiated { return Ok(false); }
+        let seed: [u8; 32] = info.operation_secret_key.clone().and_then(|s| s.try_into().ok()).ok_or_else(invalid)?;
+        let sender = ed25519_from_seed(&seed);
+        let sender_hex = hex::encode(sender.verifying_key().to_bytes());
+        let sender_endpoint = info.sender_transport_endpoint.as_deref().ok_or_else(invalid)?;
+        let sender_url = self.convert_transport_endpoint_url(sender_endpoint)?;
+        let sender_proxy = ProxyClient::new(&sender_url, self.bitcoin_network())?;
+        if std::time::Instant::now() >= read_deadline { return Ok(false); }
+        let ids: Vec<_> = recipients.iter().map(|r| r.proxy_ids(&sender_hex).1).collect();
+        let timestamp = now().unix_timestamp().to_string();
+        let signature = hex::encode(sign_ed25519(&sender, &sha256_digest(get_ack_message(&ids, &timestamp).as_bytes())));
+        let ack = match sender_proxy.get_ack(&ids, &signature, &timestamp) {
+            Ok(response) if response.error.is_none() => match response.result { Some(result) => result, None => return Ok(false) },
+            _ => return Ok(false),
+        };
+        if std::time::Instant::now() >= read_deadline { return Ok(false); }
+        let retention = match sender_proxy.get_info() {
+            Ok(response) if response.error.is_none() => response.result,
+            _ => None,
+        };
+        let Some(retention) = retention.filter(|info| info.protocol_version == "1.0") else { return Ok(false); };
+        let Some(grace) = retention.retention_grace_secs.and_then(|s| s.parse::<u32>().ok()) else { return Ok(false); };
+        let grace = std::cmp::max(grace, MIN_SENDER_RETENTION_GRACE_SECS);
+        let deadline = info.expiration_timestamp.and_then(|expiration| expiration.checked_add(i64::from(grace))).ok_or_else(invalid)?;
+        let mut ack_proofs = Vec::new();
+        for recipient in &mut info.transfers.get_mut(asset).ok_or_else(invalid)?.recipients {
+            let transfer_id = recipient.proxy_ids(&sender_hex).1;
+            let signed_ack = verified_ack(&ack, recipient, &transfer_id, &pin.digest);
+            let mut posted = false;
+            for endpoint in &mut recipient.transport_endpoints {
+                if std::time::Instant::now() >= read_deadline { break; }
+                if endpoint.transport_type != TransportType::JsonRpc || !endpoint.usable { continue; }
+                let response = match ProxyClient::new(&endpoint.endpoint, self.bitcoin_network())
+                    .and_then(|proxy| proxy.get_consignment(&transfer_id)) {
+                    Ok(response) if response.error.is_none() => response.result,
+                    _ => None,
+                };
+                let Some(response) = response else { continue; };
+                if response.sender_pk != sender_hex || response.consignment_hash != pin.digest
+                    || endpoint_identity(&response.sender_transport_endpoint)? != endpoint_identity(sender_endpoint)?
+                    || response.batch != (ids.len() > 1)
+                    || response.consignment.len() > ((pin.size as usize + 258) / 3) * 4
+                { continue; }
+                let raw = match general_purpose::STANDARD.decode(&response.consignment) { Ok(raw) => raw, Err(_) => continue };
+                let plaintext = match self.decrypt_blob_with_shared_key(raw, recipient.encryption, &seed,
+                    &hex::encode(&recipient.public_key), &pin.digest) { Ok(plaintext) => plaintext, Err(_) => continue };
+                if plaintext != local_consignment { continue; }
+                endpoint.used = true;
+                posted = true;
+                break;
+            }
+            // A valid recipient signature remains proof after a retrieved consignment is deleted.
+            // Do not invent which recipient endpoint was used when only the ACK remains.
+            if !posted && signed_ack.is_none() { return Ok(false); }
+            if let Some(signature) = signed_ack { ack_proofs.push((recipient.recipient_id.clone(), signature)); }
+        }
+        self.update_or_save_transfers(&txn, txid.clone(), &info, TransferStatus::WaitingCounterparty,
+                                      &native_hashes, true, &psbt)?;
+        let mut updated: DbBatchTransferActMod = existing.into();
+        updated.status = ActiveValue::Set(TransferStatus::WaitingCounterparty);
+        updated.broadcast_deadline = ActiveValue::Set(Some(deadline));
+        txn.update_batch_transfer(&mut updated)?;
+        for transfer in txn.get_transfers_for_asset(expected_batch, asset)? {
+            if let Some((_, signature)) = ack_proofs.iter().find(|(id, _)| transfer.recipient_id.as_ref() == Some(id)) {
+                let mut updated: DbTransferActMod = transfer.into();
+                updated.ack = ActiveValue::Set(Some(true));
+                updated.ack_signature = ActiveValue::Set(Some(signature.clone()));
+                txn.update_transfer(&mut updated)?;
+            }
+        }
+        self.update_backup_info(&txn, false)?;
+        self.persist_and_commit(txn)?;
+        Ok(true)
+    }
+}
