+fn admit_zip_entries(
+    archive: &mut ZipArchive<fs::File>,
+    limits: BackupZipLimits,
+    envelope: bool,
+) -> Result<(), Error> {
+    if archive.len() == 0 || archive.len() > limits.entries {
+        return Err(invalid_backup());
+    }
+    let mut names = HashSet::new();
+    let mut total = 0u64;
+    let mut identities = HashMap::new();
+    for index in 0..archive.len() {
+        let entry = archive.by_index(index).map_err(|_| invalid_backup())?;
+        let name = entry.name().map_err(|_| invalid_backup())?;
+        let Some(path) = entry.enclosed_name() else {
+            return Err(invalid_backup());
+        };
+        admit_backup_path(name.as_ref(), entry.is_dir(), &mut identities)?;
+        let parts: Vec<_> = name.trim_end_matches('/').split('/').collect();
+        let kind = entry.unix_mode().unwrap_or_default() & 0o170000;
+        if name.len() > MAX_BACKUP_PATH_BYTES
+            || parts.len() > MAX_BACKUP_PATH_DEPTH
+            || parts
+                .iter()
+                .any(|p| p.is_empty() || *p == "." || *p == "..")
+            || name.contains('\\')
+            || name.contains('\0')
+            || !names.insert(path.to_path_buf())
+            || !matches!(kind, 0 | 0o100000 | 0o040000)
+            || entry.size() > limits.file_bytes
+            || (entry.is_dir() && entry.size() != 0)
+        {
+            return Err(invalid_backup());
+        }
+        total = total.checked_add(entry.size()).ok_or_else(invalid_backup)?;
+        if total > limits.total_bytes {
+            return Err(invalid_backup());
+        }
+        if envelope
+            && (entry.is_dir()
+                || !matches!(name.as_ref(), "backup.enc" | "backup.pub_data")
+                || (name == "backup.pub_data" && entry.size() > MAX_BACKUP_METADATA_BYTES))
+        {
+            return Err(invalid_backup());
+        }
+    }
+    if envelope
+        && (names.len() != 2
+            || !names.contains(Path::new("backup.enc"))
+            || !names.contains(Path::new("backup.pub_data")))
+    {
+        return Err(invalid_backup());
+    }
+    Ok(())
 }
 
