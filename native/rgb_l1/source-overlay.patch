+    #[test]
+    fn revalidation_deadline_never_turns_an_unobserved_witness_into_absence() {
+        struct Never;
+        impl ResolveWitness for Never {
+            fn resolve_witness(&self, _: RgbTxid) -> Result<WitnessStatus, WitnessResolverError> {
+                panic!("no network call after deadline")
+            }
+            fn check_chain_net(&self, _: ChainNet) -> Result<(), WitnessResolverError> {
+                panic!("no network call after deadline")
+            }
+        }
+        let resolver = BoundedResolver {
+            inner: Never,
+            deadline: Instant::now() - Duration::from_secs(1),
+        };
+        assert!(matches!(
+            resolver.resolve_witness(RgbTxid::from_str(&"11".repeat(32)).unwrap()),
+            Err(WitnessResolverError::ResolverIssue(None, _))
+        ));
+    }
