+//! Flutter's native outbox. No status, cancellation or restart path invokes End.
+//! Its complete cohort is included in the wallet's encrypted native backup.
+use super::*;
+use bitcoin::{
+    hashes::{Hash, sha256},
+    psbt::Psbt,
+};
+use sea_orm::{ConnectionTrait, DbBackend, Statement};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+#[cfg(unix)]
+use std::os::fd::AsRawFd;
+#[cfg(unix)]
+use std::os::unix::fs::{DirBuilderExt, MetadataExt, OpenOptionsExt, PermissionsExt};
+use std::sync::Arc;
+use std::{
+    fs::{self, File, OpenOptions},
+    io::{Read, Write},
+    path::{Path, PathBuf},
+    str::FromStr,
+};
+use zeroize::Zeroizing;
+
+const SOURCE: &str = "9ec49c08be2e68f08521281e3efbd760ec989cb9";
+const OVERLAY: &str = "flutter-bfa7-durable-v1";
+const DIRECTORY: &str = ".flutter-onchain-v1";
+const MAX_BYTES: u64 = 32 * 1024 * 1024;
+const MAX_RECORDS: usize = 10000;
+const MAX_COMMAND: usize = 200000;
+
+fn fail(code: &str) -> Error {
+    Error::Recovery { code: code.into() }
+}
+fn storage(_: impl std::fmt::Display) -> Error {
+    fail("RECOVERY_STORAGE_INVALID")
+}
+
+// Rust 1.94's File::try_lock is Unsupported on Android. Use the supported
+// platform flock directly on every admitted Unix target, with no blocking or
+// lock bypass. Only genuine contention is retryable BUSY; other errors retain
+// the stronger storage fence instead of masquerading as another writer.
+fn lock_outbox_descriptor(fd: libc::c_int) -> Result<(), Error> {
+    if unsafe { libc::flock(fd, libc::LOCK_EX | libc::LOCK_NB) } == 0 {
+        return Ok(());
+    }
+    let error = std::io::Error::last_os_error();
+    if error.kind() == std::io::ErrorKind::WouldBlock {
+        Err(fail("RECOVERY_BUSY"))
+    } else {
+        Err(storage(error))
+    }
+}
+fn hex(value: &str, n: usize) -> bool {
+    value.len() == n
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn decimal(value: &str, positive: bool) -> Result<u64, Error> {
+    let parsed = value
+        .parse::<u64>()
+        .map_err(|_| fail("RECOVERY_REQUEST_INVALID"))?;
+    if parsed.to_string() != value || (positive && parsed == 0) {
+        return Err(fail("RECOVERY_REQUEST_INVALID"));
+    }
+    Ok(parsed)
+}
+
+// Proxy-v1 witnesses use a deterministic seal blinding derived by the native
+// protocol. The approval intentionally omits it; omission must not be compared
+// with the populated native plan or treated as permission for an arbitrary value.
+fn validate_proxy_witness_blinding(
+    requested: Option<&str>,
+    actual: Option<u64>,
+    operation_seed: Option<&[u8]>,
+    recipient_public_key: &[u8],
+) -> Result<(), Error> {
+    if requested.is_some() {
+        return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+    }
+    let seed: &[u8; 32] = operation_seed
+        .ok_or_else(|| storage("missing operation key"))?
+        .try_into()
+        .map_err(storage)?;
+    let recipient =
+        ed25519_dalek::VerifyingKey::from_bytes(recipient_public_key.try_into().map_err(storage)?)
+            .map_err(storage)?;
+    let sender = ed25519_from_seed(seed);
+    let expected = derive_shared(&sender, &recipient)
+        .map_err(storage)?
+        .seal_blinding;
+    if actual != Some(expected) {
+        return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+    }
+    Ok(())
+}
+
+// Public and Dev Signet share Bitcoin's network encoding, but never its
+// deployment identity. Only the explicit indexer variants select Dev's
+// checkpoint and resolver; an ordinary endpoint cannot stand in for them.
+fn validate_recovery_indexer_profile(network: &str, indexer: &IndexerConfig) -> Result<(), Error> {
+    let dev = matches!(
+        indexer,
+        IndexerConfig::DevSignetElectrum { .. } | IndexerConfig::DevSignetEsplora { .. }
+    );
+    if (network == "utexo") != dev {
+        return Err(fail("RECOVERY_IDENTITY_MISMATCH"));
+    }
+    Ok(())
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "lowercase")]
+enum Kind {
+    Bitcoin,
+    Rgb,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "lowercase")]
+enum Phase {
+    Preparing,
+    Prepared,
+    Committing,
+    Accepted,
+    Rejected,
+}
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Request {
+    version: u32,
+    operation_id: String,
+    kind: Kind,
+    amount: String,
+    fee_rate: String,
+    address: Option<String>,
+    asset_id: Option<String>,
+    recipient_id: Option<String>,
+    transport_endpoints: Vec<String>,
+    sender_transport_endpoint: Option<String>,
+    witness_amount_sat: Option<String>,
+    witness_blinding: Option<String>,
+    min_confirmations: u8,
+    donation: bool,
+    expiration_timestamp: Option<String>,
+    invoice_public_key: Option<String>,
+    invoice_encryption: Option<String>,
+    #[serde(skip_serializing_if = "String::is_empty")]
+    fingerprint: String,
+}
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Envelope {
+    version: u32,
+    backend: String,
+    network: String,
+    wallet_binding: String,
+    recovery_cohort: String,
+    native_source_revision: String,
+    native_overlay: String,
+    request: Request,
+}
+impl Envelope {
+    fn parse(raw: &str) -> Result<Self, Error> {
+        if raw.len() > MAX_COMMAND {
+            return Err(fail("RECOVERY_REQUEST_INVALID"));
+        }
+        let envelope: Self =
+            serde_json::from_str(raw).map_err(|_| fail("RECOVERY_REQUEST_INVALID"))?;
+        envelope.validate()?;
+        Ok(envelope)
+    }
+    fn validate(&self) -> Result<(), Error> {
+        let r = &self.request;
+        if self.version != 3
+            || self.backend != "RGB_L1"
+            || self.native_source_revision != SOURCE
+            || self.native_overlay != OVERLAY
+            || !hex(&self.wallet_binding, 64)
+            || !hex(&self.recovery_cohort, 32)
+            || r.version != 2
+            || !hex(&r.operation_id, 32)
+            || !hex(&r.fingerprint, 64)
+            || r.donation
+            || r.min_confirmations == 0
+        {
+            return Err(fail("RECOVERY_REQUEST_INVALID"));
+        }
+        decimal(&r.amount, true)?;
+        decimal(&r.fee_rate, true)?;
+        let mut unsigned = self.clone();
+        unsigned.request.fingerprint.clear();
+        if sha256::Hash::hash(&serde_json::to_vec(&unsigned).map_err(storage)?).to_string()
+            != r.fingerprint
+        {
+            return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+        }
+        let text = |s: &str, max: usize| {
+            !s.is_empty() && s.len() <= max && s.bytes().all(|b| b >= 0x21 && b <= 0x7e)
+        };
+        match r.kind {
+            Kind::Bitcoin => {
+                if !r.address.as_deref().is_some_and(|s| text(s, 1000))
+                    || r.asset_id.is_some()
+                    || r.recipient_id.is_some()
+                    || !r.transport_endpoints.is_empty()
+                    || r.sender_transport_endpoint.is_some()
+                    || r.witness_amount_sat.is_some()
+                    || r.witness_blinding.is_some()
+                    || r.expiration_timestamp.is_some()
+                    || r.invoice_public_key.is_some()
+                    || r.invoice_encryption.is_some()
+                {
+                    return Err(fail("RECOVERY_REQUEST_INVALID"));
+                }
+            }
+            Kind::Rgb => {
+                if r.address.is_some()
+                    || !r.asset_id.as_deref().is_some_and(|s| text(s, 512))
+                    || !r.recipient_id.as_deref().is_some_and(|s| text(s, 4000))
+                    || r.transport_endpoints.is_empty()
+                    || r.transport_endpoints.len() > 16
+                    || r.transport_endpoints.iter().any(|s| !text(s, 2048))
+                    || !r
+                        .sender_transport_endpoint
+                        .as_deref()
+                        .is_some_and(|s| text(s, 2048))
+                    || !r.invoice_public_key.as_deref().is_some_and(|s| hex(s, 64))
+                    || !matches!(
+                        r.invoice_encryption.as_deref(),
+                        Some("Required" | "Optional" | "Unsupported")
+                    )
+                {
+                    return Err(fail("RECOVERY_REQUEST_INVALID"));
+                }
+                ContractId::from_str(r.asset_id.as_deref().unwrap())
+                    .map_err(|_| fail("RECOVERY_REQUEST_INVALID"))?;
+                decimal(
+                    r.expiration_timestamp
+                        .as_deref()
+                        .ok_or_else(|| fail("RECOVERY_REQUEST_INVALID"))?,
+                    true,
+                )?;
+                if let Some(n) = &r.witness_amount_sat {
+                    decimal(n, true)?;
+                }
+                if let Some(n) = &r.witness_blinding {
+                    decimal(n, false)?;
+                    if r.witness_amount_sat.is_none() {
+                        return Err(fail("RECOVERY_REQUEST_INVALID"));
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+}
+#[derive(Clone, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Record {
+    operation_id: String,
+    fingerprint: String,
+    kind: Kind,
+    phase: Phase,
+    command: Option<Envelope>,
+    txid: Option<String>,
+    batch_transfer_index: Option<i32>,
+    unsigned_psbt: Option<String>,
+    signed_psbt: Option<String>,
+    failure_code: Option<String>,
+    cancel_requested: bool,
+    dispatch_started: bool,
+    amount: String,
+    fee_rate: String,
+    asset_id: Option<String>,
+    address: Option<String>,
+    recipient_id: Option<String>,
+}
+impl Record {
+    fn new(command: Envelope) -> Self {
+        Self {
+            operation_id: command.request.operation_id.clone(),
+            fingerprint: command.request.fingerprint.clone(),
+            kind: command.request.kind,
+            amount: command.request.amount.clone(),
+            fee_rate: command.request.fee_rate.clone(),
+            asset_id: command.request.asset_id.clone(),
+            address: command.request.address.clone(),
+            recipient_id: command.request.recipient_id.clone(),
+            phase: Phase::Preparing,
+            command: Some(command),
+            txid: None,
+            batch_transfer_index: None,
+            unsigned_psbt: None,
+            signed_psbt: None,
+            failure_code: None,
+            cancel_requested: false,
+            dispatch_started: false,
+        }
+    }
+    fn terminal(&self) -> bool {
+        matches!(self.phase, Phase::Accepted | Phase::Rejected)
+    }
+    fn validate(&self, outbox: &Outbox) -> Result<(), Error> {
+        if (self.dispatch_started && !matches!(self.phase, Phase::Committing | Phase::Accepted))
+            || !hex(&self.operation_id, 32)
+            || !hex(&self.fingerprint, 64)
+            || (self.cancel_requested && matches!(self.phase, Phase::Committing | Phase::Accepted))
+        {
+            return Err(storage("record identity"));
+        }
+        decimal(&self.amount, true).map_err(storage)?;
+        decimal(&self.fee_rate, true).map_err(storage)?;
+        if (self.kind == Kind::Bitcoin) != self.asset_id.is_none()
+            || (self.kind == Kind::Bitcoin) != self.address.is_some()
+            || (self.kind == Kind::Rgb) != self.recipient_id.is_some()
+        {
+            return Err(storage("receipt summary"));
+        }
+        if let Some(command) = &self.command {
+            command.validate().map_err(storage)?;
+            if self.amount != command.request.amount
+                || self.fee_rate != command.request.fee_rate
+                || self.asset_id != command.request.asset_id
+                || self.address != command.request.address
+                || self.recipient_id != command.request.recipient_id
+            {
+                return Err(storage("receipt approval mismatch"));
+            }
+            outbox.matches(command)?;
+            if command.request.operation_id != self.operation_id
+                || command.request.fingerprint != self.fingerprint
+                || command.request.kind != self.kind
+            {
+                return Err(storage("command identity"));
+            }
+        } else if !self.terminal() {
+            return Err(storage("missing command"));
+        }
+        if self.phase == Phase::Accepted {
+            if !self.txid.as_deref().is_some_and(|s| hex(s, 64))
+                || (self.kind == Kind::Bitcoin) != self.batch_transfer_index.is_none()
+                || self.batch_transfer_index.is_some_and(|n| n <= 0)
+            {
+                return Err(storage("accepted identity"));
+            }
+        }
+        match &self.unsigned_psbt {
+            Some(raw) => {
+                if raw.len() > 4 * 1024 * 1024 {
+                    return Err(storage("PSBT size"));
+                }
+                let unsigned = Psbt::from_str(raw).map_err(storage)?;
+                if self.txid.as_deref()
+                    != Some(unsigned.unsigned_tx.compute_txid().to_string().as_str())
+                    || (self.kind == Kind::Bitcoin) != self.batch_transfer_index.is_none()
+                    || self.batch_transfer_index.is_some_and(|n| n <= 0)
+                {
+                    return Err(storage("plan identity"));
+                }
+                if let Some(signed) = &self.signed_psbt {
+                    if signed.len() > 4 * 1024 * 1024 {
+                        return Err(storage("PSBT size"));
+                    }
+                    let signed = Psbt::from_str(signed).map_err(storage)?;
+                    if signed.unsigned_tx != unsigned.unsigned_tx
+                        || signed.clone().extract_tx().map_err(storage)?.compute_txid()
+                            != unsigned.unsigned_tx.compute_txid()
+                        || signed.inputs.iter().any(|i| {
+                            i.final_script_witness.is_none() && i.final_script_sig.is_none()
+                        })
+                    {
+                        return Err(storage("signed identity"));
+                    }
+                } else if matches!(self.phase, Phase::Prepared | Phase::Committing) {
+                    return Err(storage("missing signature"));
+                }
+            }
+            None => {
+                if matches!(self.phase, Phase::Prepared | Phase::Committing)
+                    || self.signed_psbt.is_some()
+                    || (self.phase != Phase::Accepted
+                        && (self.txid.is_some() || self.batch_transfer_index.is_some()))
+                {
+                    return Err(storage("missing plan"));
+                }
+            }
+        }
+        if self.terminal()
+            && (self.command.is_some()
+                || self.unsigned_psbt.is_some()
+                || self.signed_psbt.is_some())
+        {
+            return Err(storage("uncompacted terminal receipt"));
+        }
+        Ok(())
+    }
+    fn response(&self) -> Value {
+        json!({"version":1,"operationId":self.operation_id,"fingerprint":self.fingerprint,"kind":self.kind,"phase":self.phase,"txid":self.txid,"batchTransferIndex":self.batch_transfer_index,"failureCode":self.failure_code,"endAuthorized":matches!(self.phase,Phase::Committing|Phase::Accepted)})
+    }
+    fn finish(&mut self, accepted: bool, code: Option<&str>) {
+        self.phase = if accepted {
+            Phase::Accepted
+        } else {
+            Phase::Rejected
+        };
+        self.failure_code = code.map(str::to_owned);
+        self.command = None;
+        self.unsigned_psbt = None;
+        self.signed_psbt = None;
+        if !accepted {
+            self.dispatch_started = false;
+            self.txid = None;
+            self.batch_transfer_index = None;
+        }
+    }
+}
+#[derive(Clone, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Outbox {
+    version: u32,
+    wallet_binding: String,
+    cohort: String,
+    network: String,
+    source_revision: String,
+    overlay: String,
+    records: Vec<Record>,
+    restored_snapshot: bool,
+    revision: u64,
+    previous_digest: String,
+    #[serde(skip_serializing_if = "String::is_empty")]
+    authentication: String,
+}
+impl Outbox {
+    fn matches(&self, command: &Envelope) -> Result<(), Error> {
+        if self.wallet_binding != command.wallet_binding
+            || self.cohort != command.recovery_cohort
+            || self.network != command.network
+            || self.source_revision != command.native_source_revision
+            || self.overlay != command.native_overlay
+        {
+            return Err(fail("RECOVERY_IDENTITY_MISMATCH"));
+        }
+        Ok(())
+    }
+    fn validate(&self, wallet: &Wallet) -> Result<(), Error> {
+        if self.wallet_binding != wallet.recovery_binding(&self.network)? {
+            return Err(fail("RECOVERY_IDENTITY_MISMATCH"));
+        }
+        self.validate_records()?;
+        for record in &self.records {
+            if record.unsigned_psbt.is_some() {
+                wallet.validate_durable_plan(record)?;
+            }
+        }
+        Ok(())
+    }
+    fn validate_records(&self) -> Result<(), Error> {
+        if self.version != 1
+            || !hex(&self.wallet_binding, 64)
+            || !hex(&self.cohort, 32)
+            || self.source_revision != SOURCE
+            || self.overlay != OVERLAY
+            || self.records.len() > MAX_RECORDS
+            || self.revision == 0
+            || (!self.previous_digest.is_empty() && !hex(&self.previous_digest, 64))
+        {
+            return Err(fail("RECOVERY_IDENTITY_MISMATCH"));
+        }
+        let mut seen = std::collections::HashSet::new();
+        for record in &self.records {
+            if !seen.insert(&record.operation_id) {
+                return Err(storage("duplicate operation"));
+            }
+            record.validate(self)?;
+        }
+        if self.records.iter().filter(|r| !r.terminal()).count() > 1 {
+            return Err(storage("competing operations"));
+        }
+        Ok(())
+    }
+    fn index(&self, e: &Envelope) -> Result<Option<usize>, Error> {
+        self.matches(e)?;
+        let index = self
+            .records
+            .iter()
+            .position(|r| r.operation_id == e.request.operation_id);
+        if let Some(i) = index {
+            let r = &self.records[i];
+            if r.fingerprint != e.request.fingerprint
+                || r.kind != e.request.kind
+                || r.command.as_ref().is_some_and(|c| c != e)
+            {
+                return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+            }
+        }
+        Ok(index)
+    }
+}
