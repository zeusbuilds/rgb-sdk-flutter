+                    .ok_or_else(|| fail("RECOVERY_REQUEST_MISMATCH"))?;
+                if !matches!(transfer.main_transition, MainTransition::Transfer)
+                    || transfer.asset_info.contract_id.to_string() != *asset
+                    || transfer.recipients.len() != 1
+                {
+                    return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+                }
+                let recipient = &transfer.recipients[0];
+                let endpoints = recipient
+                    .transport_endpoints
+                    .iter()
+                    .map(|e| e.endpoint.clone())
+                    .collect::<Vec<_>>();
