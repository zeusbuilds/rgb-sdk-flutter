+        txn.commit()?;
+        if accepted {
+            r.finish(true, None);
+        }
+        Ok(accepted)
+    }
+    /// Read-only outcome recovery. Never calls Begin or End, including after a lost reply.
+    pub fn onchain_send_status(
+        &mut self,
+        online: Option<Online>,
+        raw: String,
+    ) -> Result<String, Error> {
+        let e = Envelope::parse(&raw)?;
+        let store = Store::open(self, false)?;
+        let mut outbox = store.read(self)?;
+        let Some(i) = outbox.index(&e)? else {
+            if outbox.restored_snapshot {
+                return Err(fail("RECOVERY_RESTORE_UNCERTAIN"));
+            }
+            return Ok(json!({"version":1,"operationId":e.request.operation_id,"fingerprint":null,"kind":null,"phase":"absent","txid":null,"batchTransferIndex":null,"failureCode":null,"endAuthorized":false}).to_string());
+        };
+        if outbox.records[i].unsigned_psbt.is_some() {
+            self.validate_durable_plan(&outbox.records[i])?;
+        }
+        let was_accepted = outbox.records[i].phase == Phase::Accepted;
+        let mut accepted = self.reconcile_record(&mut outbox.records[i])?;
+        if outbox.restored_snapshot && !accepted && outbox.records[i].signed_psbt.is_some() {
+            if let Some(online) = online {
+                self.require_recovery_online_profile(&outbox.network)?;
+                let record = &outbox.records[i];
+                let asset = record
+                    .command
+                    .as_ref()
+                    .and_then(|e| e.request.asset_id.as_deref());
+                if self.recover_submitted_onchain(
+                    online,
+                    record.signed_psbt.as_deref().unwrap(),
+                    asset,
+                    record.batch_transfer_index,
+                )? {
+                    outbox.records[i].finish(true, None);
+                    accepted = true;
+                }
+            }
+        }
+        if !accepted && !outbox.restored_snapshot && outbox.records[i].revocation_confirmed {
+            // The exact sender-proxy revocation was already durably certified by an
+            // explicit Cancel. Completing its local cleanup makes no external call.
+            self.complete_revoked_rgb_cancel(&store, &mut outbox, i)?;
+            return Ok(outbox.records[i].response().to_string());
+        }
+        if !accepted && outbox.records[i].phase == Phase::Committing {
+            if !outbox.restored_snapshot && !outbox.records[i].dispatch_started {
+                // End's callback is durable before its first mutating RPC. With the native
+                // session serialized, an absent callback proves no submission was dispatched.
+                outbox.records[i].phase = Phase::Prepared;
+                outbox.records[i].failure_code = Some("submission_not_started".into());
+                store.write(&outbox)?;
+            } else if let Some(online) = online {
+                self.require_recovery_online_profile(&outbox.network)?;
+                let record = &outbox.records[i];
+                let asset = record
+                    .command
+                    .as_ref()
+                    .and_then(|e| e.request.asset_id.as_deref());
+                if self.recover_submitted_onchain(
+                    online,
+                    record
+                        .signed_psbt
+                        .as_deref()
+                        .ok_or_else(|| storage("signed plan"))?,
+                    asset,
+                    record.batch_transfer_index,
+                )? {
+                    outbox.records[i].finish(true, None);
+                    accepted = true;
+                }
+            }
+        }
+        if accepted && !was_accepted {
+            store.write(&outbox)?;
+        }
+        if outbox.restored_snapshot && !outbox.records[i].terminal() {
+            return Err(fail("RECOVERY_RESTORE_UNCERTAIN"));
+        }
+        Ok(outbox.records[i].response().to_string())
+    }
+    /// Prepare exactly one durable transaction, before any commit authorization exists.
+    pub fn prepare_onchain_send(&mut self, online: Online, raw: String) -> Result<String, Error> {
+        self.check_xprv()?;
+        let e = Envelope::parse(&raw)?;
+        let store = Store::open(self, false)?;
+        let mut outbox = store.read(self)?;
+        if outbox.restored_snapshot {
+            return Err(fail("RECOVERY_RESTORE_UNCERTAIN"));
+        }
+        if let Some(i) = outbox.index(&e)? {
+            if outbox.records[i].phase != Phase::Preparing || outbox.records[i].cancel_requested {
+                return Ok(outbox.records[i].response().to_string());
+            }
+        }
+        self.require_recovery_online_profile(&outbox.network)?;
+        let i = match outbox.index(&e)? {
+            Some(i) => {
+                if outbox.records[i].phase != Phase::Preparing || outbox.records[i].cancel_requested
+                {
+                    return Ok(outbox.records[i].response().to_string());
+                }
+                i
+            }
+            None => {
+                if outbox.records.len() >= MAX_RECORDS {
+                    return Err(fail("RECOVERY_CAPACITY"));
+                }
+                if outbox.records.iter().any(|r| !r.terminal()) {
+                    return Err(fail("RECOVERY_PENDING"));
+                }
+                outbox.records.push(Record::new(e.clone()));
+                let i = outbox.records.len() - 1;
+                store.write(&outbox)?;
+                i
+            }
+        };
+        let request = e.request.clone();
+        if outbox.records[i].unsigned_psbt.is_none() {
+            let amount = decimal(&request.amount, true)?;
+            let fee = decimal(&request.fee_rate, true)?;
+            let prepared = match request.kind {
+                Kind::Bitcoin => self
+                    .send_btc_begin_with_durable_callback(
+                        online,
+                        request.address.clone().unwrap(),
+                        amount,
+                        fee,
+                        false,
+                        false,
+                        |psbt, txn| persist_plan(&store, &mut outbox, i, psbt, None, txn),
+                    )
+                    .map(|_| ()),
+                Kind::Rgb => {
+                    let expiration =
+                        decimal(request.expiration_timestamp.as_deref().unwrap(), true)?;
+                    let now =
+                        std::cmp::max(time::OffsetDateTime::now_utc().unix_timestamp(), 0) as u64;
+                    if expiration > i64::MAX as u64 || expiration <= now.saturating_add(900) {
+                        outbox.records[i].finish(false, Some("invoice_expired"));
+                        store.write(&outbox)?;
+                        return Ok(outbox.records[i].response().to_string());
+                    }
+                    let recipient = Recipient {
+                        recipient_id: request.recipient_id.clone().unwrap(),
+                        witness_data: request
+                            .witness_amount_sat
+                            .as_ref()
+                            .map(|n| {
+                                Ok::<_, Error>(WitnessData {
+                                    amount_sat: decimal(n, true)?,
+                                    blinding: request
+                                        .witness_blinding
+                                        .as_ref()
+                                        .map(|n| decimal(n, false))
+                                        .transpose()?,
+                                })
+                            })
+                            .transpose()?,
+                        assignment: Assignment::Fungible(amount),
+                        transport_endpoints: request.transport_endpoints.clone(),
+                        public_key: request.invoice_public_key.clone(),
+                        encryption: match request.invoice_encryption.as_deref().unwrap() {
+                            "Required" => Encryption::Required,
+                            "Optional" => Encryption::Optional,
+                            _ => Encryption::Unsupported,
+                        },
+                        expiration_timestamp: Some(expiration),
+                    };
+                    let map = HashMap::from([(request.asset_id.clone().unwrap(), vec![recipient])]);
+                    self.send_begin_with_durable_callback(
+                        online,
+                        map,
+                        false,
+                        fee,
+                        request.min_confirmations,
+                        expiration - 600,
+                        request.sender_transport_endpoint.clone(),
+                        false,
+                        |result, txn| {
+                            sync_tree(
+                                Path::new(&result.details.fascia_path)
+                                    .parent()
+                                    .ok_or_else(|| storage("transfer path"))?,
+                                0,
+                            )?;
+                            persist_plan(
+                                &store,
+                                &mut outbox,
+                                i,
+                                &result.psbt,
+                                result.batch_transfer_idx,
+                                txn,
+                            )
+                        },
+                    )
+                    .map(|_| ())
+                }
+            };
+            if let Err(error) = prepared {
+                let r = &mut outbox.records[i];
+                if r.unsigned_psbt.is_none() {
+                    r.finish(false, Some(prepare_error(&error)));
+                } else {
+                    r.failure_code = Some("native_prepare_interrupted".into());
+                }
+                store.write(&outbox)?;
+                return Ok(outbox.records[i].response().to_string());
+            }
+        }
+        let unsigned = outbox.records[i]
+            .unsigned_psbt
+            .clone()
+            .ok_or_else(|| storage("plan"))?;
+        self.validate_durable_plan(&outbox.records[i])?;
+        match self.sign_psbt(unsigned.clone(), None) {
+            Ok(signed) => {
+                let a = Psbt::from_str(&unsigned).map_err(storage)?;
+                let b = Psbt::from_str(&signed).map_err(storage)?;
+                if a.unsigned_tx != b.unsigned_tx {
+                    return Err(storage("signer changed plan"));
+                }
+                outbox.records[i].signed_psbt = Some(signed);
+                outbox.records[i].phase = Phase::Prepared;
+                outbox.records[i].failure_code = None;
+            }
+            Err(_) => {
+                outbox.records[i].failure_code = Some("native_sign_failed".into());
+            }
+        }
+        store.write(&outbox)?;
+        Ok(outbox.records[i].response().to_string())
+    }
+    /// Authorize End once and persist its exact identity before any external submission.
+    pub fn commit_onchain_send(&mut self, online: Online, raw: String) -> Result<String, Error> {
+        self.check_xprv()?;
+        let e = Envelope::parse(&raw)?;
+        let store = Store::open(self, false)?;
+        let mut outbox = store.read(self)?;
+        if outbox.restored_snapshot {
+            return Err(fail("RECOVERY_RESTORE_UNCERTAIN"));
+        }
+        let i = outbox
+            .index(&e)?
+            .ok_or_else(|| fail("RECOVERY_REQUEST_MISMATCH"))?;
+        if outbox.records[i].phase != Phase::Prepared {
+            if self.reconcile_record(&mut outbox.records[i])? {
+                store.write(&outbox)?;
+            }
+            return Ok(outbox.records[i].response().to_string());
+        }
+        self.require_recovery_online_profile(&outbox.network)?;
+        self.validate_durable_plan(&outbox.records[i])?;
+        if let Some(expiration) = outbox.records[i]
+            .command
+            .as_ref()
+            .and_then(|c| c.request.expiration_timestamp.as_ref())
+        {
+            let now = std::cmp::max(time::OffsetDateTime::now_utc().unix_timestamp(), 0) as u64;
+            if decimal(expiration, true)? <= now.saturating_add(900) {
+                outbox.records[i].failure_code = Some("invoice_expired".into());
+                store.write(&outbox)?;
+                return Ok(outbox.records[i].response().to_string());
+            }
+        }
+        outbox.records[i].phase = Phase::Committing;
+        store.write(&outbox)?;
+        let signed = outbox.records[i]
+            .signed_psbt
+            .clone()
+            .ok_or_else(|| storage("signed plan"))?;
+        self.check_online(online)?;
+        let psbt = Psbt::from_str(&signed).map_err(storage)?;
+        let result = (|| {
+            let txn = self.database().begin_transaction()?;
+            let kind = outbox.records[i].kind;
+            let mut before_submit = |txn: &DbTxn| {
+                outbox.records[i].dispatch_started = true;
+                store.write_in(&outbox, Some(txn))
+            };
+            let result = match kind {
+                Kind::Bitcoin => self
+                    .send_btc_end_impl_with_durable_callback(&txn, &psbt, &mut before_submit)
+                    .map(|id| (id, None)),
+                Kind::Rgb => self
+                    .send_end_impl_with_durable_callback(&txn, &psbt, &mut before_submit)
+                    .map(|r| (r.txid, Some(r.batch_transfer_idx))),
+            }?;
+            self.update_backup_info(&txn, false)?;
+            self.persist_and_commit(txn)?;
+            Ok::<_, Error>(result)
+        })();
+        match result {
+            Ok((id, batch)) => {
+                if Some(id) != outbox.records[i].txid
+                    || (outbox.records[i].kind == Kind::Rgb
+                        && batch != outbox.records[i].batch_transfer_index)
+                {
+                    return Err(storage("accepted plan mismatch"));
+                }
+                outbox.records[i].finish(true, None);
+                store.write(&outbox)?;
+            }
+            Err(_) => {
+                outbox = store.read(self)?;
+                if self.reconcile_record(&mut outbox.records[i])? {
+                    store.write(&outbox)?;
+                } else if !outbox.records[i].dispatch_started {
+                    outbox.records[i].phase = Phase::Prepared;
+                    outbox.records[i].failure_code = Some("submission_not_started".into());
+                    store.write(&outbox)?;
+                } else {
+                    outbox.records[i].failure_code = Some("native_commit_interrupted".into());
+                    store.write(&outbox)?;
+                }
+            }
+        }
+        Ok(outbox.records[i].response().to_string())
+    }
+    fn revoke_durable_rgb(&self, record: &Record) -> Result<DurableRevocation, Error> {
+        self.validate_durable_plan(record)?;
+        let psbt = Psbt::from_str(record.unsigned_psbt.as_deref().ok_or_else(|| storage("plan"))?)
+            .map_err(storage)?;
+        let (_, _, info, _) = self.get_transfer_end_data(&psbt)?;
+        let txid = record.txid.as_deref().ok_or_else(|| storage("txid"))?;
+        let txn = self.database().begin_transaction()?;
+        let batches = txn.get_batch_transfers_by_txid(txid)?;
+        if batches.len() != 1 || batches[0].incoming
+            || Some(batches[0].idx) != record.batch_transfer_index
+            || !matches!(batches[0].status, TransferStatus::Initiated | TransferStatus::Failed)
+            || batches[0].operation_secret_key != info.operation_secret_key
+        { return Err(fail("RECOVERY_PENDING")); }
+        let seed: [u8;32] = info.operation_secret_key.clone()
+            .and_then(|seed| seed.try_into().ok()).ok_or_else(|| storage("operation key"))?;
+        let signing_key = ed25519_from_seed(&seed);
+        let sender = hex::encode(signing_key.verifying_key().to_bytes());
+        let asset = record.asset_id.as_ref().ok_or_else(|| storage("asset"))?;
+        let recipients = &info.transfers.get(asset).ok_or_else(|| storage("asset"))?.recipients;
+        // The current command contract approves exactly one recipient. Never revoke
+        // an incomplete subset if a future native format adds recipient batching.
+        if info.transfers.len() != 1 || recipients.len() != 1 {
+            return Err(fail("RECOVERY_REQUEST_MISMATCH"));
+        }
+        let rows = txn.get_transfers_for_asset(batches[0].idx, asset)?;
+        if rows.len() != recipients.len() || recipients.iter().any(|recipient|
+            !rows.iter().any(|row| row.recipient_id.as_deref() == Some(&recipient.recipient_id)
+                && row.recipient_pubkey.as_ref() == Some(&recipient.public_key)
+                && row.requested_assignment.as_ref() == Some(&recipient.assignment)))
+        { return Err(fail("RECOVERY_REQUEST_MISMATCH")); }
+        let mut ids: Vec<_> = recipients.iter().map(|recipient| recipient.proxy_ids(&sender).1).collect();
+        ids.sort();
+        ids.dedup();
+        if ids.len() != recipients.len() { return Err(fail("RECOVERY_REQUEST_MISMATCH")); }
+        let endpoint = info.sender_transport_endpoint.as_deref().ok_or_else(|| storage("sender endpoint"))?;
+        let url = self.convert_transport_endpoint_url(endpoint)?;
+        txn.commit()?;
+        let signature = hex::encode(sign_ed25519(&signing_key, &sha256_digest(ids.concat().as_bytes())));
+        let result = ProxyClient::new(&url, self.bitcoin_network())
+            .and_then(|proxy| proxy.clean_ack(&ids, &signature));
+        Ok(match result {
+            Ok(response) => durable_revocation_response(response),
+            Err(_) => DurableRevocation::Unknown,
+        })
+    }
+    fn complete_revoked_rgb_cancel(
+        &mut self, store: &Store, outbox: &mut Outbox, i: usize,
+    ) -> Result<(), Error> {
+        let record = &outbox.records[i];
+        if !record.revocation_confirmed || !record.cancel_requested
+            || record.kind != Kind::Rgb || record.phase != Phase::Committing
+        { return Err(storage("revocation certificate")); }
+        let txid = record.txid.as_deref().ok_or_else(|| storage("txid"))?;
+        let txn = self.database().begin_transaction()?;
+        let rows = txn.get_batch_transfers_by_txid(txid)?;
+        if rows.len() != 1 || rows[0].incoming || Some(rows[0].idx) != record.batch_transfer_index
+            || !matches!(rows[0].status, TransferStatus::Initiated | TransferStatus::Failed)
+        { return Err(fail("RECOVERY_PENDING")); }
+        for row in rows {
+            if row.status == TransferStatus::Initiated {
+                txn.del_reserved_txos_for_batch_transfer(row.idx)?;
+                let mut updated: DbBatchTransferActMod = row.into();
+                updated.status = ActiveValue::Set(TransferStatus::Failed);
+                txn.update_batch_transfer(&mut updated)?;
+            }
+        }
+        self.update_backup_info(&txn, false)?;
+        txn.commit()?;
+        // A crash before this final write leaves the revocation certificate pending;
+        // Status can repeat only this idempotent local cleanup, never ack.clean or End.
+        outbox.records[i].finish(false, Some("cancelled"));
+        store.write(outbox)
+    }
+    /// Cancel only an exact operation that has not started external submission.
+    /// If Commit overtook a caller's observation, this is a protected no-op.
+    /// Explicit dispatched RGB revocation has a separate signer-gated entry point.
+    pub fn cancel_onchain_send(
+        &mut self,
+        online: Option<Online>,
+        raw: String,
+    ) -> Result<String, Error> {
+        self.cancel_onchain_send_impl(online, raw, false)
+    }
+    /// Explicit proxy revocation has its own entry point. A queued legacy Cancel
+    /// cannot acquire this authority if Commit dispatched after its observation.
+    pub fn revoke_onchain_send(&mut self, online: Online, raw: String) -> Result<String, Error> {
+        let e = Envelope::parse(&raw)?;
+        if e.request.kind != Kind::Rgb { return Err(fail("RECOVERY_REQUEST_INVALID")); }
+        self.check_xprv()?;
+        self.cancel_onchain_send_impl(Some(online), raw, true)
+    }
+    fn cancel_onchain_send_impl(
+        &mut self, online: Option<Online>, raw: String, allow_dispatched_revocation: bool,
+    ) -> Result<String, Error> {
+        let e = Envelope::parse(&raw)?;
+        let store = Store::open(self, false)?;
+        let mut outbox = store.read(self)?;
+        if outbox.restored_snapshot {
+            return Err(fail("RECOVERY_RESTORE_UNCERTAIN"));
+        }
+        let i = match outbox.index(&e)? {
+            Some(i) => i,
+            None => {
+                if outbox.records.len() >= MAX_RECORDS {
+                    return Err(fail("RECOVERY_CAPACITY"));
+                }
+                let mut r = Record::new(e);
+                r.cancel_requested = true;
+                r.finish(false, Some("cancelled"));
+                outbox.records.push(r);
+                store.write(&outbox)?;
+                return Ok(outbox.records.last().unwrap().response().to_string());
+            }
+        };
+        if outbox.records[i].terminal() {
+            return Ok(outbox.records[i].response().to_string());
+        }
+        if outbox.records[i].unsigned_psbt.is_some() {
+            self.validate_durable_plan(&outbox.records[i])?;
+        }
+        if self.reconcile_record(&mut outbox.records[i])? {
+            store.write(&outbox)?;
+            return Ok(outbox.records[i].response().to_string());
+        }
+        if outbox.records[i].phase == Phase::Committing && !outbox.records[i].dispatch_started {
+            outbox.records[i].phase = Phase::Prepared;
+        }
+        if outbox.records[i].phase == Phase::Committing {
+            if outbox.records[i].kind != Kind::Rgb {
+                // An absent Bitcoin observation cannot revoke a broadcastable TX.
+                return Ok(outbox.records[i].response().to_string());
+            }
+            if outbox.records[i].revocation_confirmed {
+                self.complete_revoked_rgb_cancel(&store, &mut outbox, i)?;
+                return Ok(outbox.records[i].response().to_string());
+            }
+            if !allow_dispatched_revocation {
+                // Preserve the original Cancel contract even when an in-flight
+                // Commit overtakes a caller's pre-dispatch status observation.
+                return Ok(outbox.records[i].response().to_string());
+            }
+            let Some(online) = online else {
+                return Ok(outbox.records[i].response().to_string());
+            };
+            self.require_recovery_online_profile(&outbox.network)?;
+            let record = &outbox.records[i];
+            // Prefer proof of the already submitted payment over cancellation.
+            if self.recover_submitted_onchain(
+                online,
+                record.signed_psbt.as_deref().ok_or_else(|| storage("signed plan"))?,
+                record.asset_id.as_deref(), record.batch_transfer_index,
+            )? {
+                outbox.records[i].finish(true, None);
+                store.write(&outbox)?;
+                return Ok(outbox.records[i].response().to_string());
+            }
+            outbox.records[i].cancel_requested = true;
+            store.write(&outbox)?;
+            match self.revoke_durable_rgb(&outbox.records[i])? {
+                DurableRevocation::Revoked => {
+                    outbox.records[i].revocation_confirmed = true;
+                    outbox.records[i].failure_code = None;
+                    // This certificate is durable before any reservation is released.
+                    store.write(&outbox)?;
+                    self.complete_revoked_rgb_cancel(&store, &mut outbox, i)?;
+                }
+                DurableRevocation::Released => {
+                    outbox.records[i].failure_code = Some("cancellation_not_safe".into());
+                    store.write(&outbox)?;
+                }
+                DurableRevocation::Unknown => {
+                    outbox.records[i].failure_code = Some("cancellation_unavailable".into());
+                    store.write(&outbox)?;
+                }
+            }
+            return Ok(outbox.records[i].response().to_string());
+        }
+        outbox.records[i].cancel_requested = true;
+        outbox.records[i].phase = Phase::Preparing;
+        outbox.records[i].signed_psbt = None;
+        store.write(&outbox)?;
+        let r = &outbox.records[i];
+        if let Some(txid) = &r.txid {
+            match r.kind {
+                Kind::Bitcoin => {
+                    if self
+                        .list_pending_vanilla_txs()?
+                        .iter()
+                        .any(|r| &r.txid == txid)
+                    {
+                        self.abort_pending_vanilla_tx(txid.clone())?;
+                    }
+                }
+                Kind::Rgb => {
+                    // No End was authorized, so this exact Initiated reservation can be failed
+                    // locally. Never revoke a different batch or a progressed transfer.
+                    let txn = self.database().begin_transaction()?;
+                    let rows = txn.get_batch_transfers_by_txid(txid)?;
+                    if rows.iter().any(|b| {
+                        Some(b.idx) != r.batch_transfer_index
+                            || b.incoming
+                            || !matches!(
+                                b.status,
+                                TransferStatus::Initiated | TransferStatus::Failed
+                            )
+                    }) {
+                        return Err(fail("RECOVERY_PENDING"));
+                    }
+                    for batch in rows {
+                        if batch.status == TransferStatus::Initiated {
+                            txn.del_reserved_txos_for_batch_transfer(batch.idx)?;
+                            let mut active: DbBatchTransferActMod = batch.into();
+                            active.status = ActiveValue::Set(TransferStatus::Failed);
+                            txn.update_batch_transfer(&mut active)?;
+                        }
+                    }
+                    self.update_backup_info(&txn, false)?;
+                    txn.commit()?;
+                }
+            }
+        }
+        outbox.records[i].finish(false, Some("cancelled"));
+        store.write(&outbox)?;
+        Ok(outbox.records[i].response().to_string())
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum DurableRevocation { Revoked, Released, Unknown }
+fn durable_revocation_response(response: JsonRpcResponse<bool>) -> DurableRevocation {
+    match response.error {
+        None if response.result == Some(true) => DurableRevocation::Revoked,
+        Some(error) => match map_proxy_error(error) {
+            Error::ProxyTxAlreadyReleased => DurableRevocation::Released,
+            _ => DurableRevocation::Unknown,
+        },
+        _ => DurableRevocation::Unknown,
+    }
+}
+fn persist_plan(
+    store: &Store,
+    outbox: &mut Outbox,
+    i: usize,
+    raw: &str,
+    batch: Option<i32>,
+    txn: &DbTxn,
+) -> Result<(), Error> {
+    let psbt = Psbt::from_str(raw).map_err(storage)?;
+    let r = &mut outbox.records[i];
+    if (r.kind == Kind::Bitcoin) != batch.is_none() || batch.is_some_and(|n| n <= 0) {
+        return Err(storage("batch"));
+    }
+    if let Some(old) = &r.unsigned_psbt {
+        if old != raw {
+            return Err(storage("replacement plan"));
+        }
+    }
+    r.txid = Some(psbt.unsigned_tx.compute_txid().to_string());
+    r.batch_transfer_index = batch;
+    r.unsigned_psbt = Some(raw.into());
+    store.write_in(outbox, Some(txn))
+}
+fn sync_tree(dir: &Path, depth: u8) -> Result<(), Error> {
+    if depth > 16 {
+        return Err(storage("tree depth"));
+    }
+    for entry in fs::read_dir(dir).map_err(storage)? {
+        let entry = entry.map_err(storage)?;
+        let kind = entry.file_type().map_err(storage)?;
+        if kind.is_dir() {
+            sync_tree(&entry.path(), depth + 1)?;
+        } else if kind.is_file() {
+            File::open(entry.path())
+                .and_then(|f| f.sync_all())
+                .map_err(storage)?;
+        } else {
+            return Err(storage("transfer file"));
+        }
+    }
+    File::open(dir).and_then(|f| f.sync_all()).map_err(storage)
+}
+fn prepare_error(error: &Error) -> &'static str {
+    match error {
+        Error::InsufficientBitcoins { .. } => "insufficient_bitcoins",
+        Error::InsufficientAssignments { .. } => "insufficient_asset_balance",
+        Error::InsufficientAllocationSlots => "insufficient_allocations",
+        Error::InvalidFeeRate { .. }
+        | Error::MaxFeeExceeded { .. }
+        | Error::MinFeeNotMet { .. } => "invalid_fee",
+        Error::InvalidAddress { .. }
+        | Error::InvalidRecipientData { .. }
+        | Error::InvalidRecipientID
+        | Error::InvalidRecipientNetwork
+        | Error::InvalidInvoice { .. } => "invalid_recipient",
+        _ => "preparation_failed",
+    }
+}
