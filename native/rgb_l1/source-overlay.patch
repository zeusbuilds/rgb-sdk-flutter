+    #[test]
+    fn unrelated_unknown_observation_does_not_mask_positive_reorg_or_demote_unknown_branch() {
+        let mut data = historical_chain(4, TransferStatus::Settled);
+        data.batch_transfers
+            .push(batch(5, TransferStatus::Settled, true));
+        data.asset_transfers.push(asset(5, 5));
+        data.colorings
+            .push(coloring(20, 10, 5, ColoringType::Receive, 20));
+        data.txos.push(txo(10, false));
+        // Branch 2 has a positively observed zero-confirmation witness. The
+        // unrelated row 5 is unavailable: preserve its last-known Settled row.
+        let blocked = projection_fence(&data, &HashSet::from([1, 3, 4]), &HashSet::from([2]), true);
+        assert_eq!(blocked, HashSet::from([2, 3, 4]));
+        for batch in &mut data.batch_transfers {
+            if blocked.contains(&batch.idx) {
+                batch.status = TransferStatus::WaitingConfirmations;
+            }
+        }
+        assert!(data.batch_transfers[4].status.settled());
+        assert_eq!(
+            balance_of(&data),
+            Balance {
+                settled: 1020,
+                future: 1017,
+                spendable: 20
+            }
+        );
+        assert!(projection_fence(&data, &HashSet::new(), &HashSet::new(), true).is_empty());
+    }
