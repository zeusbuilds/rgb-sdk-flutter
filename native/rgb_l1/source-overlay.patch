+/// Persist immutable first-submission bytes before any mutating proxy call.
+pub(super) fn immutable_consignments<W: WalletOnline + ?Sized>(
+    wallet: &W,
+    txn: &DbTxn,
+    fascia: &Fascia,
+    transfers: &BTreeMap<String, InfoAssetTransfer>,
+    dir: &PathBuf,
+    txid: &str,
+) -> Result<(), Error> {
+    #[derive(Deserialize, Serialize)]
+    #[serde(deny_unknown_fields)]
+    struct Entry {
+        digest: String,
+        size: u64,
+    }
+    #[derive(Deserialize, Serialize)]
+    #[serde(deny_unknown_fields)]
+    struct Manifest {
+        version: u32,
+        txid: String,
+        assets: BTreeMap<String, Entry>,
+    }
+    let snapshots = dir.join(".durable-send-v1");
+    match fs::DirBuilder::new().mode(0o700).create(&snapshots) {
+        Ok(()) => File::open(dir)
+            .and_then(|f| f.sync_all())
+            .map_err(storage)?,
+        Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {}
+        Err(e) => return Err(storage(e)),
+    }
+    let meta = fs::symlink_metadata(&snapshots).map_err(storage)?;
+    if !meta.is_dir()
+        || meta.permissions().mode() & 0o777 != 0o700
+        || meta.uid() != unsafe { libc::geteuid() }
+        || snapshots.canonicalize().map_err(storage)? != snapshots
+    {
+        return Err(storage("snapshot directory"));
+    }
+    let manifest_path = snapshots.join("manifest.json");
+    let manifest: Manifest = match fs::symlink_metadata(&manifest_path) {
+        Ok(_) => {
+            let file = OpenOptions::new()
+                .read(true)
+                .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+                .open(&manifest_path)
+                .map_err(storage)?;
+            Store::file(&file, 1024 * 1024)?;
+            let mut raw = Vec::new();
+            file.take(1024 * 1024 + 1)
+                .read_to_end(&mut raw)
+                .map_err(storage)?;
+            serde_json::from_slice(&raw).map_err(storage)?
+        }
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
+            // A crash before the complete manifest cannot have reached a proxy. Its partial
+            // unsigned snapshots can be rebuilt; after the manifest is durable, never regenerate.
+            wallet.gen_consignments(txn, fascia, transfers, dir)?;
+            let mut assets = BTreeMap::new();
+            for (id, info) in transfers {
+                if id != &info.asset_info.contract_id.to_string() {
+                    return Err(storage("contract identity"));
+                }
+                let source = wallet
+                    .get_asset_transfer_dir(dir, id)
+                    .join(CONSIGNMENT_FILE);
+                let file = OpenOptions::new()
+                    .read(true)
+                    .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+                    .open(&source)
+                    .map_err(storage)?;
+                let m = file.metadata().map_err(storage)?;
+                if !m.is_file() || m.len() > 64 * 1024 * 1024 {
+                    return Err(storage("consignment size"));
+                }
+                let mut raw = Vec::new();
+                file.take(64 * 1024 * 1024 + 1)
+                    .read_to_end(&mut raw)
+                    .map_err(storage)?;
+                if raw.len() > 64 * 1024 * 1024 {
+                    return Err(storage("consignment size"));
+                }
+                let digest = sha256::Hash::hash(&raw).to_string();
+                let mut stage = tempfile::NamedTempFile::new_in(&snapshots).map_err(storage)?;
+                stage.write_all(&raw).map_err(storage)?;
+                stage.as_file().sync_all().map_err(storage)?;
+                stage
+                    .persist(snapshots.join(format!(
+                        "{}.rgb",
+                        id.strip_prefix("rgb:").ok_or_else(|| storage("contract"))?
+                    )))
+                    .map_err(|e| storage(e.error))?;
+                assets.insert(
+                    id.clone(),
+                    Entry {
+                        digest,
+                        size: raw.len() as u64,
+                    },
+                );
+            }
+            let manifest = Manifest {
+                version: 1,
+                txid: txid.into(),
+                assets,
+            };
+            let mut stage = tempfile::NamedTempFile::new_in(&snapshots).map_err(storage)?;
+            stage
+                .write_all(&serde_json::to_vec(&manifest).map_err(storage)?)
+                .map_err(storage)?;
+            stage.as_file().sync_all().map_err(storage)?;
+            stage
+                .persist(&manifest_path)
+                .map_err(|e| storage(e.error))?;
+            File::open(&snapshots)
+                .and_then(|f| f.sync_all())
+                .map_err(storage)?;
+            manifest
+        }
+        Err(e) => return Err(storage(e)),
+    };
+    if manifest.version != 1
+        || manifest.txid != txid
+        || manifest.assets.keys().collect::<Vec<_>>() != transfers.keys().collect::<Vec<_>>()
+    {
+        return Err(storage("snapshot manifest identity"));
+    }
+    for (id, entry) in manifest.assets {
+        if entry.size > 64 * 1024 * 1024 || !hex(&entry.digest, 64) {
+            return Err(storage("snapshot metadata"));
+        }
+        let snapshot = snapshots.join(format!(
+            "{}.rgb",
+            id.strip_prefix("rgb:").ok_or_else(|| storage("contract"))?
+        ));
+        let file = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(&snapshot)
+            .map_err(storage)?;
+        Store::file(&file, 64 * 1024 * 1024)?;
+        let mut raw = Vec::new();
+        file.take(64 * 1024 * 1024 + 1)
+            .read_to_end(&mut raw)
+            .map_err(storage)?;
+        if raw.len() as u64 != entry.size || sha256::Hash::hash(&raw).to_string() != entry.digest {
+            return Err(storage("snapshot digest"));
+        }
+        let destination = wallet.get_asset_transfer_dir(dir, &id);
+        let mut stage = tempfile::NamedTempFile::new_in(&destination).map_err(storage)?;
+        stage.write_all(&raw).map_err(storage)?;
+        stage.as_file().sync_all().map_err(storage)?;
+        stage
+            .persist(destination.join(CONSIGNMENT_FILE))
+            .map_err(|e| storage(e.error))?;
+        File::open(&destination)
+            .and_then(|f| f.sync_all())
+            .map_err(storage)?;
+    }
+    sync_tree(dir, 0)
+}
