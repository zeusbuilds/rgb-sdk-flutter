+    #[test]
+    fn branching_reorg_fences_descendants_without_blocking_confirmed_independent_branch() {
+        let mut data = historical_chain(4, TransferStatus::WaitingConfirmations);
+        // A second child spends the first producer's distinct allocation.
+        data.batch_transfers
+            .push(batch(5, TransferStatus::WaitingConfirmations, true));
+        data.batch_transfers
+            .push(batch(6, TransferStatus::WaitingConfirmations, false));
+        data.asset_transfers.push(asset(5, 5));
+        data.asset_transfers.push(asset(6, 6));
+        data.colorings
+            .push(coloring(20, 10, 5, ColoringType::Receive, 20));
+        data.colorings
+            .push(coloring(21, 10, 6, ColoringType::Input, 20));
+        data.colorings
+            .push(coloring(22, 11, 6, ColoringType::Change, 19));
+        data.txos.push(txo(10, true));
+        data.txos.push(txo(11, false));
+        let verified: HashSet<_> = (1..=6).collect();
+        assert_eq!(
+            reconfirmation_fence(&data, &verified, &HashSet::from([2])),
+            HashSet::from([2, 3, 4])
+        );
+        assert_eq!(
+            balance_of(&data),
+            Balance {
+                settled: 0,
+                future: 1016,
+                spendable: 0
+            }
+        );
+        // Positive confirmation on the independent branch is sufficient in
+        // the same pass; it does not depend on history insertion order.
+        for batch in &mut data.batch_transfers {
+            if [1, 5, 6].contains(&batch.idx) {
+                batch.status = TransferStatus::Settled;
+            }
+        }
+        assert_eq!(
+            balance_of(&data),
+            Balance {
+                settled: 1019,
+                future: 1016,
+                spendable: 19
+            }
+        );
+    }
