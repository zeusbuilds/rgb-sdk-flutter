+// Public and Dev Signet share Bitcoin's network encoding, but never its
+// deployment identity. Only the explicit indexer variants select Dev's
+// checkpoint and resolver; an ordinary endpoint cannot stand in for them.
+fn validate_recovery_indexer_profile(network: &str, indexer: &IndexerConfig) -> Result<(), Error> {
+    let dev = matches!(
+        indexer,
+        IndexerConfig::DevSignetElectrum { .. } | IndexerConfig::DevSignetEsplora { .. }
+    );
+    if (network == "utexo") != dev {
+        return Err(fail("RECOVERY_IDENTITY_MISMATCH"));
+    }
+    Ok(())
+}
